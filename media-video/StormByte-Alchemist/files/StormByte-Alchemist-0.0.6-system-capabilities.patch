diff --git a/CMakeLists.txt b/CMakeLists.txt
index 63c89c7..2b84850 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -34,6 +34,17 @@ set(_alchemy_required_libraries "${CMAKE_REQUIRED_LIBRARIES}")
 set(_alchemy_required_includes "${CMAKE_REQUIRED_INCLUDES}")
 get_target_property(_alchemy_multimedia_includes StormByte-Multimedia INTERFACE_INCLUDE_DIRECTORIES)
 set(CMAKE_REQUIRED_INCLUDES "${_alchemy_multimedia_includes}")
+if(WITH_STORMBYTE STREQUAL "SYSTEM")
+	# try_compile cannot export the imported targets' transitive aliases.
+	set(CMAKE_REQUIRED_LIBRARIES)
+	foreach(_alchemy_component IN ITEMS Multimedia Base)
+		get_target_property(_alchemy_probe_library StormByte::${_alchemy_component} IMPORTED_LOCATION)
+		if(NOT _alchemy_probe_library)
+			message(FATAL_ERROR "The SYSTEM StormByte ${_alchemy_component} target does not export its library location.")
+		endif()
+		list(APPEND CMAKE_REQUIRED_LIBRARIES "${_alchemy_probe_library}")
+	endforeach()
+else()
 set(_alchemy_multimedia_prefix "")
 foreach(_alchemy_multimedia_include IN LISTS _alchemy_multimedia_includes)
 	if(IS_ABSOLUTE "${_alchemy_multimedia_include}" AND NOT _alchemy_multimedia_include MATCHES "\\$<")
@@ -75,6 +86,7 @@ if(NOT _alchemy_stormbyte_library)
 endif()
 set(CMAKE_REQUIRED_LIBRARIES "${_alchemy_multimedia_library}")
 list(APPEND CMAKE_REQUIRED_LIBRARIES "${_alchemy_stormbyte_library}")
+endif()
 # Link against the selected package: stale SYSTEM/reused-install headers cannot enable absent filters.
 unset(STORMBYTE_ALCHEMY_MULTIMEDIA_HAS_RUBBERBAND CACHE)
 unset(STORMBYTE_ALCHEMY_MULTIMEDIA_HAS_VAGUEDENOISER CACHE)
@@ -97,6 +109,8 @@ set(CMAKE_REQUIRED_INCLUDES "${_alchemy_required_includes}")
 unset(_alchemy_required_libraries)
 unset(_alchemy_required_includes)
 unset(_alchemy_multimedia_includes)
+unset(_alchemy_component)
+unset(_alchemy_probe_library)
 unset(_alchemy_multimedia_include)
 unset(_alchemy_multimedia_prefix)
 unset(_alchemy_candidate)
