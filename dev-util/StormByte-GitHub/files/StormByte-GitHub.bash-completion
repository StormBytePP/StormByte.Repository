# StormByte-GitHub.bash-completion
# Bash completion for StormByte-GitHub
#
# Install as:
#   /usr/share/bash-completion/completions/StormByte-GitHub
#   or
#   /etc/bash_completion.d/StormByte-GitHub
#
# Keep in sync with StormByte-GitHub CLI

_StormByte_GitHub() {
	local cur prev cword cmd sub
	local -a words
	local -a top_cmds cache_subs ci_subs submodules_subs git_subs repos_subs fork_subs dump_extra

	COMPREPLY=()

	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD - 1]}"
	cword=$COMP_CWORD
	words=("${COMP_WORDS[@]}")

	top_cmds=(
		help
		cache
		ci
		submodules
		git
		repos
		clone-all
		search
		fork
	)

	cache_subs=(show list delete)
	ci_subs=(stop start restart status)
	submodules_subs=(init deinit update)
	git_subs=(reset pull sync)
	repos_subs=(list dump)
	fork_subs=(status sync)
	dump_extra=('type=c++' 'type=cmake' 50 100 200 500)

	# -------------------------------------------------------------------------
	# Config: ROOT / FORK_ROOT from env or ~/.StormByte-GitHub.conf
	# -------------------------------------------------------------------------
	_sb_github_load_roots() {
		SB_GH_ROOT="${ROOT:-}"
		SB_GH_FORK_ROOT="${FORK_ROOT:-}"

		local conf="${HOME}/.StormByte-GitHub.conf"
		if [[ -f "$conf" ]]; then
			local line key val
			while IFS= read -r line || [[ -n "$line" ]]; do
				[[ "$line" =~ ^[[:space:]]*# ]] && continue
				[[ "$line" =~ ^[[:space:]]*$ ]] && continue
				if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
					key="${BASH_REMATCH[1]}"
					val="${BASH_REMATCH[2]}"
					val="${val#\"}"
					val="${val%\"}"
					val="${val#\'}"
					val="${val%\'}"
					case "$key" in
						ROOT)
							[[ -z "$SB_GH_ROOT" ]] && SB_GH_ROOT="$val"
							;;
						FORK_ROOT)
							[[ -z "$SB_GH_FORK_ROOT" ]] && SB_GH_FORK_ROOT="$val"
							;;
					esac
				fi
			done < "$conf"
		fi

		# Expand leading ~
		[[ "$SB_GH_ROOT" == ~* ]] && SB_GH_ROOT="${SB_GH_ROOT/#\~/$HOME}"
		[[ "$SB_GH_FORK_ROOT" == ~* ]] && SB_GH_FORK_ROOT="${SB_GH_FORK_ROOT/#\~/$HOME}"

		[[ -z "$SB_GH_ROOT" ]] && SB_GH_ROOT="$PWD"
		[[ -z "$SB_GH_FORK_ROOT" ]] && SB_GH_FORK_ROOT="$SB_GH_ROOT"
	}

	# List git repo directory names under a root (basenames only)
	_sb_github_repo_dirs_in() {
		local root="$1"
		local d
		local -a out=()
		[[ -d "$root" ]] || return 0
		shopt -s nullglob
		for d in "$root"/*/; do
			d="${d%/}"
			if [[ -d "$d/.git" || -f "$d/.git" ]]; then
				out+=("$(basename "$d")")
			fi
		done
		shopt -u nullglob
		((${#out[@]})) && printf '%s\n' "${out[@]}"
	}

	# All immediate subdir basenames under root (for dump, etc.)
	_sb_github_subdirs_in() {
		local root="$1"
		local d
		local -a out=()
		[[ -d "$root" ]] || return 0
		shopt -s nullglob
		for d in "$root"/*/; do
			out+=("$(basename "${d%/}")")
		done
		shopt -u nullglob
		((${#out[@]})) && printf '%s\n' "${out[@]}"
	}

	# Complete dir-spec: path-style OR basenames under $2 (root)
	_sb_complete_repo_spec() {
		local cur="$1"
		local root="$2"

		if [[ "$cur" == ~* || "$cur" == /* || "$cur" == ./* || "$cur" == ../* ]]; then
			compopt -o filenames 2>/dev/null
			mapfile -t COMPREPLY < <(compgen -d -- "$cur")
			# Ensure trailing slash for directories when unique
			local i
			for i in "${!COMPREPLY[@]}"; do
				[[ -d "${COMPREPLY[i]}" && "${COMPREPLY[i]}" != */ ]] && COMPREPLY[i]+="/"
			done
			return 0
		fi

		local -a repos candidates=()
		mapfile -t repos < <(_sb_github_repo_dirs_in "$root")

		if [[ "$cur" == '!'* ]]; then
			local r
			for r in "${repos[@]}"; do
				candidates+=("!$r")
			done
			if [[ "$cur" == *'+'* ]]; then
				for r in "${repos[@]}"; do
					candidates+=("${cur}!$r")
				done
			fi
		else
			candidates=("${repos[@]}")
			for r in "${repos[@]}"; do
				candidates+=("!$r")
			done
		fi

		mapfile -t COMPREPLY < <(compgen -W "${candidates[*]}" -- "$cur")
	}

	_sb_github_load_roots

	# ----- position 1: top-level command -----
	if ((cword == 1)); then
		mapfile -t COMPREPLY < <(compgen -W "${top_cmds[*]}" -- "$cur")
		return 0
	fi

	cmd="${words[1]-}"

	case "$cmd" in
	help | -h | --help)
		return 0
		;;

	cache)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${cache_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		show | list | delete)
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			;;
		esac
		return 0
		;;

	ci)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${ci_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		stop | start | restart | status)
			if [[ "$cur" == -* ]]; then
				mapfile -t COMPREPLY < <(compgen -W "--failed" -- "$cur")
			else
				_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			fi
			;;
		esac
		return 0
		;;

	submodules)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${submodules_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		init | deinit | update)
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			;;
		esac
		return 0
		;;

	git)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${git_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		reset | pull | sync)
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
			;;
		esac
		return 0
		;;

	repos)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${repos_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		list)
			return 0
			;;
		dump)
			# repos dump <dir-under-ROOT|path> [chunk] [type=...]
			if ((cword == 3)); then
				if [[ "$cur" == ~* || "$cur" == /* || "$cur" == ./* || "$cur" == ../* ]]; then
					compopt -o filenames 2>/dev/null
					mapfile -t COMPREPLY < <(compgen -d -- "$cur")
					local i
					for i in "${!COMPREPLY[@]}"; do
						[[ -d "${COMPREPLY[i]}" && "${COMPREPLY[i]}" != */ ]] && COMPREPLY[i]+="/"
					done
				else
					# basenames under ROOT (crypto, network, …)
					mapfile -t COMPREPLY < <(
						compgen -W "$(_sb_github_subdirs_in "$SB_GH_ROOT")" -- "$cur"
					)
				fi
				return 0
			fi
			if [[ "$cur" == type=* || "$cur" == type ]]; then
				mapfile -t COMPREPLY < <(compgen -W 'type=c++ type=cmake' -- "$cur")
				return 0
			fi
			mapfile -t COMPREPLY < <(compgen -W "${dump_extra[*]}" -- "$cur")
			return 0
			;;
		esac
		return 0
		;;

	clone-all)
		return 0
		;;

	search)
		if ((cword == 2)); then
			return 0
		fi
		if ((cword >= 3)); then
			_sb_complete_repo_spec "$cur" "$SB_GH_ROOT"
		fi
		return 0
		;;

	fork)
		if ((cword == 2)); then
			mapfile -t COMPREPLY < <(compgen -W "${fork_subs[*]}" -- "$cur")
			return 0
		fi
		sub="${words[2]-}"
		case "$sub" in
		status | sync)
			# Forks live under FORK_ROOT (fallback ROOT)
			_sb_complete_repo_spec "$cur" "$SB_GH_FORK_ROOT"
			;;
		esac
		return 0
		;;
	esac

	COMPREPLY=()
	return 0
}

complete -F _StormByte_GitHub StormByte-GitHub