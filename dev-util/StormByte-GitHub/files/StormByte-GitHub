cmd_reset_one() {
	local dir="$1"
	local repo="$2"

	info "Path" "$dir"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git reset --hard && git clean -fd"
		LAST_COUNT=1
		LAST_BYTES=0
		return 0
	fi
	if git -C "$dir" reset --hard && git -C "$dir" clean -fd; then
		ok "Reset complete"
		LAST_COUNT=1
	else
		warn "Reset failed"
		LAST_COUNT=0
	fi
	LAST_BYTES=0
}

cmd_pull_one() {
	local dir="$1"
	local repo="$2"

	info "Path" "$dir"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git fetch origin && git pull --rebase"
		LAST_COUNT=1
		LAST_BYTES=0
		return 0
	fi
	if git -C "$dir" fetch origin && git -C "$dir" pull --rebase; then
		ok "Pull complete ($(git -C "$dir" rev-parse --short HEAD))"
		LAST_COUNT=1
	else
		warn "Pull failed"
		LAST_COUNT=0
	fi
	LAST_BYTES=0
}

cmd_reset() {
	local target="${1:-}"
	require_tools 0
	foreach_repo cmd_reset_one "$target"
	print_summary "repos reset" "$__walk_total"
}

cmd_pull() {
	local target="${1:-}"
	require_tools 0
	foreach_repo cmd_pull_one "$target"
	print_summary "repos pulled" "$__walk_total"
}

# -----------------------------------------------------------------------------
# dump
# -----------------------------------------------------------------------------

print_size() {
	local file="$1"
	local bytes kib
	if [[ ! -e "$file" ]]; then
		printf '  %-60s  (missing)\n' "$file"
		return
	fi
	bytes="$(wc -c < "$file" | tr -d ' ')"
	kib=$(( (bytes + 1023) / 1024 ))
	printf '  %-60s  %6d KiB\n' "$file" "$kib"
}

dump_files_cpp() {
	local root="$1"
	local dest="$2"
	local base="$3"
	shift 3
	local f rel
	: > "$dest"
	find "$root" -type f \( -name '*.hxx' -o -name '*.h' -o -name '*.cxx' \) \
		! -path '*/.git/*' ! -path '*/build/*' ! -path '*/thirdparty/*' ! -path '*/dist/*' \
		"$@" \
		| sort \
		| while IFS= read -r f; do
			rel="${f#"$base"/}"
			printf '%s\n' \
				"//==============================================================================" \
				"// FILE: $rel" \
				"//==============================================================================" \
				""
			cat "$f"
			printf '\n\n'
		done >> "$dest"
}

dump_files_cmake() {
	local root="$1"
	local dest="$2"
	local base="$3"
	local f rel
	: > "$dest"
	find "$root" -type f \( \
			-name 'CMakeLists.txt' -o -name '*.cmake' -o -name '*.cmake.in' -o \
			-name '*.sh.in' -o -name '*.bat.in' -o -name '*.cmd.in' \
		\) \
		! -path '*/.git/*' ! -path '*/build/*' ! -path '*/thirdparty/*' \
		! -path '*/dist/*' ! -path '*/pkgconf/*' ! -path '*/tools/extra/pkgconf/*' \
		| sort \
		| while IFS= read -r f; do
			rel="${f#"$base"/}"
			printf '%s\n' \
				"//==============================================================================" \
				"// FILE: $rel" \
				"//==============================================================================" \
				""
			cat "$f"
			printf '\n\n'
		done >> "$dest"
}

split_file() {
	local file="$1"
	local prefix="$2"
	local size_kb="$3"
	local f
	local -a chunks=()

	if [[ ! -s "$file" ]]; then
		log "  (empty file, not split)"
		return
	fi

	split -b "${size_kb}k" --numeric-suffixes=1 --suffix-length=2 "$file" "$prefix"

	shopt -s nullglob
	for f in ${prefix}*; do
		[[ -e "$f" ]] || continue
		[[ "$f" == *.txt ]] && continue
		mv "$f" "${f}.txt"
	done
	chunks=(${prefix}*.txt)
	shopt -u nullglob

	if [[ ${#chunks[@]} -eq 0 ]]; then
		log "  (no chunks)"
		return
	fi

	log "  Generated chunks:"
	for f in "${chunks[@]}"; do
		print_size "$f"
	done
}

cmd_dump() {
	local dir="" chunk_size_kb="" type="c++"
	local arg project out out_test

	for arg in "$@"; do
		if [[ "$arg" == type=* ]]; then
			type="${arg#type=}"
		elif [[ "$arg" =~ ^[0-9]+$ ]]; then
			chunk_size_kb="$arg"
		elif [[ -z "$dir" ]]; then
			dir="$arg"
		else
			err "Unexpected argument: $arg"
			log "Use: ${SCRIPT_NAME} dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
			log ""
			display_help
			exit 1
		fi
	done

	if [[ -z "$dir" ]]; then
		err "dump requires a directory"
		log "Use: ${SCRIPT_NAME} dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
		log ""
		display_help
		exit 1
	fi

	case "$type" in
		c++|cmake) ;;
		*)
			err "Invalid type='$type' (use type=c++ or type=cmake)"
			log "Use: ${SCRIPT_NAME} dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
			log ""
			display_help
			exit 1
			;;
	esac

	if [[ -n "$chunk_size_kb" ]]; then
		if ! [[ "$chunk_size_kb" =~ ^[0-9]+$ ]] || [[ "$chunk_size_kb" -le 0 ]]; then
			err "chunk_size_kb must be a positive integer"
			exit 1
		fi
	fi

	if [[ ! -d "$dir" ]]; then
		err "Not a directory: $dir"
		exit 1
	fi

	dir="$(cd "$dir" && pwd)"
	project="$(basename "$dir")"
	out="/tmp/project_${project}.txt"
	out_test="/tmp/project_${project}_test.txt"

	rm -f "$out" "$out_test"
	rm -f /tmp/project_${project}_part_*.txt
	rm -f /tmp/project_${project}_test_part_*.txt

	info "Project" "$project"
	info "Type" "$type"
	info "Source dir" "$dir"

	if [[ "$type" == "cmake" ]]; then
		dump_files_cmake "$dir" "$out" "$dir"
		: > "$out_test"
		log "sources: $out"
		print_size "$out"
		log "tests:   (skipped for type=cmake)"
	else
		dump_files_cpp "$dir" "$out" "$dir" ! -path "$dir/test/*" ! -path "*/test/*"
		if [[ -d "$dir/test" ]]; then
			dump_files_cpp "$dir/test" "$out_test" "$dir"
		else
			: > "$out_test"
			warn "No test directory at $dir/test"
		fi
		log "sources: $out"
		print_size "$out"
		log "tests:   $out_test"
		print_size "$out_test"
	fi

	if [[ -n "$chunk_size_kb" ]]; then
		log ""
		log "=== Splitting sources into ~${chunk_size_kb} KB chunks ==="
		split_file "$out" "/tmp/project_${project}_part_" "$chunk_size_kb"
		if [[ "$type" == "c++" ]]; then
			log ""
			log "=== Splitting tests into ~${chunk_size_kb} KB chunks ==="
			split_file "$out_test" "/tmp/project_${project}_test_part_" "$chunk_size_kb"
		fi
	fi
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
	if [[ $# -lt 1 ]]; then
		display_help
		exit 0
	fi

	local cmd="$1"
	shift

	case "$cmd" in
		help|-h|--help)
			display_help
			;;
		cache)
			display_header
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN (no changes)"
			cmd_cache "$@"
			;;
		runners)
			display_header
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN (no changes)"
			cmd_runners "$@"
			;;
		submodules)
			display_header
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN (no changes)"
			cmd_submodules "$@"
			;;
		reset)
			display_header
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN (no changes)"
			cmd_reset "$@"
			;;
		pull)
			display_header
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN (no changes)"
			cmd_pull "$@"
			;;
		dump)
			display_header
			cmd_dump "$@"
			;;
		*)
			err "Unknown command: $cmd"
			log ""
			display_help
			exit 1
			;;
	esac
}

main "$@"