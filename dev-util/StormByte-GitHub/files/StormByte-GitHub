# -----------------------------------------------------------------------------
# cache
# -----------------------------------------------------------------------------

_cache_list_rows() {
	local repo="$1"
	gh cache list -R "$repo" --limit "$PAGE_LIMIT" \
		--json id,key,sizeInBytes \
		--jq '.[] | "\(.id)\t\(.sizeInBytes // 0)\t\(.key)"' \
		2>/dev/null || true
}

cmd_cache_show_one() {
	local dir="$1" repo="$2"
	local count=0 bytes=0 id size key entry rest hsz
	local -a entries=()

	info "Remote" "$repo"
	mapfile -t entries < <(_cache_list_rows "$repo")

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No caches"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	printf "  ${_CLR_DIM}%-10s  %-12s  %s${_CLR_RESET}\n" "SIZE" "ID" "KEY"
	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		size="${rest%%$'\t'*}"
		key="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue
		[[ "$size" =~ ^[0-9]+$ ]] || size=0
		hsz="$(human_size "$size")"
		printf "  %-10s  %-12s  %s\n" "$hsz" "$id" "$key"
		count=$((count + 1))
		bytes=$((bytes + size))
	done

	info "Repo total" "$count cache(s), $(human_size "$bytes")"
	ok "Listed $count cache(s)"
	LAST_COUNT=$count
	LAST_BYTES=$bytes
}

cmd_cache_list_one() {
	local dir="$1" repo="$2"
	local count=0 bytes=0 id size key entry rest
	local -a entries=()

	info "Remote" "$repo"
	mapfile -t entries < <(_cache_list_rows "$repo")

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No caches"
		LAST_COUNT=0
		LAST_BYTES=0
