}

cmd_cache_delete_one() {
	local dir="$1" repo="$2"
	local deleted=0 page=0 batch id key entry
	local -a entries=()

	info "Remote" "$repo"

	while true; do
		page=$((page + 1))
		if [[ "$MAX_PAGES" -gt 0 && "$page" -gt "$MAX_PAGES" ]]; then
			warn "Reached MAX_PAGES=$MAX_PAGES — stopping this repo"
			break
		fi

		mapfile -t entries < <(
			gh cache list -R "$repo" --limit "$PAGE_LIMIT" \
				--json id,key \
				--jq '.[] | "\(.id)\t\(.key)"' \
				2>/dev/null || true
		)
		batch=${#entries[@]}
		if [[ "$batch" -eq 0 ]]; then
			if [[ "$page" -eq 1 ]]; then
				ok "No caches"
			else
				ok "No more caches"
			fi
			break
		fi

		info "Page" "$page ($batch cache(s))"

		for entry in "${entries[@]}"; do
			id="${entry%%$'\t'*}"
			key="${entry#*$'\t'}"
			[[ -z "$id" ]] && continue
			if [[ "$DRY_RUN" == "1" ]]; then
				log "  [dry-run] would delete id=$id key=$key"
				deleted=$((deleted + 1))
				continue
			fi
			log "  delete id=$id key=$key"
			if gh cache delete "$id" -R "$repo" 2>/dev/null; then
				deleted=$((deleted + 1))
			else
				warn "delete failed for id=$id"
			fi
		done

		[[ "$DRY_RUN" == "1" ]] && break
	done

	ok "Deleted $deleted cache(s)"
	LAST_COUNT=$deleted
	LAST_BYTES=0
}

cmd_cache() {
	local sub="${1:-}"
	local target="${2:-}"

	case "$sub" in
		show)
			foreach_repo cmd_cache_show_one "$target"
			print_summary_sized "caches listed" "$__walk_total" "$__walk_bytes"
			;;
		list)
			foreach_repo cmd_cache_list_one "$target"
			print_summary_sized "caches" "$__walk_total" "$__walk_bytes"
			;;
		delete)
			foreach_repo cmd_cache_delete_one "$target"
			print_summary "caches deleted" "$__walk_total"
			;;
		*)
			usage_error "Missing or unknown cache subcommand" "cache show|list|delete [dir-spec]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# CI
# -----------------------------------------------------------------------------

_list_runs_for_start() {
	local repo="$1" branch="$2" sha="$3"
	local out=""

	out="$(
		gh run list -R "$repo" --commit "$sha" --limit "$PAGE_LIMIT" \
			--json databaseId,status,conclusion,headSha,displayTitle,workflowName \
			--jq '.[] | "\(.databaseId)\t\(.status)\t\(.conclusion // "-")\t\(.headSha // "")\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
			2>/dev/null || true
	)"
	if [[ -n "$out" ]]; then
		printf '%s\n' "$out"
		return 0
	fi

	gh run list -R "$repo" --branch "$branch" --limit "$PAGE_LIMIT" \
		--json databaseId,status,conclusion,headSha,displayTitle,workflowName \
		--jq '.[] | "\(.databaseId)\t\(.status)\t\(.conclusion // "-")\t\(.headSha // "")\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
		2>/dev/null || true
}

cmd_ci_stop_one() {
	local dir="$1" repo="$2"
	local branch cancelled=0
	local id status workflow title entry rest st
	local -a entries=()
	local -A seen_id=()

	LAST_COUNT=0
	info "Remote" "$repo"

	branch="$(git_current_branch "$dir")"
	[[ -z "$branch" ]] && { err "Cannot resolve current branch"; return 1; }
	info "Branch" "$branch"

	for st in in_progress queued pending waiting requested; do
		while IFS= read -r entry; do
			[[ -z "$entry" ]] && continue
			id="${entry%%$'\t'*}"
			[[ -z "$id" || -n "${seen_id[$id]+x}" ]] && continue
			seen_id["$id"]=1
			entries+=("$entry")
		done < <(
			gh run list -R "$repo" --branch "$branch" --status "$st" --limit "$PAGE_LIMIT" \
				--json databaseId,status,displayTitle,workflowName \
				--jq '.[] | "\(.databaseId)\t\(.status)\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
				2>/dev/null || true
		)
	done

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No active runs on $branch"
		return 0
	fi

	info "Found" "${#entries[@]} unique active run(s)"

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"

		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would cancel: $workflow id=$id"
			cancelled=$((cancelled + 1))
			continue
		fi
		log "  cancel: $workflow id=$id"
		if gh run cancel "$id" -R "$repo" 2>/dev/null; then
			cancelled=$((cancelled + 1))
		else
			warn "cancel failed for id=$id"
		fi
	done

	LAST_COUNT=$cancelled
	ok "Cancelled $cancelled unique workflow run(s)"
}

cmd_ci_start_one() {
	local dir="$1" repo="$2"
	local branch sha rerun=0 skipped=0
	local id status conclusion head_sha workflow title entry rest
	local -a entries=()
	local -A seen_workflow=()

	LAST_COUNT=0
	info "Remote" "$repo"

	branch="$(git_current_branch "$dir")"
	sha="$(git_head_sha_full "$dir")"
	[[ -z "$branch" || -z "$sha" ]] && { err "Cannot resolve branch/HEAD"; return 1; }

	info "Branch" "$branch"
	info "HEAD" "$sha"
	[[ "$ONLY_FAILED" == "1" ]] && info "Filter" "--failed"

	mapfile -t entries < <(_list_runs_for_start "$repo" "$branch" "$sha")

	if [[ ${#entries[@]} -eq 0 ]]; then
		warn "No workflow runs found"
		ok "No workflows re-run"
		return 0
	fi

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		conclusion="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		head_sha="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue

		[[ -n "$workflow" && -n "${seen_workflow[$workflow]+x}" ]] && continue
		[[ -n "$workflow" ]] && seen_workflow["$workflow"]=1

		[[ "$RUN_LIMIT" -gt 0 && "$rerun" -ge "$RUN_LIMIT" ]] && break

		case "$status" in
			in_progress|queued|pending|waiting|requested)
				log "  skip (already active): $workflow"
				skipped=$((skipped + 1))
				continue
				;;
		esac

		if [[ "$ONLY_FAILED" == "1" ]]; then
			case "$conclusion" in
				failure|cancelled|timed_out|startup_failure) ;;
				*) skipped=$((skipped + 1)); continue ;;
			esac
		fi

		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] Re-run: $workflow id=$id"
			rerun=$((rerun + 1))
			continue
		fi

		log "  Re-run: $workflow id=$id"
		if gh run rerun "$id" -R "$repo" 2>/dev/null; then
			rerun=$((rerun + 1))
		else
			warn "rerun failed for id=$id"
		fi
	done

	LAST_COUNT=$rerun
	ok "Re-run $rerun workflow(s) (skipped=$skipped)"
}

cmd_ci_restart_one() {
	cmd_ci_stop_one "$1" "$2"
	[[ "$DRY_RUN" != "1" ]] && sleep 2
	cmd_ci_start_one "$1" "$2"
}

cmd_ci_status_one() {
	local dir="$1" repo="$2"
	local branch
	local -a entries=()
	local id status conclusion workflow title entry rest

	LAST_COUNT=0
	info "Remote" "$repo"

	branch="$(git_current_branch "$dir")"
	[[ -z "$branch" ]] && { err "Cannot resolve current branch"; return 1; }
	info "Branch" "$branch"

	mapfile -t entries < <(
		gh run list -R "$repo" --branch "$branch" --limit 15 \
			--json databaseId,status,conclusion,displayTitle,workflowName \
			--jq '.[] | "\(.databaseId)\t\(.status)\t\(.conclusion // "-")\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
			2>/dev/null || true
	)

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No recent runs"
		return 0
	fi

	printf "  ${_CLR_DIM}%-12s  %-12s  %-20s  %s${_CLR_RESET}\n" "STATUS" "CONCLUSION" "WORKFLOW" "TITLE"
	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		conclusion="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"
		printf "  %-12s  %-12s  %-20s  %s\n" "$status" "$conclusion" "$workflow" "$title"
		LAST_COUNT=$((LAST_COUNT + 1))
	done
	ok "Listed recent runs"
}

cmd_ci() {
	local sub="${1:-}"
	shift || true
	local target="" arg

	for arg in "$@"; do
		case "$arg" in
			--failed) ONLY_FAILED=1 ;;
			*) [[ -z "$target" ]] && target="$arg" ;;
		esac
	done

	case "$sub" in
		stop)
			foreach_repo cmd_ci_stop_one "$target"
			print_summary "runs cancelled" "$__walk_total"
			;;
		start)
			foreach_repo cmd_ci_start_one "$target"
			print_summary "workflows re-run" "$__walk_total"
			;;
		restart)
			foreach_repo cmd_ci_restart_one "$target"
			print_summary "workflows re-run" "$__walk_total"
			;;
		status)
			foreach_repo cmd_ci_status_one "$target"
			print_summary "repos checked" "$__walk_repos"
			;;
		*)
			usage_error "Missing or unknown ci subcommand" "ci stop|start|restart|status [dir-spec] [--failed]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# Submodule dependency helpers
# -----------------------------------------------------------------------------

canonical_repo_id() {
	local url="$1"
	local id
	id="$(printf '%s' "$url" | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')"
	[[ -z "$id" || "$id" != */* ]] && return 1
	printf '%s\n' "${id,,}"
}

urls_from_gitmodules_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	git config --file "$file" --list 2>/dev/null \
		| sed -n 's/^submodule\..*\.url=//p' \
		|| true
}

collect_dep_ids_from() {
	local dir="$1"
	local file url id

	[[ -d "$dir" ]] || return 0

	while IFS= read -r -d '' file; do
		while IFS= read -r url; do
			[[ -z "$url" ]] && continue
			id="$(canonical_repo_id "$url" 2>/dev/null)" || continue
			printf '%s\n' "$id"
		done < <(urls_from_gitmodules_file "$file")
	done < <(find "$dir" -type f -name .gitmodules ! -path '*/.git/*' -print0 2>/dev/null)
}

build_update_order() {
	local dir name repo_disp id
	local -a nodes=()
	local -A deps=()
	local -A id_to_folder=()

	shopt -s nullglob
	for dir in "$ROOT"/*/; do
		dir="${dir%/}"
		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			continue
		fi
		if ! repo_disp="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
			continue
		fi
		if ! id="$(canonical_repo_id "https://github.com/${repo_disp}.git")"; then
			continue
		fi
		name="$(basename "$dir")"
		if [[ -n "${id_to_folder[$id]+x}" ]]; then
			warn "Duplicate clone of $id — keeping first"
			continue
		fi
		id_to_folder["$id"]="$name"
		nodes+=("$id")
		deps["$id"]=""
	done

	[[ ${#nodes[@]} -eq 0 ]] && return 0

	for id in "${nodes[@]}"; do
		dir="$ROOT/${id_to_folder[$id]}"
		while IFS= read -r dep_id; do
			[[ -z "$dep_id" || "$dep_id" == "$id" ]] && continue
			if [[ -n "${id_to_folder[$dep_id]+x}" ]]; then
				case " ${deps[$id]:-} " in
					*" $dep_id "*) ;;
					*) deps["$id"]="${deps[$id]:+${deps[$id]} }$dep_id" ;;
				esac
			fi
		done < <(collect_dep_ids_from "$dir" | sort -u)
	done

	local -a ordered_ids
	mapfile -t ordered_ids < <(topological_sort nodes deps)

	for id in "${ordered_ids[@]}"; do
		printf '%s\n' "${id_to_folder[$id]}"
	done
}

# -----------------------------------------------------------------------------
# submodules
# -----------------------------------------------------------------------------

run_q() {
	local out rc
	set +e
	out="$("$@" 2>&1)"
	rc=$?
	set -e
	if [[ "$rc" -ne 0 ]]; then
		err "Command failed: $*"
		err "Exit code: $rc"
		printf '%s\n' "$out" | tail -n 40 >&2
		return "$rc"
	fi
	return 0
}

cmd_submodules_init_one() {
	local dir="$1" repo="$2"

	info "Path" "$dir"
	if [[ ! -f "$dir/.gitmodules" ]]; then
		ok "No .gitmodules — nothing to init"
		LAST_COUNT=0
		return 0
	fi

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule update --init --recursive"
		LAST_COUNT=1
		return 0
	fi

	if git -C "$dir" submodule update --init --recursive; then
		ok "Submodules initialized"
		LAST_COUNT=1
	else
		warn "init failed"
		LAST_COUNT=0
	fi
}

cmd_submodules_deinit_one() {
	local dir="$1" repo="$2"

	info "Path" "$dir"
	if [[ ! -f "$dir/.gitmodules" ]]; then
		ok "No .gitmodules — nothing to deinit"
		LAST_COUNT=0
		return 0
	fi

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule deinit --all -f"
		LAST_COUNT=1
		return 0
	fi

	if git -C "$dir" submodule deinit --all -f; then
		ok "Submodules deinitialized"
		LAST_COUNT=1
	else
		warn "deinit failed"
		LAST_COUNT=0
	fi
}

commit_submodules_if_needed() {
	local dir="$1"
	local name
	name="$(basename "$dir")"

	if [[ -z "$(git -C "$dir" status --porcelain)" ]]; then
		ok "No changes"
		return 1
	fi

	log "  Changes detected:"
	git -C "$dir" status --short | sed 's/^/    /'

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would commit and push"
		return 0
	fi

	run_q git -C "$dir" add -A
	if git -C "$dir" diff --cached --quiet; then
		warn "Dirty worktree but nothing staged; skipping commit"
		git -C "$dir" restore --staged . >/dev/null 2>&1 || true
		return 1
	fi
	if ! git -C "$dir" commit -m "Updated submodules" >/dev/null; then
		err "git commit failed in $name"
		return 1
	fi
	if ! git -C "$dir" push >/dev/null; then
		err "git push failed in $name"
		return 1
	fi
	ok "Commit + push ($(git_head_sha "$dir"))"
	return 0
}

cmd_submodules_update_one() {
	local dir="$1" repo="$2"

	info "Path" "$dir"
	LAST_COUNT=0

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would clean, fetch, submodule update --remote, commit if needed"
		if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
			LAST_COUNT=1
		fi
		return 0
	fi

	if [[ -f "$dir/.gitmodules" ]]; then
		run_q git -C "$dir" submodule foreach --recursive git clean -fd
		run_q git -C "$dir" submodule foreach --recursive git reset --hard
	fi
	run_q git -C "$dir" clean -fd
	run_q git -C "$dir" reset --hard

	if [[ -f "$dir/.gitmodules" ]]; then
		run_q git -C "$dir" fetch --recurse-submodules origin
		run_q git -C "$dir" submodule update --init --remote
		run_q git -C "$dir" submodule foreach --recursive \
			git submodule update --init --recursive
	fi

	if commit_submodules_if_needed "$dir"; then
		LAST_COUNT=1
	else
		LAST_COUNT=0
	fi
}

cmd_submodules() {
	local sub="${1:-}"
	local target="${2:-}"
	local name dir repo
	local -a ordered=()

	if [[ -z "$sub" ]]; then
		usage_error "Missing submodules subcommand" "submodules init|deinit|update [dir-spec]"
	fi

	case "$sub" in
		init)
			foreach_repo cmd_submodules_init_one "$target"
			print_summary "repos initialized" "$__walk_total"
			;;
		deinit)
			foreach_repo cmd_submodules_deinit_one "$target"
			print_summary "repos deinitialized" "$__walk_total"
			;;
		update)
			if [[ -n "$target" ]]; then
				foreach_repo cmd_submodules_update_one "$target"
				print_summary "repos updated" "$__walk_total"
			else
				mapfile -t ordered < <(build_update_order)
				if [[ ${#ordered[@]} -eq 0 ]]; then
					warn "No eligible repositories under $ROOT"
					__walk_repos=0
					__walk_total=0
					print_summary "repos updated" 0
					return 0
				fi
				info "Update order" "$(IFS=','; echo "${ordered[*]}")"
				__walk_repos=0
				__walk_total=0
				for name in "${ordered[@]}"; do
					dir="$ROOT/$name"
					section "$name"
					if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
						warn "Skip (not a usable ${OWNER} repo)"
						continue
					fi
					LAST_COUNT=0
					cmd_submodules_update_one "$dir" "$repo" || true
					__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
					__walk_repos=$((__walk_repos + 1))
				done
				print_summary "repos updated" "$__walk_total"
			fi
			;;
		*)
			usage_error "Unknown submodules subcommand: $sub" "submodules init|deinit|update [dir-spec]"
			;;
	esac
}

