# -----------------------------------------------------------------------------
# Path / selection helpers
# -----------------------------------------------------------------------------

resolve_repo_dir() {
	local spec="$1"
	local base_root="${2:-$ROOT}"

	while [[ "$spec" == */ ]]; do
		spec="${spec%/}"
	done

	if [[ "$spec" == "~" ]]; then
		spec="$HOME"
	elif [[ "$spec" == "~/"* ]]; then
		spec="$HOME/${spec:2}"
	fi

	if [[ "$spec" == /* ]]; then
		printf '%s\n' "$spec"
		return 0
	fi

	if [[ "$spec" == */* || "$spec" == ./* || "$spec" == ../* ]]; then
		if [[ -d "$spec" ]]; then
			(cd "$spec" && pwd)
		else
			printf '%s\n' "$spec"
		fi
		return 0
	fi

	printf '%s\n' "$base_root/$spec"
}

# -----------------------------------------------------------------------------
# Shared walk helper
# -----------------------------------------------------------------------------

__walk_repos=0
__walk_total=0
__walk_bytes=0

foreach_repo() {
	local callback="$1"
	local target="${2:-}"
	local walk_root="${3:-$ROOT}"
	local dir name repo path

	__walk_repos=0
	__walk_total=0
	__walk_bytes=0

	parse_selection_spec "$target"

	if [[ ${#INCLUDE_ITEMS[@]} -eq 1 && ${#EXCLUDE_ITEMS[@]} -eq 0 ]]; then
		dir="$(resolve_repo_dir "${INCLUDE_ITEMS[0]}" "$walk_root")"
		section "$(basename "$dir")"
		repo="$(git_resolve_repo "$dir" "$OWNER")" || displayError "Target must be a ${OWNER} git repository: $dir"
		LAST_COUNT=0
		LAST_BYTES=0
		"$callback" "$dir" "$repo"
		__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
		__walk_bytes=$((__walk_bytes + ${LAST_BYTES:-0}))
		__walk_repos=1
		return 0
	fi

	shopt -s nullglob
	for path in "$walk_root"/*/; do
		dir="${path%/}"
		name="$(basename "$dir")"

		should_process_item "$name" || continue

		section "$name"
		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			warn "Not a git repo — skip"
			continue
		fi
		if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
			warn "Skip (not a usable ${OWNER} repo)"
			continue
		fi
		LAST_COUNT=0
		LAST_BYTES=0
		"$callback" "$dir" "$repo" || true
		__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
		__walk_bytes=$((__walk_bytes + ${LAST_BYTES:-0}))
		__walk_repos=$((__walk_repos + 1))
	done
}

print_summary() {
	local label="$1"
	local count="$2"
	log ""
	printf '  %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' \
		"${_CLR_DIM}" "${_CLR_RESET}"
	printf "  ${_CLR_BOLD}DONE${_CLR_RESET}  ${_CLR_DIM}repos:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}%s:${_CLR_RESET} %s\n" \
		"$__walk_repos" "$label" "$count"
	log ""
}

print_summary_sized() {
	local label="$1"
	local count="$2"
	local bytes="$3"
	log ""
	printf '  %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' \
		"${_CLR_DIM}" "${_CLR_RESET}"
	printf "  ${_CLR_BOLD}DONE${_CLR_RESET}  ${_CLR_DIM}repos:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}%s:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}size:${_CLR_RESET} %s\n" \
		"$__walk_repos" "$label" "$count" "$(human_size "$bytes")"
	log ""
}

# -----------------------------------------------------------------------------
# cache
# -----------------------------------------------------------------------------

_cache_list_rows() {
	local repo="$1"
	gh cache list -R "$repo" --limit "$PAGE_LIMIT" \
		--json id,key,sizeInBytes \
		--jq '.[] | "\(.id)\t\(.sizeInBytes // 0)\t\(.key)"' \
		2>/dev/null || true
}

# Returns 0 if key matches the current CACHE_NAME_FILTER (bash glob)
_cache_key_matches() {
	local key="$1"
	[[ -z "$CACHE_NAME_FILTER" ]] && return 0
	# shellcheck disable=SC2254
	[[ "$key" == $CACHE_NAME_FILTER ]]
}

cmd_cache_show_one() {
	local dir="$1" repo="$2"
	local count=0 bytes=0 id size key entry rest hsz
	local -a entries=()

	info "Remote" "$repo"
	[[ -n "$CACHE_NAME_FILTER" ]] && info "Filter" "--name $CACHE_NAME_FILTER"

	mapfile -t entries < <(_cache_list_rows "$repo")

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No caches"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		size="${rest%%$'\t'*}"
		key="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue
		[[ "$size" =~ ^[0-9]+$ ]] || size=0

		if ! _cache_key_matches "$key"; then
			continue
		fi

		hsz="$(human_size "$size")"
		printf "  %-12s  %-10s  %s\n" "id=$id" "$hsz" "$key"
		count=$((count + 1))
		bytes=$((bytes + size))
	done

	if [[ "$count" -eq 0 ]]; then
		ok "No caches matched the filter"
	else
		info "Repo total" "$count cache(s), $(human_size "$bytes")"
		ok "Listed $count cache(s)"
	fi
	LAST_COUNT=$count
	LAST_BYTES=$bytes
}

cmd_cache_list_one() {
	local dir="$1" repo="$2"
	local count=0 bytes=0 id size key entry rest
	local -a entries=()

	info "Remote" "$repo"
	[[ -n "$CACHE_NAME_FILTER" ]] && info "Filter" "--name $CACHE_NAME_FILTER"

	mapfile -t entries < <(_cache_list_rows "$repo")

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No caches"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		size="${rest%%$'\t'*}"
		key="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue
		[[ "$size" =~ ^[0-9]+$ ]] || size=0

		if ! _cache_key_matches "$key"; then
			continue
		fi

		count=$((count + 1))
		bytes=$((bytes + size))
	done

	if [[ "$count" -eq 0 ]]; then
		ok "No caches matched the filter"
	else
		ok "$count cache(s), $(human_size "$bytes")"
	fi
	LAST_COUNT=$count
	LAST_BYTES=$bytes
}

cmd_cache_delete_one() {
	local dir="$1" repo="$2"
	local deleted=0 page=0 batch id key entry
	local -a entries=()

	info "Remote" "$repo"
	[[ -n "$CACHE_NAME_FILTER" ]] && info "Filter" "--name $CACHE_NAME_FILTER"

	while true; do
		page=$((page + 1))
		if [[ "$MAX_PAGES" -gt 0 && "$page" -gt "$MAX_PAGES" ]]; then
			warn "Reached MAX_PAGES=$MAX_PAGES — stopping this repo"
			break
		fi

		mapfile -t entries < <(
			gh cache list -R "$repo" --limit "$PAGE_LIMIT" \
				--json id,key \
				--jq '.[] | "\(.id)\t\(.key)"' \
				2>/dev/null || true
		)
		batch=${#entries[@]}
		if [[ "$batch" -eq 0 ]]; then
			if [[ "$page" -eq 1 ]]; then
				ok "No caches"
			else
				ok "No more caches"
			fi
			break
		fi

		info "Page" "$page ($batch cache(s))"

		for entry in "${entries[@]}"; do
			id="${entry%%$'\t'*}"
			key="${entry#*$'\t'}"
			[[ -z "$id" ]] && continue

			if ! _cache_key_matches "$key"; then
				continue
			fi

			if [[ "$DRY_RUN" == "1" ]]; then
				log "  [dry-run] would delete id=$id key=$key"
				deleted=$((deleted + 1))
				continue
			fi
			log "  delete id=$id key=$key"
			if gh cache delete "$id" -R "$repo" 2>/dev/null; then
				deleted=$((deleted + 1))
			else
				warn "delete failed for id=$id"
			fi
		done

		[[ "$DRY_RUN" == "1" ]] && break
	done

	ok "Deleted $deleted cache(s)"
	LAST_COUNT=$deleted
	LAST_BYTES=0
}

cmd_cache() {
	local sub="${1:-}"
	shift || true
	local target="" arg

	CACHE_NAME_FILTER=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--name)
				shift
				[[ $# -gt 0 ]] || usage_error "--name requires a value" \
					"cache show|list|delete [dir-spec] [--name <pattern>]"
				CACHE_NAME_FILTER="$1"
				shift
				;;
			--name=*)
				CACHE_NAME_FILTER="${1#--name=}"
				shift
				;;
			-*)
				usage_error "Unknown option: $1" \
					"cache show|list|delete [dir-spec] [--name <pattern>]"
				;;
			*)
				[[ -z "$target" ]] && target="$1"
				shift
				;;
		esac
	done

	case "$sub" in
		show)
			foreach_repo cmd_cache_show_one "$target"
			print_summary_sized "caches listed" "$__walk_total" "$__walk_bytes"
			;;
		list)
			foreach_repo cmd_cache_list_one "$target"
			print_summary_sized "caches" "$__walk_total" "$__walk_bytes"
			;;
		delete)
			foreach_repo cmd_cache_delete_one "$target"
			print_summary "caches deleted" "$__walk_total"
			;;
		*)
			usage_error "Missing or unknown cache subcommand" \
				"cache show|list|delete [dir-spec] [--name <pattern>]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# CI
# -----------------------------------------------------------------------------

_list_runs_for_start() {
	local repo="$1" branch="$2" sha="$3"
	local out=""

	out="$(
		gh run list -R "$repo" --commit "$sha" --limit "$PAGE_LIMIT" \
			--json databaseId,status,conclusion,headSha,displayTitle,workflowName \
			--jq '.[] | "\(.databaseId)\t\(.status)\t\(.conclusion // "-")\t\(.headSha // "")\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
			2>/dev/null || true
	)"
	if [[ -n "$out" ]]; then
		printf '%s\n' "$out"
		return 0
	fi

	gh run list -R "$repo" --branch "$branch" --limit "$PAGE_LIMIT" \
		--json databaseId,status,conclusion,headSha,displayTitle,workflowName \
		--jq '.[] | "\(.databaseId)\t\(.status)\t\(.conclusion // "-")\t\(.headSha // "")\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
		2>/dev/null || true
}

cmd_ci_stop_one() {
	local dir="$1" repo="$2"
	local branch cancelled=0
	local id status workflow title entry rest st
	local -a entries=()
	local -A seen_id=()

	LAST_COUNT=0
	info "Remote" "$repo"

	branch="$(git_current_branch "$dir")"
	[[ -z "$branch" ]] && { err "Cannot resolve current branch"; return 1; }
	info "Branch" "$branch"

	for st in in_progress queued pending waiting requested; do
		while IFS= read -r entry; do
			[[ -z "$entry" ]] && continue
			id="${entry%%$'\t'*}"
			[[ -z "$id" || -n "${seen_id[$id]+x}" ]] && continue
			seen_id["$id"]=1
			entries+=("$entry")
		done < <(
			gh run list -R "$repo" --branch "$branch" --status "$st" --limit "$PAGE_LIMIT" \
				--json databaseId,status,displayTitle,workflowName \
				--jq '.[] | "\(.databaseId)\t\(.status)\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
				2>/dev/null || true
		)
	done

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No active runs on $branch"
		return 0
	fi

	info "Found" "${#entries[@]} unique active run(s)"

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"

		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would cancel: $workflow id=$id"
			cancelled=$((cancelled + 1))
			continue
		fi
		log "  cancel: $workflow id=$id"
		if gh run cancel "$id" -R "$repo" 2>/dev/null; then
			cancelled=$((cancelled + 1))
		else
			warn "cancel failed for id=$id"
		fi
	done

	LAST_COUNT=$cancelled
	ok "Cancelled $cancelled unique workflow run(s)"
}

cmd_ci_start_one() {
	local dir="$1" repo="$2"
	local branch sha rerun=0 skipped=0
	local id status conclusion head_sha workflow title entry rest
	local -a entries=()
	local -A seen_workflow=()

	LAST_COUNT=0
	info "Remote" "$repo"

	branch="$(git_current_branch "$dir")"
	sha="$(git_head_sha_full "$dir")"
	[[ -z "$branch" || -z "$sha" ]] && { err "Cannot resolve branch/HEAD"; return 1; }

	info "Branch" "$branch"
	info "HEAD" "$sha"
	[[ "$ONLY_FAILED" == "1" ]] && info "Filter" "--failed"

	mapfile -t entries < <(_list_runs_for_start "$repo" "$branch" "$sha")

	if [[ ${#entries[@]} -eq 0 ]]; then
		warn "No workflow runs found"
		ok "No workflows re-run"
		return 0
	fi

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		conclusion="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		head_sha="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue

		[[ -n "$workflow" && -n "${seen_workflow[$workflow]+x}" ]] && continue
		[[ -n "$workflow" ]] && seen_workflow["$workflow"]=1

		[[ "$RUN_LIMIT" -gt 0 && "$rerun" -ge "$RUN_LIMIT" ]] && break

		case "$status" in
			in_progress|queued|pending|waiting|requested)
				log "  skip (already active): $workflow"
				skipped=$((skipped + 1))
				continue
				;;
		esac

		if [[ "$ONLY_FAILED" == "1" ]]; then
			case "$conclusion" in
				failure|cancelled|timed_out|startup_failure) ;;
				*) skipped=$((skipped + 1)); continue ;;
			esac
		fi

		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] Re-run: $workflow id=$id"
			rerun=$((rerun + 1))
			continue
		fi

		log "  Re-run: $workflow id=$id"
		if gh run rerun "$id" -R "$repo" 2>/dev/null; then
			rerun=$((rerun + 1))
		else
			warn "rerun failed for id=$id"
		fi
	done

	LAST_COUNT=$rerun
	ok "Re-run $rerun workflow(s) (skipped=$skipped)"
}

cmd_ci_restart_one() {
	cmd_ci_stop_one "$1" "$2"
	[[ "$DRY_RUN" != "1" ]] && sleep 2
	cmd_ci_start_one "$1" "$2"
}

cmd_ci_status_one() {
	local dir="$1" repo="$2"
	local branch
	local -a entries=()
	local id status conclusion workflow title entry rest

	LAST_COUNT=0
	info "Remote" "$repo"

	branch="$(git_current_branch "$dir")"
	[[ -z "$branch" ]] && { err "Cannot resolve current branch"; return 1; }
	info "Branch" "$branch"

	mapfile -t entries < <(
		gh run list -R "$repo" --branch "$branch" --limit 15 \
			--json databaseId,status,conclusion,displayTitle,workflowName \
			--jq '.[] | "\(.databaseId)\t\(.status)\t\(.conclusion // "-")\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
			2>/dev/null || true
	)

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No recent runs"
		return 0
	fi

	printf "  ${_CLR_DIM}%-12s  %-12s  %-20s  %s${_CLR_RESET}\n" "STATUS" "CONCLUSION" "WORKFLOW" "TITLE"
	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		conclusion="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"
		printf "  %-12s  %-12s  %-20s  %s\n" "$status" "$conclusion" "$workflow" "$title"
		LAST_COUNT=$((LAST_COUNT + 1))
	done
	ok "Listed recent runs"
}

cmd_ci() {
	local sub="${1:-}"
	shift || true
	local target="" arg

	for arg in "$@"; do
		case "$arg" in
			--failed) ONLY_FAILED=1 ;;
			*) [[ -z "$target" ]] && target="$arg" ;;
		esac
	done

	case "$sub" in
		stop)
			foreach_repo cmd_ci_stop_one "$target"
			print_summary "runs cancelled" "$__walk_total"
			;;
		start)
			foreach_repo cmd_ci_start_one "$target"
			print_summary "workflows re-run" "$__walk_total"
			;;
		restart)
			foreach_repo cmd_ci_restart_one "$target"
			print_summary "workflows re-run" "$__walk_total"
			;;
		status)
			foreach_repo cmd_ci_status_one "$target"
			print_summary "repos checked" "$__walk_repos"
			;;
		*)
			usage_error "Missing or unknown ci subcommand" "ci stop|start|restart|status [dir-spec] [--failed]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# Submodule dependency helpers
# -----------------------------------------------------------------------------

canonical_repo_id() {
	local url="$1"
	local id
	id="$(printf '%s' "$url" | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')"
	[[ -z "$id" || "$id" != */* ]] && return 1
	printf '%s\n' "${id,,}"
}

urls_from_gitmodules_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	git config --file "$file" --list 2>/dev/null \
		| sed -n 's/^submodule\..*\.url=//p' \
		|| true
}

collect_dep_ids_from() {
	local dir="$1"
	local file url id

	[[ -d "$dir" ]] || return 0

	while IFS= read -r -d '' file; do
		while IFS= read -r url; do
			[[ -z "$url" ]] && continue
			id="$(canonical_repo_id "$url" 2>/dev/null)" || continue
			printf '%s\n' "$id"
		done < <(urls_from_gitmodules_file "$file")
	done < <(find "$dir" -type f -name .gitmodules ! -path '*/.git/*' -print0 2>/dev/null)
}

build_update_order() {
	local dir name repo_disp id
	local -a nodes=()
	local -A deps=()
	local -A id_to_folder=()

	shopt -s nullglob
	for dir in "$ROOT"/*/; do
		dir="${dir%/}"
		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			continue
		fi
		if ! repo_disp="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
			continue
		fi
		if ! id="$(canonical_repo_id "https://github.com/${repo_disp}.git")"; then
			continue
		fi
		name="$(basename "$dir")"
		if [[ -n "${id_to_folder[$id]+x}" ]]; then
			warn "Duplicate clone of $id — keeping first"
			continue
		fi
		id_to_folder["$id"]="$name"
		nodes+=("$id")
		deps["$id"]=""
	done

	[[ ${#nodes[@]} -eq 0 ]] && return 0

	for id in "${nodes[@]}"; do
		dir="$ROOT/${id_to_folder[$id]}"
		while IFS= read -r dep_id; do
			[[ -z "$dep_id" || "$dep_id" == "$id" ]] && continue
			if [[ -n "${id_to_folder[$dep_id]+x}" ]]; then
				case " ${deps[$id]:-} " in
					*" $dep_id "*) ;;
					*) deps["$id"]="${deps[$id]:+${deps[$id]} }$dep_id" ;;
				esac
			fi
		done < <(collect_dep_ids_from "$dir" | sort -u)
	done

	local -a ordered_ids
	mapfile -t ordered_ids < <(topological_sort nodes deps)

	for id in "${ordered_ids[@]}"; do
		printf '%s\n' "${id_to_folder[$id]}"
	done
}

# -----------------------------------------------------------------------------
# submodules
# -----------------------------------------------------------------------------

run_q() {
	local out rc
	set +e
	out="$("$@" 2>&1)"
	rc=$?
	set -e
	if [[ "$rc" -ne 0 ]]; then
		err "Command failed: $*"
		err "Exit code: $rc"
		printf '%s\n' "$out" | tail -n 40 >&2
		return "$rc"
	fi
	return 0
}

cmd_submodules_init_one() {
	local dir="$1" repo="$2"

	info "Path" "$dir"
	if [[ ! -f "$dir/.gitmodules" ]]; then
		ok "No .gitmodules — nothing to init"
		LAST_COUNT=0
		return 0
	fi

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule update --init --recursive"
		LAST_COUNT=1
		return 0
	fi

	if git -C "$dir" submodule update --init --recursive; then
		ok "Submodules initialized"
		LAST_COUNT=1
	else
		warn "init failed"
		LAST_COUNT=0
	fi
}

cmd_submodules_deinit_one() {
	local dir="$1" repo="$2"

	info "Path" "$dir"
	if [[ ! -f "$dir/.gitmodules" ]]; then
		ok "No .gitmodules — nothing to deinit"
		LAST_COUNT=0
		return 0
	fi

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule deinit --all -f"
		LAST_COUNT=1
		return 0
	fi

	if git -C "$dir" submodule deinit --all -f; then
		ok "Submodules deinitialized"
		LAST_COUNT=1
	else
		warn "deinit failed"
		LAST_COUNT=0
	fi
}

commit_submodules_if_needed() {
	local dir="$1"
	local name
	name="$(basename "$dir")"

	if ! git_is_dirty "$dir"; then
		ok "No changes"
		return 1
	fi

	log "  Changes detected:"
	git -C "$dir" status --short | sed 's/^/    /'

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would commit and push"
		return 0
	fi

	run_q git -C "$dir" add -A
	if git -C "$dir" diff --cached --quiet; then
		warn "Dirty worktree but nothing staged; skipping commit"
		git -C "$dir" restore --staged . >/dev/null 2>&1 || true
		return 1
	fi
	if ! git -C "$dir" commit -m "Updated submodules" >/dev/null; then
		err "git commit failed in $name"
		return 1
	fi
	if ! git -C "$dir" push >/dev/null; then
		err "git push failed in $name"
		return 1
	fi
	ok "Commit + push ($(git_head_sha "$dir"))"
	return 0
}

cmd_submodules_update_one() {
	local dir="$1" repo="$2"
	local stashed=0
	local sm_name sm_path sm_url branch abs short

	info "Path" "$dir"
	LAST_COUNT=0

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] root submodules: branch= → origin/<branch>; no branch= → keep pin"
		log "  [dry-run] nested: submodule update --init --recursive (no --remote)"
		if git_is_dirty "$dir"; then
			LAST_COUNT=1
		fi
		return 0
	fi

	if git_stash_if_dirty "$dir" "StormByte-GitHub auto-stash before submodules update"; then
		stashed=1
		ok "Parent changes stashed"
	fi

	if [[ -f "$dir/.gitmodules" ]]; then
		# --- Root-level submodules only (paths listed in this repo's .gitmodules) ---
		while IFS=$'\t' read -r sm_name sm_path sm_url; do
			[[ -z "$sm_name" || -z "$sm_path" ]] && continue
			abs="$dir/$sm_path"
			branch="$(git -C "$dir" config -f .gitmodules --get "submodule.${sm_name}.branch" 2>/dev/null || true)"

			# Ensure worktree exists (does not move a pin to remote)
			if ! git -C "$dir" submodule update --init -- "$sm_path" >/dev/null 2>&1; then
				warn "  init failed for $sm_path"
				continue
			fi

			if [[ -n "$branch" ]]; then
				log "  root '${sm_name}' (${sm_path}): track origin/${branch}"
				# Plain fetch — same command that works manually
				if ! git -C "$abs" fetch origin >/dev/null 2>&1; then
					warn "  fetch failed for $sm_path"
					continue
				fi
				if ! git -C "$abs" rev-parse --verify "origin/${branch}" >/dev/null 2>&1; then
					warn "  origin/${branch} missing after fetch for $sm_path"
					continue
				fi
				if ! git -C "$abs" checkout -B "$branch" "origin/${branch}" >/dev/null 2>&1; then
					warn "  checkout origin/${branch} failed for $sm_path"
					continue
				fi
				short="$(git -C "$abs" rev-parse --short HEAD 2>/dev/null || echo "?")"
				ok "  ${sm_name} → ${short} (origin/${branch})"
			else
				log "  root '${sm_name}' (${sm_path}): pinned (no branch= in .gitmodules)"
				# Recorded gitlink only — never --remote
				git -C "$dir" submodule update -- "$sm_path" >/dev/null 2>&1 || true
				short="$(git -C "$abs" rev-parse --short HEAD 2>/dev/null || echo "?")"
				ok "  ${sm_name} at pinned ${short}"
			fi
		done < <(git_gitmodules_list "$dir")

		# --- Nested: respect SHAs recorded by each parent (do not float) ---
		log "  nested: update --init --recursive (pins from parent commits)"
		if git -C "$dir" submodule update --init --recursive >/dev/null 2>&1; then
			ok "  nested submodules synchronized to recorded SHAs"
		else
			warn "  nested submodule update had errors (pins may be incomplete)"
		fi
	fi

	if commit_submodules_if_needed "$dir"; then
		LAST_COUNT=1
	else
		LAST_COUNT=0
	fi

	if [[ "$stashed" -eq 1 ]]; then
		log "  Restoring parent stash..."
		if git_stash_pop_safe "$dir"; then
			ok "Parent stash restored"
		else
			warn "stash pop had conflicts. Parent changes remain in the stash (git stash list)."
			warn "Resolve them, then: git stash drop"
		fi
	fi
}

_sb_resolve_single_repo_dir() {
	local raw="$1"
	local candidate

	if [[ "$raw" == ~* ]]; then
		raw="${raw/#\~/$HOME}"
	fi
	if [[ "$raw" == /* || "$raw" == ./* || "$raw" == ../* ]]; then
		candidate="$raw"
	else
		candidate="${ROOT%/}/$raw"
	fi
	if [[ ! -d "$candidate" ]]; then
		displayError "Not a directory: $1 (tried: $candidate)"
	fi
	(cd "$candidate" && pwd)
}

cmd_submodules_list_one() {
	local dir="$1" repo="$2"
	local name path url count=0

	info "Path" "$dir"
	info "Remote" "$repo"

	if ! git_has_submodules "$dir"; then
		info "Submodules" "none"
		LAST_COUNT=0
		return 0
	fi

	printf "  ${_CLR_DIM}%-36s  %-40s  %s${_CLR_RESET}\n" "NAME" "PATH" "URL"
	while IFS=$'\t' read -r name path url; do
		[[ -z "$name" ]] && continue
		printf "  %-36s  %-40s  %s\n" "$name" "$path" "$url"
		count=$((count + 1))
	done < <(git_gitmodules_list "$dir")

	info "Count" "$count"
	ok "Listed $count submodule(s)"
	LAST_COUNT=$count
}

cmd_submodules_add() {
	local name="" dir="" url="" path=""
	local -a pos=()
	local repo

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--name)
				shift
				[[ $# -gt 0 ]] || usage_error "--name requires a value" \
					"submodules add <dir> <URL> <path> --name <name>"
				name="$1"
				shift
				;;
			--name=*)
				name="${1#--name=}"
				shift
				;;
			-*)
				usage_error "Unknown option: $1" \
					"submodules add <dir> <URL> <path> --name <name>"
				;;
			*)
				pos+=("$1")
				shift
				;;
		esac
	done

	[[ -n "$name" ]] || usage_error "Missing required --name" \
		"submodules add <dir> <URL> <path> --name <name>"

	if [[ ${#pos[@]} -ne 3 ]]; then
		usage_error "Expected <dir> <URL> <path> (got ${#pos[@]} positional args)" \
			"submodules add <dir> <URL> <path> --name <name>"
	fi

	dir="$(_sb_resolve_single_repo_dir "${pos[0]}")"
	url="${pos[1]}"
	path="${pos[2]}"

	repo="$(git_resolve_repo "$dir" "$OWNER")" \
		|| displayError "Target must be a ${OWNER} git repository: $dir"

	if ! git_submodule_path_is_safe "$path"; then
		displayError "Invalid path '$path' (must be relative to the repo and must not contain '..')"
	fi

	section "$(basename "$dir")"
	info "Path" "$dir"
	info "Remote" "$repo"
	info "Name" "$name"
	info "URL" "$url"
	info "Submodule path" "$path"

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git -C \"$dir\" submodule add --name \"$name\" \"$url\" \"$path\""
		log "  [dry-run] (no init / no update)"
		return 0
	fi

	if git -C "$dir" submodule add --name "$name" "$url" "$path"; then
		ok "Submodule added (not initialized)"
	else
		displayError "git submodule add failed"
	fi
}

cmd_submodules_delete() {
	local name_sel="" url_sel="" path_sel="" dir=""
	local -a pos=()
	local repo line sm_name sm_path sm_url abs_path selectors=0

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--name)
				shift
				[[ $# -gt 0 ]] || usage_error "--name requires a value" \
					"submodules delete <dir> (--name <name> | --url <url> | --path <path>)"
				name_sel="$1"
				shift
				;;
			--name=*)
				name_sel="${1#--name=}"
				shift
				;;
			--url)
				shift
				[[ $# -gt 0 ]] || usage_error "--url requires a value" \
					"submodules delete <dir> (--name <name> | --url <url> | --path <path>)"
				url_sel="$1"
				shift
				;;
			--url=*)
				url_sel="${1#--url=}"
				shift
				;;
			--path)
				shift
				[[ $# -gt 0 ]] || usage_error "--path requires a value" \
					"submodules delete <dir> (--name <name> | --url <url> | --path <path>)"
				path_sel="$1"
				shift
				;;
			--path=*)
				path_sel="${1#--path=}"
				shift
				;;
			-*)
				usage_error "Unknown option: $1" \
					"submodules delete <dir> (--name <name> | --url <url> | --path <path>)"
				;;
			*)
				pos+=("$1")
				shift
				;;
		esac
	done

	[[ ${#pos[@]} -eq 1 ]] || usage_error "Expected exactly one <dir> (got ${#pos[@]})" \
		"submodules delete <dir> (--name <name> | --url <url> | --path <path>)"

	dir="$(_sb_resolve_single_repo_dir "${pos[0]}")"
	repo="$(git_resolve_repo "$dir" "$OWNER")" \
		|| displayError "Target must be a ${OWNER} git repository: $dir"

	[[ -n "$name_sel" ]] && selectors=$((selectors + 1))
	[[ -n "$url_sel"  ]] && selectors=$((selectors + 1))
	[[ -n "$path_sel" ]] && selectors=$((selectors + 1))

	if [[ "$selectors" -ne 1 ]]; then
		usage_error "Exactly one of --name, --url or --path is required" \
			"submodules delete <dir> (--name <name> | --url <url> | --path <path>)"
	fi

	if [[ -n "$path_sel" ]] && ! git_submodule_path_is_safe "$path_sel"; then
		displayError "Invalid --path '$path_sel' (must be relative to the repo and must not contain '..')"
	fi

	if [[ -n "$name_sel" ]]; then
		line="$(git_gitmodules_find_by_name "$dir" "$name_sel")" \
			|| displayError "No submodule named '$name_sel' in $dir"
	elif [[ -n "$url_sel" ]]; then
		line="$(git_gitmodules_find_by_url "$dir" "$url_sel")" \
			|| displayError "No submodule with URL '$url_sel' in $dir"
	else
		line="$(git_gitmodules_find_by_path "$dir" "$path_sel")" \
			|| displayError "No submodule with path '$path_sel' in $dir"
	fi

	IFS=$'\t' read -r sm_name sm_path sm_url <<<"$line"

	section "$(basename "$dir")"
	info "Path" "$dir"
	info "Remote" "$repo"
	info "Name" "$sm_name"
	info "Submodule path" "$sm_path"
	info "URL" "$sm_url"

	abs_path="$dir/$sm_path"

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would deinit/remove submodule '$sm_name' at $sm_path"
		log "  [dry-run] would delete folder: $abs_path"
		log "  [dry-run] no commit, no push"
		return 0
	fi

	git -C "$dir" submodule deinit -f -- "$sm_path" 2>/dev/null || true
	git -C "$dir" rm -f -- "$sm_path" 2>/dev/null || true
	git -C "$dir" config -f .gitmodules --remove-section "submodule.$sm_name" 2>/dev/null || true
	if [[ -f "$dir/.gitmodules" ]] && ! git_has_submodules "$dir"; then
		git -C "$dir" rm -f -- .gitmodules 2>/dev/null || rm -f "$dir/.gitmodules"
	else
		git -C "$dir" add .gitmodules 2>/dev/null || true
	fi
	rm -rf "$dir/.git/modules/$sm_path" 2>/dev/null || true
	rm -rf "$abs_path" 2>/dev/null || true

	ok "Submodule removed (folder deleted; no commit, no push)"
}

cmd_submodules() {
	local sub="${1:-}"
	shift || true
	local target="${1:-}"
	local name dir repo
	local -a ordered=()

	if [[ -z "$sub" ]]; then
		usage_error "Missing submodules subcommand" \
			"submodules init|deinit|update|list [dir-spec] | add … | delete …"
	fi

	case "$sub" in
		init)
			foreach_repo cmd_submodules_init_one "$target"
			print_summary "repos initialized" "$__walk_total"
			;;
		deinit)
			foreach_repo cmd_submodules_deinit_one "$target"
			print_summary "repos deinitialized" "$__walk_total"
			;;
		update)
			if [[ -n "$target" ]]; then
				foreach_repo cmd_submodules_update_one "$target"
				print_summary "repos updated" "$__walk_total"
			else
				mapfile -t ordered < <(build_update_order)
				if [[ ${#ordered[@]} -eq 0 ]]; then
					warn "No eligible repositories under $ROOT"
					__walk_repos=0
					__walk_total=0
					print_summary "repos updated" 0
					return 0
				fi
				info "Update order" "$(IFS=','; echo "${ordered[*]}")"
				__walk_repos=0
				__walk_total=0
				for name in "${ordered[@]}"; do
					dir="$ROOT/$name"
					section "$name"
					if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
						warn "Skip (not a usable ${OWNER} repo)"
						continue
					fi
					LAST_COUNT=0
					cmd_submodules_update_one "$dir" "$repo" || true
					__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
					__walk_repos=$((__walk_repos + 1))
				done
				print_summary "repos updated" "$__walk_total"
			fi
			;;
		list)
			foreach_repo cmd_submodules_list_one "$target"
			print_summary "submodules listed" "$__walk_total"
			;;
		add)
			cmd_submodules_add "$@"
			;;
		delete)
			cmd_submodules_delete "$@"
			;;
		*)
			usage_error "Unknown submodules subcommand: $sub" \
				"submodules init|deinit|update|list [dir-spec] | add … | delete …"
			;;
	esac
}

# -----------------------------------------------------------------------------
# git (reset | pull | sync)
# -----------------------------------------------------------------------------

cmd_git_reset_one() {
	local dir="$1"
	info "Path" "$dir"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git reset --hard && git clean -fd"
		LAST_COUNT=1
		return 0
	fi
	if git -C "$dir" reset --hard && git -C "$dir" clean -fd; then
		ok "Reset complete"
		LAST_COUNT=1
	else
		warn "Reset failed"
		LAST_COUNT=0
	fi
}

cmd_git_pull_one() {
	local dir="$1"
	info "Path" "$dir"
	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git fetch origin && git pull --rebase"
		LAST_COUNT=1
		return 0
	fi
	if git -C "$dir" fetch origin && git -C "$dir" pull --rebase; then
		ok "Pull complete ($(git_head_sha "$dir"))"
		LAST_COUNT=1
	else
		warn "Pull failed"
		LAST_COUNT=0
	fi
}

cmd_git_sync_one() {
	cmd_git_pull_one "$@"
}

cmd_git() {
	local sub="${1:-}"
	local target="${2:-}"

	case "$sub" in
		reset)
			foreach_repo cmd_git_reset_one "$target"
			print_summary "repos reset" "$__walk_total"
			;;
		pull)
			foreach_repo cmd_git_pull_one "$target"
			print_summary "repos pulled" "$__walk_total"
			;;
		sync)
			foreach_repo cmd_git_sync_one "$target"
			print_summary "repos synced" "$__walk_total"
			;;
		*)
			usage_error "Missing or unknown git subcommand" "git reset|pull|sync [dir-spec]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# repos (list | dump | status | push | release)
# -----------------------------------------------------------------------------

cmd_repos_list() {
	local dir name repo branch tag_or_hash path count=0

	info "Root" "$ROOT"
	log ""
	printf "  ${_CLR_DIM}%-28s  %-36s  %-22s  %s${_CLR_RESET}\n" \
		"FOLDER" "REMOTE" "TAG / COMMIT" "BRANCH"

	shopt -s nullglob
	for path in "$ROOT"/*/; do
		dir="${path%/}"
		name="$(basename "$dir")"

		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			printf "  %-28s  %-36s  %-22s  %s\n" "$name" "-" "-" "-"
			count=$((count + 1))
			continue
		fi

		if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
			repo="$(git_remote_repo "$dir" 2>/dev/null || echo "?")"
		fi

		branch="$(git_current_branch "$dir")"
		[[ -z "$branch" ]] && branch="-"

		tag_or_hash="$(git_latest_tag "$dir")"
		if [[ -z "$tag_or_hash" ]]; then
			tag_or_hash="$(git_head_sha "$dir")"
			[[ -z "$tag_or_hash" ]] && tag_or_hash="-"
		fi

		printf "  %-28s  %-36s  %-22s  %s\n" "$name" "$repo" "$tag_or_hash" "$branch"
		count=$((count + 1))
	done
	shopt -u nullglob

	__walk_repos=$count
	__walk_total=$count
	print_summary "folders listed" "$count"
}

print_size() {
	local file="$1"
	local bytes kib
	if [[ ! -e "$file" ]]; then
		printf '  %-60s  (missing)\n' "$file"
		return
	fi
	bytes="$(wc -c < "$file" | tr -d ' ')"
	kib=$(( (bytes + 1023) / 1024 ))
	printf '  %-60s  %6d KiB\n' "$file" "$kib"
}

dump_files_cpp() {
	local root="$1"
	local dest="$2"
	local base="$3"
	shift 3
	local f rel
	: > "$dest"
	find "$root" -type f \( -name '*.hxx' -o -name '*.h' -o -name '*.cxx' \) \
		! -path '*/.git/*' ! -path '*/build/*' ! -path '*/thirdparty/*' ! -path '*/dist/*' \
		"$@" \
		| sort \
		| while IFS= read -r f; do
			rel="${f#"$base"/}"
			printf '%s\n' \
				"//==============================================================================" \
				"// FILE: $rel" \
				"//==============================================================================" \
				""
			cat "$f"
			printf '\n\n'
		done >> "$dest"
}

dump_files_cmake() {
	local root="$1"
	local dest="$2"
	local base="$3"
	local f rel
	: > "$dest"
	find "$root" -type f \( \
			-name 'CMakeLists.txt' -o -name '*.cmake' -o -name '*.cmake.in' -o \
			-name '*.sh.in' -o -name '*.bat.in' -o -name '*.cmd.in' \
		\) \
		! -path '*/.git/*' ! -path '*/build/*' ! -path '*/thirdparty/*' \
		! -path '*/dist/*' ! -path '*/pkgconf/*' ! -path '*/tools/extra/pkgconf/*' \
		| sort \
		| while IFS= read -r f; do
			rel="${f#"$base"/}"
			printf '%s\n' \
				"//==============================================================================" \
				"// FILE: $rel (this header does not belong to original code)" \
				"//==============================================================================" \
				""
			cat "$f"
			printf '\n\n'
		done >> "$dest"
}

split_file() {
	local file="$1"
	local prefix="$2"
	local size_kb="$3"
	local f
	local -a chunks=()

	if [[ ! -s "$file" ]]; then
		log "  (empty file, not split)"
		return
	fi

	split -b "${size_kb}k" --numeric-suffixes=1 --suffix-length=2 "$file" "$prefix"

	shopt -s nullglob
	for f in ${prefix}*; do
		[[ -e "$f" ]] || continue
		[[ "$f" == *.txt ]] && continue
		mv "$f" "${f}.txt"
	done
	chunks=(${prefix}*.txt)
	shopt -u nullglob

	if [[ ${#chunks[@]} -eq 0 ]]; then
		log "  (no chunks)"
		return
	fi

	log "  Generated chunks:"
	for f in "${chunks[@]}"; do
		print_size "$f"
	done
}

cmd_repos_dump() {
	local dir="" chunk_size_kb="" type="c++"
	local arg project out out_test candidate

	for arg in "$@"; do
		if [[ "$arg" == type=* ]]; then
			type="${arg#type=}"
		elif [[ "$arg" =~ ^[0-9]+$ ]]; then
			chunk_size_kb="$arg"
		elif [[ -z "$dir" ]]; then
			dir="$arg"
		else
			usage_error "Unexpected argument: $arg" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
		fi
	done

	if [[ -z "$dir" ]]; then
		usage_error "repos dump requires a directory" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
	fi

	case "$type" in
		c++|cmake) ;;
		*)
			usage_error "Invalid type='$type'" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
			;;
	esac

	if [[ -n "$chunk_size_kb" ]]; then
		if ! [[ "$chunk_size_kb" =~ ^[0-9]+$ ]] || [[ "$chunk_size_kb" -le 0 ]]; then
			displayError "chunk_size_kb must be a positive integer"
		fi
	fi

	if [[ "$dir" == ~* ]]; then
		dir="${dir/#\~/$HOME}"
	fi
	if [[ "$dir" == /* || "$dir" == ./* || "$dir" == ../* ]]; then
		candidate="$dir"
	else
		candidate="${ROOT%/}/$dir"
	fi

	if [[ ! -d "$candidate" ]]; then
		displayError "Not a directory: $dir (tried: $candidate)"
	fi

	dir="$(cd "$candidate" && pwd)"
	project="$(basename "$dir")"
	out="${OUT}/project_${project}.txt"
	out_test="${OUT}/project_${project}_test.txt"

	rm -f "$out" "$out_test"
	rm -f "${OUT}/project_${project}_part_"*.txt
	rm -f "${OUT}/project_${project}_test_part_"*.txt

	info "Project" "$project"
	info "Type" "$type"
	info "Source dir" "$dir"
	info "OUT" "$OUT"

	if [[ "$type" == "cmake" ]]; then
		dump_files_cmake "$dir" "$out" "$dir"
		: > "$out_test"
		log "sources: $out"
		print_size "$out"
		log "tests:   (skipped for type=cmake)"
	else
		dump_files_cpp "$dir" "$out" "$dir" ! -path "$dir/test/*" ! -path "*/test/*"
		if [[ -d "$dir/test" ]]; then
			dump_files_cpp "$dir/test" "$out_test" "$dir"
		else
			: > "$out_test"
			warn "No test directory at $dir/test"
		fi
		log "sources: $out"
		print_size "$out"
		log "tests:   $out_test"
		print_size "$out_test"
	fi

	if [[ -n "$chunk_size_kb" ]]; then
		log ""
		log "=== Splitting sources into ~${chunk_size_kb} KB chunks ==="
		split_file "$out" "${OUT}/project_${project}_part_" "$chunk_size_kb"
		if [[ "$type" == "c++" ]]; then
			log ""
			log "=== Splitting tests into ~${chunk_size_kb} KB chunks ==="
			split_file "$out_test" "${OUT}/project_${project}_test_part_" "$chunk_size_kb"
		fi
	fi
}

cmd_repos_status_one() {
	local dir="$1" repo="$2"
	local branch upstream ahead=0 behind=0 ab dirty=0 unpushed=0 status_label

	info "Path" "$dir"
	info "Remote" "$repo"

	branch="$(git_current_branch "$dir")"
	[[ -z "$branch" ]] && branch="?"
	info "Branch" "$branch"

	if git_is_dirty "$dir"; then
		dirty=1
		info "Working" "dirty"
	else
		info "Working" "clean"
	fi

	if upstream="$(git_upstream_ref "$dir")"; then
		info "Upstream" "$upstream"
		if ab="$(git_ahead_behind "$dir")"; then
			ahead="${ab%% *}"
			behind="${ab##* }"
			[[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0
			[[ "$behind" =~ ^[0-9]+$ ]] || behind=0
			info "Ahead/Behind" "$ahead / $behind"
			[[ "$ahead" -gt 0 ]] && unpushed=1
		else
			info "Ahead/Behind" "?"
			unpushed=1
		fi
	else
		info "Upstream" "none"
		unpushed=1
	fi

	if [[ "$dirty" -eq 1 && "$unpushed" -eq 1 ]]; then
		status_label="DIRTY+UNPUSHED"
		warn "Status $status_label"
	elif [[ "$dirty" -eq 1 ]]; then
		status_label="DIRTY"
		warn "Status $status_label"
	elif [[ "$unpushed" -eq 1 ]]; then
		status_label="UNPUSHED"
		warn "Status $status_label"
	else
		status_label="OK"
		ok "Status $status_label"
	fi

	LAST_COUNT=1
}

cmd_repos_push_one() {
	local dir="$1" repo="$2"
	local branch upstream

	info "Path" "$dir"
	info "Remote" "$repo"

	branch="$(git_current_branch "$dir")"
	info "Branch" "${branch:-?}"

	if ! upstream="$(git_upstream_ref "$dir")"; then
		warn "No upstream configured — skip push"
		LAST_COUNT=0
		return 0
	fi
	info "Upstream" "$upstream"

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git -C \"$dir\" push"
		LAST_COUNT=1
		return 0
	fi

	if git -C "$dir" push; then
		ok "Push succeeded"
		LAST_COUNT=1
	else
		warn "Push failed"
		LAST_COUNT=0
	fi
}

cmd_repos_release_list_one() {
	local dir="$1"
	repo="$2"
	local filter_ver="${3:-}"
	local tag name pre published url entry rest
	local -a releases=() tags=() orphan=()
	local -A release_tags=()
	local count=0

	info "Path" "$dir"
	info "Remote" "$repo"
	[[ -n "$filter_ver" ]] && info "Filter" "$(version_plain "$filter_ver")"

	mapfile -t releases < <(
		gh release list -R "$repo" --limit 200 \
			--json tagName,name,isPrerelease,publishedAt,url \
			--jq '.[] | "\(.tagName)\t\(.name // "")\t\(.isPrerelease)\t\(.publishedAt // "-")\t\(.url // "")"' \
			2>/dev/null || true
	)

	mapfile -t tags < <(
		{
			git -C "$dir" tag -l 2>/dev/null || true
			git -C "$dir" ls-remote --tags --refs origin 2>/dev/null \
				| sed -E 's#.*refs/tags/##' || true
		} | sort -u
	)

	if [[ ${#releases[@]} -gt 0 ]]; then
		printf "  ${_CLR_DIM}%-22s  %-5s  %-22s  %s${_CLR_RESET}\n" \
			"TAG" "PRE" "PUBLISHED" "TITLE / URL"
	fi

	for entry in "${releases[@]}"; do
		[[ -z "$entry" ]] && continue
		tag="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		name="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		pre="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		published="${rest%%$'\t'*}"
		url="${rest#*$'\t'}"

		release_tags["$tag"]=1
		release_tags["$(version_plain "$tag")"]=1

		if [[ -n "$filter_ver" ]]; then
			local fp tp
			fp="$(version_plain "$filter_ver")"
			tp="$(version_plain "$tag")"
			[[ "$tp" == "$fp" || "$tag" == "$filter_ver" || "$tag" == "v$fp" ]] || continue
		fi

		[[ "$pre" == "true" ]] && pre="yes" || pre="no"
		published="${published%T*}"
		[[ -z "$name" ]] && name="-"
		printf "  %-22s  %-5s  %-22s  %s\n" "$tag" "$pre" "$published" "$name"
		[[ -n "$url" ]] && printf "  %-22s  %-5s  %-22s  %s\n" "" "" "" "$url"
		count=$((count + 1))
	done

	if [[ "$count" -eq 0 ]]; then
		if [[ -n "$filter_ver" ]]; then
			info "Releases" "none matching $(version_plain "$filter_ver")"
		else
			info "Releases" "none"
		fi
	else
		info "Releases listed" "$count"
	fi

	orphan=()
	for tag in "${tags[@]}"; do
		[[ -z "$tag" ]] && continue
		if [[ -n "$filter_ver" ]]; then
			local fp tp
			fp="$(version_plain "$filter_ver")"
			tp="$(version_plain "$tag")"
			[[ "$tp" == "$fp" || "$tag" == "$filter_ver" || "$tag" == "v$fp" ]] || continue
		fi
		if [[ -z "${release_tags[$tag]+x}" && -z "${release_tags[$(version_plain "$tag")]+x}" ]]; then
			orphan+=("$tag")
		fi
	done

	if [[ ${#orphan[@]} -gt 0 ]]; then
		echo
		printf "  ${_CLR_BOLD_YELLOW}Note${_CLR_RESET}  ${_CLR_DIM}│${_CLR_RESET} tag(s) without a GitHub Release:\n"
		for tag in "${orphan[@]}"; do
			printf "    • %s\n" "$tag"
		done
	fi

	ok "List complete"
	LAST_COUNT=$count
}

cmd_repos_release() {
	local spec="" version="" skip_ci=0 do_delete=0 do_list=0
	local dir repo branch changelog notes_file sha ver_plain last_tag last_plain
	local recreate=0 tag confirm
	local -a prerelease_args=() positionals=()
	local arg has_release has_tag

	for arg in "$@"; do
		case "$arg" in
			--skip-ci) skip_ci=1 ;;
			--delete)  do_delete=1 ;;
			--list)    do_list=1 ;;
			-*)
				usage_error "Unknown option: $arg" \
					"repos release [dir-spec] [version] [--list | --delete | --skip-ci]"
				;;
			*)
				positionals+=("$arg")
				;;
		esac
	done

	if [[ "$do_list" -eq 1 ]]; then
		case ${#positionals[@]} in
			0)
				spec=""
				version=""
				;;
			1)
				if version_is_valid "${positionals[0]}"; then
					spec=""
					version="${positionals[0]}"
				else
					spec="${positionals[0]}"
					version=""
				fi
				;;
			2)
				spec="${positionals[0]}"
				version="${positionals[1]}"
				;;
			*)
				usage_error "Too many arguments for --list" \
					"repos release [dir-spec] [version] --list"
				;;
		esac
	else
		case ${#positionals[@]} in
			0|1)
				usage_error "repos release requires <dir> and <version> (unless --list)" \
					"repos release <dir> <version> [--skip-ci | --delete] | repos release [dir-spec] [version] --list"
				;;
			2)
				spec="${positionals[0]}"
				version="${positionals[1]}"
				;;
			*)
				usage_error "Unexpected extra arguments" \
					"repos release <dir> <version> [--skip-ci | --delete] | repos release [dir-spec] [version] --list"
				;;
		esac
	fi

	if [[ "$do_list" -eq 1 && ( "$do_delete" -eq 1 || "$skip_ci" -eq 1 ) ]]; then
		warn "--delete / --skip-ci are ignored with --list"
	fi
	if [[ "$do_delete" -eq 1 && "$skip_ci" -eq 1 && "$do_list" -eq 0 ]]; then
		warn "--skip-ci is ignored with --delete"
	fi
	if [[ "$do_list" -eq 1 && "$do_delete" -eq 1 ]]; then
		displayError "Use either --list or --delete, not both"
	fi

	# -------------------------------------------------------------------------
	# LIST
	# -------------------------------------------------------------------------
	if [[ "$do_list" -eq 1 ]]; then
		local filter_ver=""
		[[ -n "$version" ]] && filter_ver="$(version_plain "$version")"

		if [[ -n "$spec" && "$spec" != '!'* ]]; then
			dir="$(resolve_repo_dir "$spec" "$ROOT")"
			[[ -d "$dir" ]] || displayError "Directory does not exist: $dir"
			section "$(basename "$dir")"
			repo="$(git_resolve_repo "$dir" "$OWNER")" \
				|| displayError "Target must be a ${OWNER} git repository: $dir"
			LAST_COUNT=0
			cmd_repos_release_list_one "$dir" "$repo" "$filter_ver"
			print_summary "releases listed" "$LAST_COUNT"
			return 0
		fi

		_release_list_walk() {
			local d="$1" r="$2"
			cmd_repos_release_list_one "$d" "$r" "$filter_ver"
		}
		foreach_repo _release_list_walk "$spec"
		print_summary "releases listed" "$__walk_total"
		return 0
	fi

	# -------------------------------------------------------------------------
	# Shared validation for CREATE / DELETE
	# -------------------------------------------------------------------------
	version_is_valid "$version" \
		|| displayError "Invalid version: $version (expected e.g. 1.0.0 or 1.0.0-rc.1)"

	ver_plain="$(version_plain "$version")"
	tag="$version"

	dir="$(resolve_repo_dir "$spec" "$ROOT")"
	[[ -d "$dir" ]] || displayError "Directory does not exist: $dir"

	repo="$(git_resolve_repo "$dir" "$OWNER")" \
		|| displayError "Target must be a ${OWNER} git repository: $dir"

	section "$(basename "$dir")"
	info "Path" "$dir"
	info "Remote" "$repo"
	info "Version / tag" "$tag"
	if [[ "$do_delete" -eq 1 ]]; then
		info "Mode" "DELETE"
	else
		info "Mode" "CREATE"
	fi

	# -------------------------------------------------------------------------
	# DELETE
	# -------------------------------------------------------------------------
	if [[ "$do_delete" -eq 1 ]]; then
		has_release=0
		has_tag=0
		gh release view "$tag" -R "$repo" >/dev/null 2>&1 && has_release=1
		git_tag_exists_local "$dir" "$tag" && has_tag=1
		git_tag_exists_remote "$dir" "$tag" && has_tag=1

		if [[ "$has_release" -eq 0 && "$has_tag" -eq 0 ]]; then
			warn "No GitHub release or tag named $tag — nothing to delete"
			ok "Delete complete (noop)"
			LAST_COUNT=0
			return 0
		fi

		echo
		printf '  %sAbout to DELETE%s\n' "${_CLR_BOLD}" "${_CLR_RESET}"
		printf '    repo:    %s\n' "$repo"
		printf '    tag:     %s\n' "$tag"
		[[ "$has_release" -eq 1 ]] && printf '    release: will remove GitHub Release\n'
		[[ "$has_tag" -eq 1 ]] && printf '    git:     will remove tag (local + origin)\n'
		echo
		printf '  Type %syes%s to continue: ' "${_CLR_BOLD}" "${_CLR_RESET}"
		read -r confirm
		[[ "$confirm" == "yes" ]] || displayError "Aborted (confirmation was not exactly \"yes\")"

		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would: gh release delete $tag; delete tag local+origin"
			ok "Dry-run complete"
			LAST_COUNT=1
			return 0
		fi

		if [[ "$has_release" -eq 1 ]]; then
			info "GitHub Release" "deleting $tag"
			gh release delete "$tag" -R "$repo" --yes \
				|| displayError "gh release delete failed"
		fi

		info "Tag" "deleting $tag (local + origin)"
		git_tag_delete_local_remote "$dir" "$tag"

		ok "Deleted $tag on $repo"
		LAST_COUNT=1
		return 0
	fi

	# -------------------------------------------------------------------------
	# CREATE
	# -------------------------------------------------------------------------
	git_is_dirty "$dir" \
		&& displayError "Working tree is not clean — commit or stash before release"

	branch="$(git_current_branch "$dir")"
	[[ -n "$branch" ]] || displayError "Cannot resolve current branch"
	info "Branch" "$branch"
	case "$branch" in
		master|main) ;;
		*) displayError "Release only allowed on master or main (current: $branch)" ;;
	esac

	changelog="$dir/CHANGELOG.md"
	[[ -f "$changelog" ]] \
		|| displayError "CHANGELOG.md not found — create it first (## [$ver_plain] - YYYY-MM-DD)"

	notes_file="$(mktemp)"
	# Expand path at trap setup time so RETURN does not touch a destroyed local under set -u
	trap "rm -f -- $(printf '%q' "$notes_file")" RETURN

	if ! git_changelog_extract_notes "$changelog" "$ver_plain" > "$notes_file"; then
		displayError "CHANGELOG.md has no non-empty section for $ver_plain (need: ## [$ver_plain] - YYYY-MM-DD)"
	fi
	info "Notes" "from CHANGELOG.md ($(wc -l < "$notes_file" | tr -d ' ') lines)"

	last_tag="$(git_latest_tag "$dir")"
	if [[ -n "$last_tag" ]]; then
		info "Latest tag" "$last_tag"
		last_plain="$(version_plain "$last_tag")"
		if semver_lt "$ver_plain" "$last_plain"; then
			displayError "Version $ver_plain is older than latest tag $last_tag"
		elif semver_eq "$ver_plain" "$last_plain"; then
			recreate=1
			warn "Same core version as $last_tag — will delete existing tag/release and recreate"
		fi
	fi

	if git_tag_exists_local "$dir" "$tag" || git_tag_exists_remote "$dir" "$tag"; then
		recreate=1
		warn "Tag $tag already exists — will delete and recreate"
	fi
	if gh release view "$tag" -R "$repo" >/dev/null 2>&1; then
		recreate=1
		warn "GitHub release $tag exists — will delete and recreate"
	fi

	sha="$(git_head_sha_full "$dir")"
	info "HEAD" "${sha:0:12}"

	echo
	printf '  %sAbout to release%s\n' "${_CLR_BOLD}" "${_CLR_RESET}"
	printf '    repo:    %s\n' "$repo"
	printf '    branch:  %s\n' "$branch"
	printf '    tag:     %s\n' "$tag"
	printf '    commit:  %s\n' "$sha"
	[[ "$recreate" -eq 1 ]] && printf '    mode:    %sREPLACE existing tag/release%s\n' "${_CLR_BOLD_YELLOW}" "${_CLR_RESET}"
	if [[ "$skip_ci" -eq 1 ]]; then
		printf '    CI:      skipped (--skip-ci)\n'
	else
		printf '    CI:      wait for green (may take a long time; Ctrl-C is safe)\n'
	fi
	echo
	printf '  --- release notes ---\n'
	sed 's/^/  /' "$notes_file"
	echo
	printf '  Type %syes%s to continue: ' "${_CLR_BOLD}" "${_CLR_RESET}"
	read -r confirm
	[[ "$confirm" == "yes" ]] || displayError "Aborted (confirmation was not exactly \"yes\")"

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] pull --rebase, optional delete old tag/release, wait CI, tag, push, gh release create"
		ok "Dry-run complete"
		LAST_COUNT=1
		return 0
	fi

	info "Sync" "fetch + pull --rebase"
	git -C "$dir" fetch origin || displayError "git fetch failed"
	git -C "$dir" pull --rebase || displayError "git pull --rebase failed"
	git_is_dirty "$dir" && displayError "Dirty after pull — resolve before release"
	sha="$(git_head_sha_full "$dir")"

	if [[ "$skip_ci" -eq 0 ]]; then
		info "CI" "waiting for green on $sha"
		if ! git_wait_ci_success "$repo" "$sha"; then
			displayError "CI not green — release aborted (nothing tagged)"
		fi
	else
		warn "Skipping CI check (--skip-ci)"
	fi

	if [[ "$recreate" -eq 1 ]]; then
		info "Cleanup" "deleting existing GitHub release and tag $tag"
		gh release delete "$tag" -R "$repo" --yes 2>/dev/null || true
		git_tag_delete_local_remote "$dir" "$tag"
	fi

	info "Tag" "$tag"
	if ! git -C "$dir" tag -a "$tag" -m "Version $ver_plain released"; then
		displayError "git tag failed"
	fi

	info "Push" "branch $branch + tag $tag"
	if ! git -C "$dir" push origin "$branch"; then
		git -C "$dir" tag -d "$tag" >/dev/null 2>&1 || true
		displayError "git push origin $branch failed (local tag removed)"
	fi
	if ! git -C "$dir" push origin "$tag"; then
		displayError "git push origin $tag failed — local tag exists; recover with:
git push origin $tag
gh release create $tag -R $repo --title \"Version $ver_plain\" --notes-file <notes>"
	fi

	prerelease_args=()
	if version_is_prerelease "$ver_plain"; then
		prerelease_args=(--prerelease)
		info "Prerelease" "yes"
	fi

	info "GitHub Release" "$tag"
	if ! gh release create "$tag" -R "$repo" \
		--title "Version $ver_plain" \
		--notes-file "$notes_file" \
		"${prerelease_args[@]}"; then
		displayError "gh release create failed — tag is on origin. Recover with:
gh release create $tag -R $repo --title \"Version $ver_plain\" --notes-file <changelog-section>"
	fi

	ok "Released $tag → https://github.com/$repo/releases/tag/$tag"
	LAST_COUNT=1
}

cmd_repos() {
	local sub="${1:-}"
	shift || true
	local target="${1:-}"

	case "$sub" in
		list)
			cmd_repos_list
			;;
		dump)
			cmd_repos_dump "$@"
			;;
		status)
			foreach_repo cmd_repos_status_one "$target"
			print_summary "repos checked" "$__walk_repos"
			;;
		push)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			foreach_repo cmd_repos_push_one "$target"
			print_summary "repos pushed" "$__walk_total"
			;;
		release)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_repos_release "$@"
			;;
		*)
			usage_error "Missing or unknown repos subcommand" \
				"repos list | dump | status [dir-spec] | push [dir-spec] | release [dir-spec] [version] [--list | --delete | --skip-ci]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# clone-all
# -----------------------------------------------------------------------------

cmd_clone_all() {
	local repos name dir cloned=0 skipped=0

	info "Owner" "$OWNER"
	info "Target" "$ROOT"

	mapfile -t repos < <(
		gh repo list "$OWNER" --limit 1000 --json name,isPrivate \
			--jq '.[] | select(.isPrivate == false) | .name' 2>/dev/null || true
	)

	if [[ ${#repos[@]} -eq 0 ]]; then
		warn "No public repositories found for $OWNER"
		return 0
	fi

	for name in "${repos[@]}"; do
		dir="$ROOT/$name"
		if [[ -d "$dir" ]]; then
			log "  skip (exists): $name"
			skipped=$((skipped + 1))
			continue
		fi
		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would clone $OWNER/$name"
			cloned=$((cloned + 1))
			continue
		fi
		log "  cloning $OWNER/$name ..."
		if gh repo clone "$OWNER/$name" "$dir" 2>/dev/null; then
			ok "Cloned $name"
			cloned=$((cloned + 1))
		else
			warn "Failed to clone $name"
		fi
	done

	print_summary "cloned" "$cloned"
	info "Skipped (already present)" "$skipped"
}

# -----------------------------------------------------------------------------
# search
# -----------------------------------------------------------------------------

cmd_search() {
	local query="${1:-}"
	local target="${2:-}"

	[[ -z "$query" ]] && usage_error "search requires a text query" "search <text> [dir-spec]"

	SEARCH_QUERY="$query"

	cmd_search_one() {
		local dir="$1" repo="$2"
		info "Remote" "$repo"
		info "Query" "$SEARCH_QUERY"

		if command -v rg >/dev/null 2>&1; then
			rg -n --color always -S "$SEARCH_QUERY" "$dir" \
				--glob '!.git/*' --glob '!build/*' --glob '!thirdparty/*' --glob '!dist/*' \
				2>/dev/null || true
		else
			grep -RIn --color=always \
				--exclude-dir=.git --exclude-dir=build --exclude-dir=thirdparty --exclude-dir=dist \
				"$SEARCH_QUERY" "$dir" 2>/dev/null || true
		fi
		ok "Search finished"
		LAST_COUNT=1
	}

	foreach_repo cmd_search_one "$target"
	print_summary "repos searched" "$__walk_repos"
}

# -----------------------------------------------------------------------------
# fork
# -----------------------------------------------------------------------------

cmd_fork_status_one() {
	local dir="$1" repo="$2"
	local behind ahead

	info "Remote" "$repo"

	if ! git_is_fork "$repo"; then
		info "Fork" "no"
		ok "Not a fork"
		LAST_COUNT=0
		return 0
	fi

	info "Fork" "yes"
	if behind_ahead="$(git_fork_compare "$repo" 2>/dev/null)"; then
		behind="${behind_ahead%% *}"
		ahead="${behind_ahead##* }"
		info "Behind/Ahead" "${behind:-?} / ${ahead:-?}"
	else
		info "Behind/Ahead" "?"
	fi
	ok "Fork status done"
	LAST_COUNT=1
}

cmd_fork_branch_status_one() {
	local dir="$1" repo="$2"
	local branch count=0 note tip merge_label
	local -a branches=()

	info "Path" "$dir"
	info "Remote" "$repo"

	if ! git -C "$dir" rev-parse --verify master^{commit} >/dev/null 2>&1; then
		warn "No local master branch — cannot check mergeability"
		LAST_COUNT=0
		return 0
	fi

	mapfile -t branches < <(
		git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null \
			| grep -vx 'master' || true
	)

	if [[ ${#branches[@]} -eq 0 ]]; then
		info "Branches" "no branches other than master"
		ok "Nothing to check"
		LAST_COUNT=0
		return 0
	fi

	printf "  ${_CLR_DIM}%-36s  %-12s  %s${_CLR_RESET}\n" "BRANCH" "MERGE→master" "NOTE"
	for branch in "${branches[@]}"; do
		[[ -z "$branch" ]] && continue
		note=""
		tip="$branch"

		if git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/${branch}" 2>/dev/null; then
			tip="origin/${branch}"
			if ! git -C "$dir" rev-parse --verify "$branch^{commit}" >/dev/null 2>&1; then
				note="no local tip"
			elif [[ "$(git -C "$dir" rev-parse "$branch^{commit}")" != "$(git -C "$dir" rev-parse "origin/${branch}^{commit}")" ]]; then
				note="local differs from origin"
			fi
		else
			if git -C "$dir" for-each-ref --format='%(refname)' "refs/remotes/*/${branch}" 2>/dev/null | grep -q .; then
				tip="$(git -C "$dir" for-each-ref --format='%(refname:short)' "refs/remotes/*/${branch}" 2>/dev/null | head -n1)"
			else
				note="local-only (not pushed)"
				tip="$branch"
			fi
		fi

		if git_merge_tree_clean "$dir" "master" "$tip"; then
			merge_label="CLEAN"
		else
			merge_label="CONFLICTS"
		fi

		printf "  %-36s  %-12s  %s\n" "$branch" "$merge_label" "$note"
		count=$((count + 1))
	done

	info "Checked" "$count branch(es)"
	ok "Branch status done"
	LAST_COUNT=$count
}

cmd_fork_sync_one() {
	local dir="$1" repo="$2"
	local behind ahead

	info "Remote" "$repo"

	if ! git_is_fork "$repo"; then
		err "Not a fork: $repo — refusing to sync"
		return 1
	fi

	behind=0
	ahead=0
	if behind_ahead="$(git_fork_compare "$repo" 2>/dev/null)"; then
		behind="${behind_ahead%% *}"
		ahead="${behind_ahead##* }"
		[[ "$behind" =~ ^[0-9]+$ ]] || behind=0
		[[ "$ahead"  =~ ^[0-9]+$ ]] || ahead=0
	fi

	if [[ "$behind" -eq 0 ]]; then
		ok "Already up to date with upstream (behind=$behind, ahead=$ahead) — skip"
		LAST_COUNT=0
		return 0
	fi

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would sync ONLY master ($behind commits behind, $ahead ahead)"
		LAST_COUNT=1
		return 0
	fi

	if git_fork_sync_master "$dir" "$repo"; then
		ok "master synced with upstream (was $behind behind)"
		LAST_COUNT=1
	else
		warn "fork sync failed"
		LAST_COUNT=0
	fi
}

cmd_fork() {
	local sub="${1:-}"
	local target="${2:-}"
	local effective

	effective="$(fork_effective_root)"
	info "Fork root" "$effective"

	case "$sub" in
		status)
			foreach_repo cmd_fork_status_one "$target" "$effective"
			print_summary "forks checked" "$__walk_total"
			;;
		sync)
			foreach_repo cmd_fork_sync_one "$target" "$effective"
			print_summary "forks synced" "$__walk_total"
			;;
		branch-status)
			foreach_repo cmd_fork_branch_status_one "$target" "$effective"
			print_summary "branches checked" "$__walk_total"
			;;
		*)
			usage_error "Missing or unknown fork subcommand" \
				"fork status|sync|branch-status [dir-spec]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# test (asan | tsan)
# -----------------------------------------------------------------------------

cmd_test() {
	local sub="${1:-}"
	shift || true

	case "$sub" in
		asan|tsan)
			_cmd_test_dispatch "$sub" "$@"
			;;
		*)
			usage_error "Missing or unknown test subcommand" \
				"test asan|tsan [dir-spec] [--builddir DIR] [--testdir DIR] [--outfile FILE] [--cmake-options \"opts\"] [--executable PATH] [--test REGEX] [--asan-options \"opts\"] [--tsan-options \"opts\"] [--verbose]"
			;;
	esac
}

_cmd_test_dispatch() {
	local kind="$1"
	shift

	# Shared options (parsed once)
	local target="" builddir="" testdir="" outfile="" cmake_opts="" executable="" test_regex=""
	local asan_opts="" tsan_opts="" verbose=0
	local arg

	# Defaults
	builddir="build-${kind}"
	testdir=""
	outfile=""
	cmake_opts="-DENABLE_TEST=ON"
	asan_opts="abort_on_error=1:halt_on_error=1:detect_leaks=1:symbolize=1:print_stacktrace=1"
	tsan_opts="abort_on_error=1:halt_on_error=1:symbolize=1:print_stacktrace=1"

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--builddir)
				shift
				[[ $# -gt 0 ]] || usage_error "--builddir requires a value" "test ${kind} [dir-spec] [options]"
				builddir="$1"
				shift
				;;
			--builddir=*)
				builddir="${1#--builddir=}"
				shift
				;;
			--testdir)
				shift
				[[ $# -gt 0 ]] || usage_error "--testdir requires a value" "test ${kind} [dir-spec] [options]"
				testdir="$1"
				shift
				;;
			--testdir=*)
				testdir="${1#--testdir=}"
				shift
				;;
			--outfile)
				shift
				[[ $# -gt 0 ]] || usage_error "--outfile requires a value" "test ${kind} [dir-spec] [options]"
				outfile="$1"
				shift
				;;
			--outfile=*)
				outfile="${1#--outfile=}"
				shift
				;;
			--cmake-options)
				shift
				[[ $# -gt 0 ]] || usage_error "--cmake-options requires a value" "test ${kind} [dir-spec] [options]"
				cmake_opts="$1"
				shift
				;;
			--cmake-options=*)
				cmake_opts="${1#--cmake-options=}"
				shift
				;;
			--executable)
				shift
				[[ $# -gt 0 ]] || usage_error "--executable requires a value" "test ${kind} [dir-spec] [options]"
				executable="$1"
				shift
				;;
			--executable=*)
				executable="${1#--executable=}"
				shift
				;;
			--test)
				shift
				[[ $# -gt 0 ]] || usage_error "--test requires a value" "test ${kind} [dir-spec] [options]"
				test_regex="$1"
				shift
				;;
			--test=*)
				test_regex="${1#--test=}"
				shift
				;;
			--asan-options)
				shift
				[[ $# -gt 0 ]] || usage_error "--asan-options requires a value" "test ${kind} [dir-spec] [options]"
				asan_opts="$1"
				shift
				;;
			--asan-options=*)
				asan_opts="${1#--asan-options=}"
				shift
				;;
			--tsan-options)
				shift
				[[ $# -gt 0 ]] || usage_error "--tsan-options requires a value" "test ${kind} [dir-spec] [options]"
				tsan_opts="$1"
				shift
				;;
			--tsan-options=*)
				tsan_opts="${1#--tsan-options=}"
				shift
				;;
			--verbose)
				verbose=1
				shift
				;;
			-*)
				usage_error "Unknown option: $1" \
					"test asan|tsan [dir-spec] [--builddir DIR] [--testdir DIR] [--outfile FILE] [--cmake-options \"opts\"] [--executable PATH] [--test REGEX] [--asan-options \"opts\"] [--tsan-options \"opts\"] [--verbose]"
				;;
			*)
				if [[ -z "$target" ]]; then
					target="$1"
					shift
				else
					usage_error "Unexpected argument: $1" "test ${kind} [dir-spec] [options]"
				fi
				;;
		esac
	done

	# Export options so the per-repo callback can see them
	_TEST_KIND="$kind"
	_TEST_BUILDDIR="$builddir"
	_TEST_TESTDIR="$testdir"
	_TEST_OUTFILE="$outfile"
	_TEST_CMAKE_OPTS="$cmake_opts"
	_TEST_EXECUTABLE="$executable"
	_TEST_REGEX="$test_regex"
	_TEST_ASAN_OPTS="$asan_opts"
	_TEST_TSAN_OPTS="$tsan_opts"
	_TEST_VERBOSE="$verbose"

	foreach_repo _cmd_test_one "$target"
	print_summary "repos tested" "$__walk_repos"
}

_cmd_test_one() {
	local dir="$1" repo="$2"
	local kind="$_TEST_KIND"
	local builddir="$_TEST_BUILDDIR"
	local testdir="$_TEST_TESTDIR"
	local outfile="$_TEST_OUTFILE"
	local cmake_opts="$_TEST_CMAKE_OPTS"
	local executable="$_TEST_EXECUTABLE"
	local test_regex="$_TEST_REGEX"
	local asan_opts="$_TEST_ASAN_OPTS"
	local tsan_opts="$_TEST_TSAN_OPTS"
	local verbose="$_TEST_VERBOSE"
	local name build_abs test_abs out_file
	local -a cmake_cmd=() cmake_extra=()
	local rc=0 tmp_out run_output

	name="$(basename "$dir")"

	# Per-repo defaults
	[[ -z "$testdir" ]] && testdir="${builddir}/test"
	[[ -z "$outfile" ]] && out_file="/tmp/${name}_${kind}_report.txt" || out_file="$outfile"

	build_abs="$(cd "$dir" && realpath -m "$builddir")"
	test_abs="$(cd "$dir" && realpath -m "$testdir")"

	info "Remote" "$repo"
	info "Kind" "${kind^^}"
	info "Build dir" "$build_abs"
	info "Test dir" "$test_abs"
	info "Outfile" "$out_file"
	[[ -n "$executable" ]] && info "Executable" "$executable"
	[[ -n "$test_regex" ]] && info "ctest -R" "$test_regex"
	[[ "$verbose" -eq 1 ]] && info "Verbose" "yes"
	info "CMake opts" "$cmake_opts"

	# Safety: build directory must NOT exist
	if [[ -e "$build_abs" ]]; then
		err "Build directory already exists (safety): $build_abs — skip"
		LAST_COUNT=0
		return 0
	fi

	# Guaranteed cleanup — expand the path NOW (local vars die on RETURN)
	trap "rm -rf -- $(printf '%q' "$build_abs")" RETURN

	# -----------------------------------------------------------------
	# 1. Configure
	# -----------------------------------------------------------------
	cmake_cmd=(
		cmake -S "$dir" -B "$build_abs"
		-DCMAKE_BUILD_TYPE=Debug
	)

	if [[ "$kind" == "asan" ]]; then
		cmake_cmd+=(
			-DCMAKE_C_FLAGS="-fsanitize=address -fno-omit-frame-pointer"
			-DCMAKE_CXX_FLAGS="-fsanitize=address -fno-omit-frame-pointer"
		)
	else
		cmake_cmd+=(
			-DCMAKE_C_FLAGS="-fsanitize=thread -fno-omit-frame-pointer"
			-DCMAKE_CXX_FLAGS="-fsanitize=thread -fno-omit-frame-pointer"
		)
	fi

	# User / default options AFTER sanitizer flags → can override
	if [[ -n "$cmake_opts" ]]; then
		# shellcheck disable=SC2206
		cmake_extra=($cmake_opts)
		cmake_cmd+=("${cmake_extra[@]}")
	fi

	if [[ "$verbose" -eq 1 ]]; then
		printStep "Configuring ${kind^^}"
		echo
		if ! "${cmake_cmd[@]}"; then
			printFail
			err "cmake configure failed"
			LAST_COUNT=0
			return 0
		fi
		printOK
	else
		printStep "Configuring ${kind^^}"
		if "${cmake_cmd[@]}" >/dev/null 2>&1; then
			printOK
		else
			printFail
			err "cmake configure failed"
			LAST_COUNT=0
			return 0
		fi
	fi

	# -----------------------------------------------------------------
	# 2. Compile
	# -----------------------------------------------------------------
	if [[ "$verbose" -eq 1 ]]; then
		printStep "Compiling ${kind^^}"
		echo
		if ! cmake --build "$build_abs" -j"$(nproc)"; then
			printFail
			err "cmake build failed"
			LAST_COUNT=0
			return 0
		fi
		printOK
	else
		printStep "Compiling ${kind^^}"
		if cmake --build "$build_abs" -j"$(nproc)" >/dev/null 2>&1; then
			printOK
		else
			printFail
			err "cmake build failed"
			LAST_COUNT=0
			return 0
		fi
	fi

	# -----------------------------------------------------------------
	# 3. Run
	# -----------------------------------------------------------------
	tmp_out="$(mktemp)"

	if [[ "$kind" == "asan" ]]; then
		export ASAN_OPTIONS="$asan_opts"
		info "ASAN_OPTIONS" "$ASAN_OPTIONS"
	else
		export TSAN_OPTIONS="$tsan_opts"
		info "TSAN_OPTIONS" "$TSAN_OPTIONS"
	fi

	printStep "Running tests"

	if [[ -n "$executable" ]]; then
		local exe_path
		if [[ "$executable" == /* ]]; then
			exe_path="$executable"
		else
			exe_path="$build_abs/$executable"
		fi
		if [[ ! -x "$exe_path" ]]; then
			printFail
			err "Executable not found or not executable: $exe_path"
			rm -f "$tmp_out"
			LAST_COUNT=0
			return 0
		fi
		"$exe_path" >"$tmp_out" 2>&1 || rc=$?
	else
		local -a ctest_cmd=(ctest --test-dir "$test_abs" --output-on-failure)
		[[ -n "$test_regex" ]] && ctest_cmd+=(-R "$test_regex")
		"${ctest_cmd[@]}" >"$tmp_out" 2>&1 || rc=$?
	fi

	run_output="$(cat "$tmp_out")"
	rm -f "$tmp_out"

	if [[ $rc -eq 0 ]]; then
		printOK
		ok "No errors — report not generated"
		LAST_COUNT=1
	else
		printFail
		printf '%s\n' "$run_output" > "$out_file"
		err "Report generated because of error → $out_file"
		LAST_COUNT=0
	fi
	# trap fires on RETURN and removes $build_abs
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
	display_header

	load_or_create_config

	if [[ $# -lt 1 ]]; then
		display_help
		exit 0
	fi

	local cmd="$1"
	shift

	case "$cmd" in
		help|-h|--help)
			display_help
			;;
		cache)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_cache "$@"
			;;
		ci)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_ci "$@"
			;;
		submodules)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_submodules "$@"
			;;
		git)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_git "$@"
			;;
		repos)
			cmd_repos "$@"
			;;
		clone-all)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_clone_all
			;;
		search)
			cmd_search "$@"
			;;
		fork)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_fork "$@"
			;;
		test)
			cmd_test "$@"
			;;
		*)
			usage_error "Unknown command: $cmd" \
				"help | cache | ci | submodules | git | repos | clone-all | search | fork | test"
			;;
	esac
}

main "$@"