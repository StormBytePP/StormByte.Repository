# -----------------------------------------------------------------------------
# Shared prerequisites & repo resolution
# -----------------------------------------------------------------------------

require_tools() {
	local need_gh="${1:-0}"
	if [[ "$need_gh" == "1" ]] && ! command -v gh >/dev/null 2>&1; then
		die "gh CLI not found"
	fi
	if ! command -v git >/dev/null 2>&1; then
		die "git not found"
	fi
}

resolve_repo() {
	local dir="$1"
	local remote_url repo short remote_owner

	if [[ ! -d "$dir" ]]; then
		err "Not a directory: $dir"
		return 1
	fi
	if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
		err "Not a git repository: $dir"
		return 1
	fi

	repo=""
	if remote_url="$(git -C "$dir" remote get-url origin 2>/dev/null)"; then
		repo="$(printf '%s' "$remote_url" \
			| sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')"
	fi
	if [[ -z "$repo" ]]; then
		err "No origin remote in $dir"
		return 1
	fi

	remote_owner="${repo%%/*}"
	short="${repo##*/}"
	if [[ "${remote_owner,,}" != "${OWNER,,}" ]]; then
		err "Origin owner is '${remote_owner}', expected '${OWNER}': $dir"
		return 1
	fi
	printf '%s\n' "${OWNER}/${short}"
}

resolve_target_path() {
	local target="$1"
	if [[ -z "$target" ]]; then
		printf ''
		return 0
	fi
	if [[ "$target" != /* ]]; then
		target="$ROOT/$target"
	fi
	printf '%s\n' "$target"
}

__walk_repos=0
__walk_total=0
__walk_bytes=0

foreach_repo() {
	local callback="$1"
	local target="${2:-}"
	local dir name repo path

	__walk_repos=0
	__walk_total=0
	__walk_bytes=0

	if [[ -n "$target" ]]; then
		dir="$(resolve_target_path "$target")"
		section "$(basename "$dir")"
		repo="$(resolve_repo "$dir")" || die "Target must be a ${OWNER} git repository"
		LAST_COUNT=0
		LAST_BYTES=0
		"$callback" "$dir" "$repo"
		__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
		__walk_bytes=$((__walk_bytes + ${LAST_BYTES:-0}))
		__walk_repos=1
		return 0
	fi

	shopt -s nullglob
	for path in "$ROOT"/*/; do
		dir="${path%/}"
		name="$(basename "$dir")"
		section "$name"
		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			warn "Not a git repo — skip"
			continue
		fi
		if ! repo="$(resolve_repo "$dir" 2>/dev/null)"; then
			warn "Skip (not a usable ${OWNER} repo)"
			continue
		fi
		LAST_COUNT=0
		LAST_BYTES=0
		"$callback" "$dir" "$repo" || true
		__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
		__walk_bytes=$((__walk_bytes + ${LAST_BYTES:-0}))
		__walk_repos=$((__walk_repos + 1))
	done
}

print_summary() {
	local label="$1"
	local count="$2"
	log ""
	printf '  %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' \
		"${_CLR_DIM}" "${_CLR_RESET}"
	printf "  ${_CLR_BOLD}DONE${_CLR_RESET}  ${_CLR_DIM}repos:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}%s:${_CLR_RESET} %s\n" \
		"$__walk_repos" "$label" "$count"
	log ""
}

print_summary_sized() {
	local label="$1"
	local count="$2"
	local bytes="$3"
	log ""
	printf '  %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' \
		"${_CLR_DIM}" "${_CLR_RESET}"
	printf "  ${_CLR_BOLD}DONE${_CLR_RESET}  ${_CLR_DIM}repos:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}%s:${_CLR_RESET} %s  ${_CLR_DIM}│${_CLR_RESET}  ${_CLR_DIM}size:${_CLR_RESET} %s\n" \
		"$__walk_repos" "$label" "$count" "$(human_size "$bytes")"
	log ""
}

human_size() {
	local b="${1:-0}"
	[[ "$b" =~ ^[0-9]+$ ]] || b=0
	if [[ "$b" -lt 1024 ]]; then
		printf '%s B' "$b"
	elif [[ "$b" -lt $((1024 * 1024)) ]]; then
		printf '%s KiB' "$(( (b + 512) / 1024 ))"
	elif [[ "$b" -lt $((1024 * 1024 * 1024)) ]]; then
		printf '%s MiB' "$(awk -v b="$b" 'BEGIN { printf "%.1f", b / (1024*1024) }')"
	else
		printf '%s GiB' "$(awk -v b="$b" 'BEGIN { printf "%.2f", b / (1024*1024*1024) }')"
	fi
}

# -----------------------------------------------------------------------------
# cache
# -----------------------------------------------------------------------------

_cache_list_rows() {
	local repo="$1"
	gh cache list -R "$repo" --limit "$PAGE_LIMIT" \
		--json id,key,sizeInBytes \
		--jq '.[] | "\(.id)\t\(.sizeInBytes // 0)\t\(.key)"' \
		2>/dev/null || true
}

cmd_cache_show_one() {
	local dir="$1"
	local repo="$2"
	local count=0 bytes=0 id size key entry rest hsz
	local -a entries=()

	info "Remote" "$repo"
	mapfile -t entries < <(_cache_list_rows "$repo")

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No caches"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	printf "  ${_CLR_DIM}%-10s  %-12s  %s${_CLR_RESET}\n" "SIZE" "ID" "KEY"
	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		size="${rest%%$'\t'*}"
		key="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue
		[[ "$size" =~ ^[0-9]+$ ]] || size=0
		hsz="$(human_size "$size")"
		printf "  %-10s  %-12s  %s\n" "$hsz" "$id" "$key"
		count=$((count + 1))
		bytes=$((bytes + size))
	done

	if [[ "$count" -eq "$PAGE_LIMIT" ]]; then
		warn "List may be truncated at PAGE_LIMIT=$PAGE_LIMIT (gh has no cache cursor)"
	fi

	info "Repo total" "$count cache(s), $(human_size "$bytes")"
	ok "Listed $count cache(s)"
	LAST_COUNT=$count
	LAST_BYTES=$bytes
}

cmd_cache_list_one() {
	local dir="$1"
	local repo="$2"
	local count=0 bytes=0 id size key entry rest
	local -a entries=()

	info "Remote" "$repo"
	mapfile -t entries < <(_cache_list_rows "$repo")

	if [[ ${#entries[@]} -eq 0 ]]; then
		ok "No caches"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		size="${rest%%$'\t'*}"
		key="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue
		[[ "$size" =~ ^[0-9]+$ ]] || size=0
		count=$((count + 1))
		bytes=$((bytes + size))
	done

	if [[ "$count" -eq "$PAGE_LIMIT" ]]; then
		warn "List may be truncated at PAGE_LIMIT=$PAGE_LIMIT"
	fi

	ok "$count cache(s), $(human_size "$bytes")"
	LAST_COUNT=$count
	LAST_BYTES=$bytes
}

cmd_cache_delete_one() {
	local dir="$1"
	local repo="$2"
	local deleted=0 page=0 batch id key entry
	local -a entries=()

	info "Remote" "$repo"

	while true; do
		page=$((page + 1))
		if [[ "$MAX_PAGES" -gt 0 && "$page" -gt "$MAX_PAGES" ]]; then
			warn "Reached MAX_PAGES=$MAX_PAGES — stopping this repo"
			break
		fi

		mapfile -t entries < <(
			gh cache list -R "$repo" --limit "$PAGE_LIMIT" \
				--json id,key \
				--jq '.[] | "\(.id)\t\(.key)"' \
				2>/dev/null || true
		)
		batch=${#entries[@]}
		if [[ "$batch" -eq 0 ]]; then
			if [[ "$page" -eq 1 ]]; then
				ok "No caches"
			else
				ok "No more caches"
			fi
			break
		fi

		info "Page" "$page ($batch cache(s))"

		for entry in "${entries[@]}"; do
			id="${entry%%$'\t'*}"
			key="${entry#*$'\t'}"
			[[ -z "$id" ]] && continue
			if [[ "$DRY_RUN" == "1" ]]; then
				log "  [dry-run] would delete id=$id key=$key"
				deleted=$((deleted + 1))
				continue
			fi
			log "  delete id=$id key=$key"
			if gh cache delete "$id" -R "$repo" 2>/dev/null; then
				deleted=$((deleted + 1))
			else
				warn "delete failed for id=$id"
			fi
		done

		if [[ "$DRY_RUN" == "1" ]]; then
			break
		fi
	done

	ok "Deleted $deleted cache(s)"
	LAST_COUNT=$deleted
	LAST_BYTES=0
}

cmd_cache() {
	local sub="${1:-}"
	local target="${2:-}"
	require_tools 1

	if [[ -z "$sub" ]]; then
		err "Missing cache subcommand"
		log "Use: ${SCRIPT_NAME} cache show|list|delete [repo-dir]"
		log ""
		display_help
		exit 1
	fi

	case "$sub" in
		show)
			foreach_repo cmd_cache_show_one "$target"
			print_summary_sized "caches listed" "$__walk_total" "$__walk_bytes"
			;;
		list)
			foreach_repo cmd_cache_list_one "$target"
			print_summary_sized "caches" "$__walk_total" "$__walk_bytes"
			;;
		delete)
			foreach_repo cmd_cache_delete_one "$target"
			print_summary "caches deleted" "$__walk_total"
			;;
		*)
			err "Unknown cache subcommand: $sub"
			log "Use: ${SCRIPT_NAME} cache show|list|delete [repo-dir]"
			log ""
			display_help
			exit 1
			;;
	esac
}

# -----------------------------------------------------------------------------
# runners (workflow runs only — no per-job API calls)
# -----------------------------------------------------------------------------

## Lines: id \t status \t conclusion \t headSha \t workflowName \t title
_list_runs_for_start() {
	local repo="$1"
	local branch="$2"
	local sha="$3"
	local out=""

	# Prefer exact commit (HEAD). Full path --workflow is unreliable on gh CLI.
	out="$(
		gh run list -R "$repo" --commit "$sha" --limit "$PAGE_LIMIT" \
			--json databaseId,status,conclusion,headSha,displayTitle,workflowName \
			--jq '.[] | "\(.databaseId)\t\(.status)\t\(.conclusion // "-")\t\(.headSha // "")\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
			2>/dev/null || true
	)"
	if [[ -n "$out" ]]; then
		printf '%s\n' "$out"
		return 0
	fi

	# Fallback: branch tip (e.g. SHA not on remote yet / API lag)
	gh run list -R "$repo" --branch "$branch" --limit "$PAGE_LIMIT" \
		--json databaseId,status,conclusion,headSha,displayTitle,workflowName \
		--jq '.[] | "\(.databaseId)\t\(.status)\t\(.conclusion // "-")\t\(.headSha // "")\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
		2>/dev/null || true
}

## Cancel each active run on the branch. One API call per unique run; GitHub cancels all jobs.
cmd_runners_stop_one() {
	local dir="$1"
	local repo="$2"
	local branch
	local cancelled=0
	local id status workflow title entry rest st
	local -a entries=()
	local -A seen_id=()
	local -a unique_ids=()
	local max_passes=3
	local pass=0

	LAST_COUNT=0
	LAST_BYTES=0

	info "Remote" "$repo"

	if ! branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"; then
		err "Cannot resolve current branch in $dir"
		return 1
	fi
	info "Branch" "$branch"
	info "Action" "Cancel active workflow runs (all jobs in each run)"

	# ------------------------------------------------------------------
	# 1) Collect unique active run IDs (one shot)
	# ------------------------------------------------------------------
	entries=()
	seen_id=()
	for st in in_progress queued pending waiting requested; do
		while IFS= read -r entry; do
			[[ -z "$entry" ]] && continue
			id="${entry%%$'\t'*}"
			[[ -z "$id" || -n "${seen_id[$id]+x}" ]] && continue
			seen_id["$id"]=1
			entries+=("$entry")
			unique_ids+=("$id")
		done < <(
			gh run list -R "$repo" --branch "$branch" --status "$st" --limit "$PAGE_LIMIT" \
				--json databaseId,status,displayTitle,workflowName \
				--jq '.[] | "\(.databaseId)\t\(.status)\t\(.workflowName // "-")\t\(.displayTitle // "")"' \
				2>/dev/null || true
		)
	done

	if [[ ${#unique_ids[@]} -eq 0 ]]; then
		ok "No active runs on $branch"
		LAST_COUNT=0
		return 0
	fi

	info "Found" "${#unique_ids[@]} unique active run(s)"

	# ------------------------------------------------------------------
	# 2) Cancel each unique run exactly once
	# ------------------------------------------------------------------
	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"

		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would cancel: $workflow id=$id status=$status title=$title"
			cancelled=$((cancelled + 1))
			continue
		fi

		log "  cancel: $workflow id=$id status=$status title=$title"
		if gh run cancel "$id" -R "$repo" 2>/dev/null; then
			cancelled=$((cancelled + 1))
		else
			warn "cancel failed for id=$id (may already be terminal)"
		fi
	done

	# ------------------------------------------------------------------
	# 3) Optional quick second check (rarely needed)
	# ------------------------------------------------------------------
	if [[ "$DRY_RUN" != "1" && "$cancelled" -gt 0 ]]; then
		sleep 3
		local still_active=0
		for st in in_progress queued pending waiting requested; do
			still_active=$(( still_active + $(
				gh run list -R "$repo" --branch "$branch" --status "$st" --limit 5 \
					--json databaseId --jq 'length' 2>/dev/null || echo 0
			) ))
		done
		if [[ "$still_active" -gt 0 ]]; then
			warn "$still_active run(s) still appearing as active (GitHub lag) — they should finish cancelling shortly"
		fi
	fi

	LAST_COUNT=$cancelled
	LAST_BYTES=0

	if [[ "$cancelled" -eq 0 ]]; then
		ok "Cancelled 0 workflow run(s)"
	else
		ok "Cancelled $cancelled unique workflow run(s)"
	fi
}

## Re-run latest finished run per workflow for HEAD (fallback: branch). No job counting.
cmd_runners_start_one() {
	local dir="$1"
	local repo="$2"
	local branch sha
	local rerun=0 skipped=0
	local id status conclusion head_sha workflow title entry rest
	local -a entries=()
	local -A seen_workflow=()

	LAST_COUNT=0
	LAST_BYTES=0

	info "Remote" "$repo"

	if ! branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"; then
		err "Cannot resolve current branch in $dir"
		return 1
	fi
	if ! sha="$(git -C "$dir" rev-parse HEAD 2>/dev/null)"; then
		err "Cannot resolve HEAD in $dir"
		return 1
	fi

	info "Branch" "$branch"
	info "HEAD" "$sha"
	info "Action" "Re-run all jobs — latest run per workflow on this commit/branch"

	if [[ "$ONLY_FAILED" == "1" ]]; then
		info "Filter" "ONLY_FAILED"
	fi
	if [[ "$RUN_LIMIT" -gt 0 ]]; then
		info "Cap" "RUN_LIMIT=$RUN_LIMIT"
	fi

	mapfile -t entries < <(_list_runs_for_start "$repo" "$branch" "$sha")

	if [[ ${#entries[@]} -eq 0 ]]; then
		warn "No workflow runs found for commit $sha (or branch $branch)"
		ok "No workflows re-run"
		return 0
	fi

	# gh lists newest first → first time we see a workflowName is the latest run
	for entry in "${entries[@]}"; do
		id="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		status="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		conclusion="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		head_sha="${rest%%$'\t'*}"
		rest="${rest#*$'\t'}"
		workflow="${rest%%$'\t'*}"
		title="${rest#*$'\t'}"
		[[ -z "$id" ]] && continue

		if [[ -n "$workflow" && -n "${seen_workflow[$workflow]+x}" ]]; then
			continue
		fi
		[[ -n "$workflow" ]] && seen_workflow["$workflow"]=1

		if [[ "$RUN_LIMIT" -gt 0 && "$rerun" -ge "$RUN_LIMIT" ]]; then
			break
		fi

		case "$status" in
			in_progress|queued|pending|waiting|requested)
				log "  skip (already active): $workflow id=$id"
				skipped=$((skipped + 1))
				continue
				;;
		esac

		if [[ "$ONLY_FAILED" == "1" ]]; then
			case "$conclusion" in
				failure|cancelled|timed_out|startup_failure) ;;
				*)
					skipped=$((skipped + 1))
					continue
					;;
			esac
		fi

		if [[ -n "$head_sha" && "$head_sha" != "$sha" ]]; then
			warn "Run SHA ($head_sha) ≠ local HEAD ($sha) for $workflow — re-running anyway"
		fi

		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] Re-run all jobs: $workflow id=$id conclusion=$conclusion title=$title"
			rerun=$((rerun + 1))
			continue
		fi

		log "  Re-run all jobs: $workflow id=$id conclusion=$conclusion title=$title"
		if gh run rerun "$id" -R "$repo" 2>/dev/null; then
			rerun=$((rerun + 1))
		else
			warn "rerun failed for id=$id ($workflow)"
		fi
	done

	LAST_COUNT=$rerun
	LAST_BYTES=0

	if [[ "$rerun" -eq 0 ]]; then
		ok "No workflows re-run (skipped=$skipped)"
	else
		ok "Re-run $rerun workflow(s) (skipped=$skipped)"
	fi
}

cmd_runners_restart_one() {
	local dir="$1"
	local repo="$2"

	cmd_runners_stop_one "$dir" "$repo"
	if [[ "$DRY_RUN" != "1" ]]; then
		sleep 2
	fi
	cmd_runners_start_one "$dir" "$repo"
}

cmd_runners() {
	local sub="${1:-}"
	local target="${2:-}"
	require_tools 1

	if [[ -z "$sub" ]]; then
		err "Missing runners subcommand"
		log "Use: ${SCRIPT_NAME} runners stop|start|restart [repo-dir]"
		log ""
		display_help
		exit 1
	fi

	case "$sub" in
		stop)
			foreach_repo cmd_runners_stop_one "$target"
			print_summary "runs cancelled" "$__walk_total"
			;;
		start)
			foreach_repo cmd_runners_start_one "$target"
			print_summary "workflows re-run" "$__walk_total"
			;;
		restart)
			foreach_repo cmd_runners_restart_one "$target"
			print_summary "workflows re-run" "$__walk_total"
			;;
		*)
			err "Unknown runners subcommand: $sub"
			log "Use: ${SCRIPT_NAME} runners stop|start|restart [repo-dir]"
			log ""
			display_help
			exit 1
			;;
	esac
}

# -----------------------------------------------------------------------------
# Submodule dependency graph
# -----------------------------------------------------------------------------

canonical_repo_id() {
	local url="$1"
	local id
	id="$(printf '%s' "$url" \
		| sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')"
	[[ -z "$id" || "$id" != */* ]] && return 1
	printf '%s\n' "${id,,}"
}

urls_from_gitmodules_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	git config --file "$file" --list 2>/dev/null \
		| sed -n 's/^submodule\..*\.url=//p' \
		|| true
}

collect_dep_ids_from() {
	local dir="$1"
	local file url id

	[[ -d "$dir" ]] || return 0

	while IFS= read -r -d '' file; do
		while IFS= read -r url; do
			[[ -z "$url" ]] && continue
			id="$(canonical_repo_id "$url" 2>/dev/null)" || continue
			printf '%s\n' "$id"
		done < <(urls_from_gitmodules_file "$file")
	done < <(find "$dir" -type f -name .gitmodules ! -path '*/.git/*' -print0 2>/dev/null)
}

build_update_order() {
	local dir name repo_disp id dep_id d cur child n seen folder
	local -a ids=() zero=() queue=() result_ids=() result=()
	local -A id_to_folder=()
	local -A folder_to_id=()
	local -A deps=()
	local -A indeg=()
	local -A children=()

	shopt -s nullglob
	for dir in "$ROOT"/*/; do
		dir="${dir%/}"
		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			continue
		fi
		if ! repo_disp="$(resolve_repo "$dir" 2>/dev/null)"; then
			continue
		fi
		if ! id="$(canonical_repo_id "https://github.com/${repo_disp}.git")"; then
			continue
		fi
		name="$(basename "$dir")"
		if [[ -n "${id_to_folder[$id]+x}" ]]; then
			warn "Duplicate clone of $id: '${id_to_folder[$id]}' and '$name' — keeping first"
			continue
		fi
		id_to_folder["$id"]="$name"
		folder_to_id["$name"]="$id"
		ids+=("$id")
		indeg["$id"]=0
		deps["$id"]=""
	done

	if [[ ${#ids[@]} -eq 0 ]]; then
		return 0
	fi

	for id in "${ids[@]}"; do
		folder="${id_to_folder[$id]}"
		dir="$ROOT/$folder"
		while IFS= read -r dep_id; do
			[[ -z "$dep_id" || "$dep_id" == "$id" ]] && continue
			if [[ -n "${id_to_folder[$dep_id]+x}" ]]; then
				case " ${deps[$id]:-} " in
					*" $dep_id "*) ;;
					*) deps["$id"]="${deps[$id]:+${deps[$id]} }$dep_id" ;;
				esac
			fi
		done < <(collect_dep_ids_from "$dir" | sort -u)
	done

	for id in "${ids[@]}"; do
		for d in ${deps[$id]:-}; do
			[[ -z "$d" ]] && continue
			children["$d"]="${children[$d]:+${children[$d]} }$id"
			indeg["$id"]=$(( ${indeg[$id]:-0} + 1 ))
		done
	done

	for id in "${ids[@]}"; do
		if [[ ${indeg[$id]:-0} -eq 0 ]]; then
			zero+=("$id")
		fi
	done
	if [[ ${#zero[@]} -gt 0 ]]; then
		mapfile -t zero < <(
			for id in "${zero[@]}"; do
				printf '%s\t%s\n' "${id_to_folder[$id]}" "$id"
			done | sort | cut -f2
		)
		queue=("${zero[@]}")
	fi

	while [[ ${#queue[@]} -gt 0 ]]; do
		cur="${queue[0]}"
		queue=("${queue[@]:1}")
		result_ids+=("$cur")
		for child in ${children[$cur]:-}; do
			[[ -z "$child" ]] && continue
			indeg["$child"]=$(( ${indeg[$child]:-0} - 1 ))
			if [[ ${indeg[$child]:-0} -eq 0 ]]; then
				queue+=("$child")
			fi
		done
	done

	if [[ ${#result_ids[@]} -lt ${#ids[@]} ]]; then
		warn "Dependency cycle or unresolved edges — appending remaining repos"
		for id in "${ids[@]}"; do
			seen=0
			for n in "${result_ids[@]}"; do
				[[ "$n" == "$id" ]] && seen=1 && break
			done
			if [[ "$seen" -eq 0 ]]; then
				result_ids+=("$id")
			fi
		done
	fi

	for id in "${result_ids[@]}"; do
		result+=("${id_to_folder[$id]}")
	done
	printf '%s\n' "${result[@]}"
}

# -----------------------------------------------------------------------------
# submodules
# -----------------------------------------------------------------------------

run_q() {
	local out rc
	set +e
	out="$("$@" 2>&1)"
	rc=$?
	set -e
	if [[ "$rc" -ne 0 ]]; then
		err "Command failed: $*"
		err "Exit code: $rc"
		printf '%s\n' "$out" | tail -n 40 >&2
		return "$rc"
	fi
	return 0
}

cmd_submodules_init_one() {
	local dir="$1"
	local repo="$2"

	info "Path" "$dir"
	if [[ ! -f "$dir/.gitmodules" ]]; then
		ok "No .gitmodules — nothing to init"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule update --init --recursive"
		LAST_COUNT=1
		LAST_BYTES=0
		return 0
	fi

	if git -C "$dir" submodule update --init --recursive; then
		ok "Submodules initialized"
		LAST_COUNT=1
	else
		warn "init failed"
		LAST_COUNT=0
	fi
	LAST_BYTES=0
}

cmd_submodules_deinit_one() {
	local dir="$1"
	local repo="$2"

	info "Path" "$dir"
	if [[ ! -f "$dir/.gitmodules" ]]; then
		ok "No .gitmodules — nothing to deinit"
		LAST_COUNT=0
		LAST_BYTES=0
		return 0
	fi

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would: git submodule deinit --all -f"
		LAST_COUNT=1
		LAST_BYTES=0
		return 0
	fi

	if git -C "$dir" submodule deinit --all -f; then
		ok "Submodules deinitialized"
		LAST_COUNT=1
	else
		warn "deinit failed"
		LAST_COUNT=0
	fi
	LAST_BYTES=0
}

commit_submodules_if_needed() {
	local dir="$1"
	local name
	name="$(basename "$dir")"

	# Return 0 = something was (or would be) committed; 1 = nothing to update
	if [[ -z "$(git -C "$dir" status --porcelain)" ]]; then
		ok "No changes"
		return 1
	fi

	log "  Changes detected:"
	git -C "$dir" status --short | sed 's/^/    /'

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would commit and push"
		return 0
	fi

	run_q git -C "$dir" add -A
	if git -C "$dir" diff --cached --quiet; then
		warn "Dirty worktree but nothing staged; skipping commit"
		git -C "$dir" restore --staged . >/dev/null 2>&1 || true
		return 1
	fi
	if ! git -C "$dir" commit -m "Updated submodules" >/dev/null; then
		err "git commit failed in $name"
		return 1
	fi
	if ! git -C "$dir" push >/dev/null; then
		err "git push failed in $name"
		return 1
	fi
	ok "Commit + push ($(git -C "$dir" rev-parse --short HEAD))"
	return 0
}

cmd_submodules_update_one() {
	local dir="$1"
	local repo="$2"

	info "Path" "$dir"
	LAST_COUNT=0
	LAST_BYTES=0

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would clean, fetch, submodule update --remote, commit if needed"
		# Count only if the worktree would have changes after a real update is unknown;
		# dry-run of the full pipeline still reports "would process" as 0 unless porcelain is dirty.
		if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
			LAST_COUNT=1
		fi
		return 0
	fi

	if [[ -f "$dir/.gitmodules" ]]; then
		run_q git -C "$dir" submodule foreach --recursive git clean -fd
		run_q git -C "$dir" submodule foreach --recursive git reset --hard
	fi
	run_q git -C "$dir" clean -fd
	run_q git -C "$dir" reset --hard

	if [[ -f "$dir/.gitmodules" ]]; then
		run_q git -C "$dir" fetch --recurse-submodules origin
		run_q git -C "$dir" submodule update --init --remote
		run_q git -C "$dir" submodule foreach --recursive \
			git submodule update --init --recursive
	fi

	if commit_submodules_if_needed "$dir"; then
		LAST_COUNT=1
	else
		LAST_COUNT=0
	fi
	LAST_BYTES=0
}

cmd_submodules() {
	local sub="${1:-}"
	local target="${2:-}"
	local name dir repo
	local -a ordered=()

	require_tools 0

	if [[ -z "$sub" ]]; then
		err "Missing submodules subcommand"
		log "Use: ${SCRIPT_NAME} submodules init|deinit|update [repo-dir]"
		log ""
		display_help
		exit 1
	fi

	case "$sub" in
		init)
			foreach_repo cmd_submodules_init_one "$target"
			print_summary "repos initialized" "$__walk_total"
			;;
		deinit)
			foreach_repo cmd_submodules_deinit_one "$target"
			print_summary "repos deinitialized" "$__walk_total"
			;;
		update)
			if [[ -n "$target" ]]; then
				foreach_repo cmd_submodules_update_one "$target"
				print_summary "repos updated" "$__walk_total"
			else
				mapfile -t ordered < <(build_update_order)
				if [[ ${#ordered[@]} -eq 0 ]]; then
					warn "No eligible repositories under $ROOT"
					__walk_repos=0
					__walk_total=0
					print_summary "repos updated" 0
					return 0
				fi
				info "Update order" "$(IFS=','; echo "${ordered[*]}")"
				__walk_repos=0
				__walk_total=0
				__walk_bytes=0
				for name in "${ordered[@]}"; do
					dir="$ROOT/$name"
					section "$name"
					if ! repo="$(resolve_repo "$dir" 2>/dev/null)"; then
						warn "Skip (not a usable ${OWNER} repo)"
						continue
					fi
					LAST_COUNT=0
					LAST_BYTES=0
					cmd_submodules_update_one "$dir" "$repo" || true
					__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
					__walk_repos=$((__walk_repos + 1))
				done
				print_summary "repos updated" "$__walk_total"
			fi
			;;
		*)
			err "Unknown submodules subcommand: $sub"
			log "Use: ${SCRIPT_NAME} submodules init|deinit|update [repo-dir]"
			log ""
			display_help
			exit 1
			;;
	esac
}

