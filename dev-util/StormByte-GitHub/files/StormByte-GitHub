# -----------------------------------------------------------------------------
# Path / selection helpers
# -----------------------------------------------------------------------------

resolve_repo_dir() {
	local spec="$1"
	local base_root="${2:-$ROOT}"

	while [[ "$spec" == */ ]]; do
		spec="${spec%/}"
	done

	if [[ "$spec" == "~" ]]; then
		spec="$HOME"
	elif [[ "$spec" == "~/"* ]]; then
		spec="$HOME/${spec:2}"
	fi

	if [[ "$spec" == /* ]]; then
		printf '%s\n' "$spec"
		return 0
	fi

	if [[ "$spec" == */* || "$spec" == ./* || "$spec" == ../* ]]; then
		if [[ -d "$spec" ]]; then
			(cd "$spec" && pwd)
		else
			printf '%s\n' "$spec"
		fi
		return 0
	fi

	printf '%s\n' "$base_root/$spec"
}

# -----------------------------------------------------------------------------
# Shared walk helper
# -----------------------------------------------------------------------------

__walk_repos=0
__walk_total=0
__walk_bytes=0

foreach_repo() {
	local callback="$1"
	local target="${2:-}"
	local walk_root="${3:-$ROOT}"
	local dir name repo path

	__walk_repos=0
	__walk_total=0
	__walk_bytes=0

	parse_selection_spec "$target"

	if [[ ${#INCLUDE_ITEMS[@]} -eq 1 && ${#EXCLUDE_ITEMS[@]} -eq 0 ]]; then
		dir="$(resolve_repo_dir "${INCLUDE_ITEMS[0]}" "$walk_root")"
		section "$(basename "$dir")"
		repo="$(git_resolve_repo "$dir" "$OWNER")" || displayError "Target must be a ${OWNER} git repository: $dir"
		LAST_COUNT=0
		LAST_BYTES=0
		"$callback" "$dir" "$repo"
		__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
		__walk_bytes=$((__walk_bytes + ${LAST_BYTES:-0}))
		__walk_repos=1
		return 0
	fi

	shopt -s nullglob
	for path in "$walk_root"/*/; do
		dir="${path%/}"
		name="$(basename "$dir")"

		should_process_item "$name" || continue

		section "$name"
		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			warn "Not a git repo — skip"
			continue
		fi
		if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
			warn "Skip (not a usable ${OWNER} repo)"
			continue
		fi
		LAST_COUNT=0
		LAST_BYTES=0
		"$callback" "$dir" "$repo" || true
		__walk_total=$((__walk_total + ${LAST_COUNT:-0}))
		__walk_bytes=$((__walk_bytes + ${LAST_BYTES:-0}))
		__walk_repos=$((__walk_repos + 1))
	done
}

