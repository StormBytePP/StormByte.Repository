cmd_repos_list() {
	local dir name repo branch tag_or_hash path count=0

	info "Root" "$ROOT"
	log ""
	printf "  ${_CLR_DIM}%-28s  %-36s  %-22s  %s${_CLR_RESET}\n" \
		"FOLDER" "REMOTE" "TAG / COMMIT" "BRANCH"

	shopt -s nullglob
	for path in "$ROOT"/*/; do
		dir="${path%/}"
		name="$(basename "$dir")"

		if [[ ! -d "$dir/.git" && ! -f "$dir/.git" ]]; then
			printf "  %-28s  %-36s  %-22s  %s\n" "$name" "-" "-" "-"
			count=$((count + 1))
			continue
		fi

		if ! repo="$(git_resolve_repo "$dir" "$OWNER" 2>/dev/null)"; then
			repo="$(git_remote_repo "$dir" 2>/dev/null || echo "?")"
		fi

		branch="$(git_current_branch "$dir")"
		[[ -z "$branch" ]] && branch="-"

		# Latest tag by creator date; fallback to short HEAD hash
		tag_or_hash="$(git -C "$dir" tag -l --sort=-creatordate 2>/dev/null | head -n1 || true)"
		if [[ -z "$tag_or_hash" ]]; then
			tag_or_hash="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo "-")"
		fi

		printf "  %-28s  %-36s  %-22s  %s\n" "$name" "$repo" "$tag_or_hash" "$branch"
		count=$((count + 1))
	done
	shopt -u nullglob

	__walk_repos=$count
	__walk_total=$count
	print_summary "folders listed" "$count"
}

print_size() {
	local file="$1"
	local bytes kib
	if [[ ! -e "$file" ]]; then
		printf '  %-60s  (missing)\n' "$file"
		return
	fi
	bytes="$(wc -c < "$file" | tr -d ' ')"
	kib=$(( (bytes + 1023) / 1024 ))
	printf '  %-60s  %6d KiB\n' "$file" "$kib"
}

dump_files_cpp() {
	local root="$1"
	local dest="$2"
	local base="$3"
	shift 3
	local f rel
	: > "$dest"
	find "$root" -type f \( -name '*.hxx' -o -name '*.h' -o -name '*.cxx' \) \
		! -path '*/.git/*' ! -path '*/build/*' ! -path '*/thirdparty/*' ! -path '*/dist/*' \
		"$@" \
		| sort \
		| while IFS= read -r f; do
			rel="${f#"$base"/}"
			printf '%s\n' \
				"//==============================================================================" \
				"// FILE: $rel" \
				"//==============================================================================" \
				""
			cat "$f"
			printf '\n\n'
		done >> "$dest"
}

dump_files_cmake() {
	local root="$1"
	local dest="$2"
	local base="$3"
	local f rel
	: > "$dest"
	find "$root" -type f \( \
			-name 'CMakeLists.txt' -o -name '*.cmake' -o -name '*.cmake.in' -o \
			-name '*.sh.in' -o -name '*.bat.in' -o -name '*.cmd.in' \
		\) \
		! -path '*/.git/*' ! -path '*/build/*' ! -path '*/thirdparty/*' \
		! -path '*/dist/*' ! -path '*/pkgconf/*' ! -path '*/tools/extra/pkgconf/*' \
		| sort \
		| while IFS= read -r f; do
			rel="${f#"$base"/}"
			printf '%s\n' \
				"//==============================================================================" \
				"// FILE: $rel" \
				"//==============================================================================" \
				""
			cat "$f"
			printf '\n\n'
		done >> "$dest"
}

split_file() {
	local file="$1"
	local prefix="$2"
	local size_kb="$3"
	local f
	local -a chunks=()

	if [[ ! -s "$file" ]]; then
		log "  (empty file, not split)"
		return
	fi

	split -b "${size_kb}k" --numeric-suffixes=1 --suffix-length=2 "$file" "$prefix"

	shopt -s nullglob
	for f in ${prefix}*; do
		[[ -e "$f" ]] || continue
		[[ "$f" == *.txt ]] && continue
		mv "$f" "${f}.txt"
	done
	chunks=(${prefix}*.txt)
	shopt -u nullglob

	if [[ ${#chunks[@]} -eq 0 ]]; then
		log "  (no chunks)"
		return
	fi

	log "  Generated chunks:"
	for f in "${chunks[@]}"; do
		print_size "$f"
	done
}

cmd_repos_dump() {
	local dir="" chunk_size_kb="" type="c++"
	local arg project out out_test

	for arg in "$@"; do
		if [[ "$arg" == type=* ]]; then
			type="${arg#type=}"
		elif [[ "$arg" =~ ^[0-9]+$ ]]; then
			chunk_size_kb="$arg"
		elif [[ -z "$dir" ]]; then
			dir="$arg"
		else
			usage_error "Unexpected argument: $arg" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
		fi
	done

	if [[ -z "$dir" ]]; then
		usage_error "repos dump requires a directory" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
	fi

	case "$type" in
		c++|cmake) ;;
		*)
			usage_error "Invalid type='$type'" "repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
			;;
	esac

	if [[ -n "$chunk_size_kb" ]]; then
		if ! [[ "$chunk_size_kb" =~ ^[0-9]+$ ]] || [[ "$chunk_size_kb" -le 0 ]]; then
			displayError "chunk_size_kb must be a positive integer"
		fi
	fi

	if [[ ! -d "$dir" ]]; then
		displayError "Not a directory: $dir"
	fi

	dir="$(cd "$dir" && pwd)"
	project="$(basename "$dir")"
	out="${OUT}/project_${project}.txt"
	out_test="${OUT}/project_${project}_test.txt"

	rm -f "$out" "$out_test"
	rm -f "${OUT}/project_${project}_part_"*.txt
	rm -f "${OUT}/project_${project}_test_part_"*.txt

	info "Project" "$project"
	info "Type" "$type"
	info "Source dir" "$dir"
	info "OUT" "$OUT"

	if [[ "$type" == "cmake" ]]; then
		dump_files_cmake "$dir" "$out" "$dir"
		: > "$out_test"
		log "sources: $out"
		print_size "$out"
		log "tests:   (skipped for type=cmake)"
	else
		dump_files_cpp "$dir" "$out" "$dir" ! -path "$dir/test/*" ! -path "*/test/*"
		if [[ -d "$dir/test" ]]; then
			dump_files_cpp "$dir/test" "$out_test" "$dir"
		else
			: > "$out_test"
			warn "No test directory at $dir/test"
		fi
		log "sources: $out"
		print_size "$out"
		log "tests:   $out_test"
		print_size "$out_test"
	fi

	if [[ -n "$chunk_size_kb" ]]; then
		log ""
		log "=== Splitting sources into ~${chunk_size_kb} KB chunks ==="
		split_file "$out" "${OUT}/project_${project}_part_" "$chunk_size_kb"
		if [[ "$type" == "c++" ]]; then
			log ""
			log "=== Splitting tests into ~${chunk_size_kb} KB chunks ==="
			split_file "$out_test" "${OUT}/project_${project}_test_part_" "$chunk_size_kb"
		fi
	fi
}

cmd_repos() {
	local sub="${1:-}"
	shift || true

	case "$sub" in
		list)
			cmd_repos_list
			;;
		dump)
			cmd_repos_dump "$@"
			;;
		*)
			usage_error "Missing or unknown repos subcommand" \
				"repos list | repos dump <directory> [chunk_size_kb] [type=c++|type=cmake]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# clone-all
# -----------------------------------------------------------------------------

cmd_clone_all() {
	local repos name dir cloned=0 skipped=0

	info "Owner" "$OWNER"
	info "Target" "$ROOT"

	mapfile -t repos < <(
		gh repo list "$OWNER" --limit 1000 --json name,isPrivate \
			--jq '.[] | select(.isPrivate == false) | .name' 2>/dev/null || true
	)

	if [[ ${#repos[@]} -eq 0 ]]; then
		warn "No public repositories found for $OWNER"
		return 0
	fi

	for name in "${repos[@]}"; do
		dir="$ROOT/$name"
		if [[ -d "$dir" ]]; then
			log "  skip (exists): $name"
			skipped=$((skipped + 1))
			continue
		fi
		if [[ "$DRY_RUN" == "1" ]]; then
			log "  [dry-run] would clone $OWNER/$name"
			cloned=$((cloned + 1))
			continue
		fi
		log "  cloning $OWNER/$name ..."
		if gh repo clone "$OWNER/$name" "$dir" 2>/dev/null; then
			ok "Cloned $name"
			cloned=$((cloned + 1))
		else
			warn "Failed to clone $name"
		fi
	done

	print_summary "cloned" "$cloned"
	info "Skipped (already present)" "$skipped"
}

# -----------------------------------------------------------------------------
# search
# -----------------------------------------------------------------------------

cmd_search() {
	local query="${1:-}"
	local target="${2:-}"

	[[ -z "$query" ]] && usage_error "search requires a text query" "search <text> [dir-spec]"

	SEARCH_QUERY="$query"

	cmd_search_one() {
		local dir="$1" repo="$2"
		info "Remote" "$repo"
		info "Query" "$SEARCH_QUERY"

		if command -v rg >/dev/null 2>&1; then
			rg -n --color always -S "$SEARCH_QUERY" "$dir" \
				--glob '!.git/*' --glob '!build/*' --glob '!thirdparty/*' --glob '!dist/*' \
				2>/dev/null || true
		else
			grep -RIn --color=always \
				--exclude-dir=.git --exclude-dir=build --exclude-dir=thirdparty --exclude-dir=dist \
				"$SEARCH_QUERY" "$dir" 2>/dev/null || true
		fi
		ok "Search finished"
		LAST_COUNT=1
	}

	foreach_repo cmd_search_one "$target"
	print_summary "repos searched" "$__walk_repos"
}

# -----------------------------------------------------------------------------
# fork
# -----------------------------------------------------------------------------

cmd_fork_status_one() {
	local dir="$1" repo="$2"
	local behind ahead

	info "Remote" "$repo"

	if ! git_is_fork "$repo"; then
		err "Not a fork: $repo"
		return 1
	fi

	if behind_ahead="$(git_fork_compare "$repo")"; then
		behind="${behind_ahead%% *}"
		ahead="${behind_ahead##* }"
		info "Upstream" "$(git_fork_parent "$repo")"
		ok "$behind commits behind, $ahead commits ahead"
	else
		warn "Could not compute behind/ahead"
	fi
	LAST_COUNT=1
}

cmd_fork_sync_one() {
	local dir="$1" repo="$2"
	local behind ahead

	info "Remote" "$repo"

	if ! git_is_fork "$repo"; then
		err "Not a fork: $repo — refusing to sync"
		return 1
	fi

	behind=0
	ahead=0
	if behind_ahead="$(git_fork_compare "$repo" 2>/dev/null)"; then
		behind="${behind_ahead%% *}"
		ahead="${behind_ahead##* }"
		[[ "$behind" =~ ^[0-9]+$ ]] || behind=0
		[[ "$ahead"  =~ ^[0-9]+$ ]] || ahead=0
	fi

	if [[ "$behind" -eq 0 ]]; then
		ok "Already up to date with upstream (behind=$behind, ahead=$ahead) — skip"
		LAST_COUNT=0
		return 0
	fi

	if [[ "$DRY_RUN" == "1" ]]; then
		log "  [dry-run] would sync ONLY master ($behind commits behind, $ahead ahead)"
		LAST_COUNT=1
		return 0
	fi

	if git_fork_sync_master "$dir" "$repo"; then
		ok "master synced with upstream (was $behind behind)"
		LAST_COUNT=1
	else
		warn "fork sync failed"
		LAST_COUNT=0
	fi
}

cmd_fork() {
	local sub="${1:-}"
	local target="${2:-}"
	local effective

	effective="$(fork_effective_root)"
	info "Fork root" "$effective"

	case "$sub" in
		status)
			foreach_repo cmd_fork_status_one "$target" "$effective"
			print_summary "forks checked" "$__walk_total"
			;;
		sync)
			foreach_repo cmd_fork_sync_one "$target" "$effective"
			print_summary "forks synced" "$__walk_total"
			;;
		*)
			usage_error "Missing or unknown fork subcommand" "fork status|sync [dir-spec]"
			;;
	esac
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
	display_header

	load_or_create_config

	if [[ $# -lt 1 ]]; then
		display_help
		exit 0
	fi

	local cmd="$1"
	shift

	case "$cmd" in
		help|-h|--help)
			display_help
			;;
		cache)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_cache "$@"
			;;
		ci)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_ci "$@"
			;;
		submodules)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_submodules "$@"
			;;
		git)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_git "$@"
			;;
		repos)
			cmd_repos "$@"
			;;
		clone-all)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_clone_all
			;;
		search)
			cmd_search "$@"
			;;
		fork)
			[[ "$DRY_RUN" == "1" ]] && info "Mode" "DRY_RUN"
			cmd_fork "$@"
			;;
		*)
			usage_error "Unknown command: $cmd" \
				"help | cache | ci | submodules | git | repos | clone-all | search | fork"
			;;
	esac
}

main "$@"
