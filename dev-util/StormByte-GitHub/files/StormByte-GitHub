#!/usr/bin/env bash
# =============================================================================
# StormByte-GitHub — unified CLI for Actions caches, CI runs, git ops & dumps
# =============================================================================
set -euo pipefail

# -----------------------------------------------------------------------------
# Shared StormByte helpers (colours, displayError, printOK, …)
# -----------------------------------------------------------------------------
readonly STORMBYTE_LIB="${STORMBYTE_LIB:-/lib/StormByte/functions.sh}"
if [[ ! -f "$STORMBYTE_LIB" ]]; then
	printf 'ERROR: StormByte functions not found at %s\n' "$STORMBYTE_LIB" >&2
	printf 'Set STORMBYTE_LIB to the correct path if needed.\n' >&2
	exit 1
fi
# shellcheck source=/lib/StormByte/functions.sh
source "$STORMBYTE_LIB"

# -----------------------------------------------------------------------------
# Version & identity
# -----------------------------------------------------------------------------
readonly VERSION="1.0.0"
readonly OWNER="StormBytePP"
readonly SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

# Runtime options (env overrides)
DRY_RUN="${DRY_RUN:-0}"
ROOT="$(pwd)"
PAGE_LIMIT="${PAGE_LIMIT:-100}"
MAX_PAGES="${MAX_PAGES:-0}"
RUN_LIMIT="${RUN_LIMIT:-0}"
ONLY_FAILED="${ONLY_FAILED:-0}"

# Per-callback results (read by foreach_repo)
LAST_COUNT=0
LAST_BYTES=0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

log() {
	printf '%s\n' "$*"
}

ok() {
	printf "  ${_CLR_BOLD_GREEN}✓  OK${_CLR_RESET} ${_CLR_DIM}│${_CLR_RESET} %s\n" "$*"
}

warn() {
	printf "  ${_CLR_BOLD_YELLOW}⚠  WARNING${_CLR_RESET} ${_CLR_DIM}│${_CLR_RESET} %s\n" "$*"
}

err() {
	printf "  ${_CLR_BOLD_RED}✗  ERROR${_CLR_RESET} ${_CLR_DIM}│${_CLR_RESET} %s\n" "$*" >&2
}

die() {
	displayError "$1"
}

section() {
	printf '\n  %s━━ %s ━━%s\n' "${_CLR_BOLD_CYAN}" "$*" "${_CLR_RESET}"
}

info() {
	printf "  ${_CLR_DIM}%-14s${_CLR_RESET} %s\n" "$1" "$2"
}

# -----------------------------------------------------------------------------
# UI
# -----------------------------------------------------------------------------

display_header() {
	local line1="StormByte-GitHub  v${VERSION}"
	local line2="Actions · Git · Submodules · Source dump"
	local inner_w border_mid

	inner_w=${#line1}
	(( ${#line2} > inner_w )) && inner_w=${#line2}
	inner_w=$((inner_w + 4))
	(( inner_w < 50 )) && inner_w=50

	border_mid="$(printf '═%.0s' $(seq 1 "$inner_w"))"

	_sb_center() {
		local text="$1"
		local tw=${#text}
		local total=$inner_w
		local left=$(( (total - tw) / 2 ))
		local right=$(( total - tw - left ))
		printf '%*s%s%*s' "$left" '' "$text" "$right" ''
	}

	printf '\n'
	printf '  %s╔%s╗%s\n' "${_CLR_BOLD_BLUE}" "$border_mid" "${_CLR_RESET}"
	printf '  %s║%s%s%s║%s\n' \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}${_CLR_BOLD}" \
		"$(_sb_center "$line1")" \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	printf '  %s║%s%s%s║%s\n' \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}" \
		"$(_sb_center "$line2")" \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	printf '  %s╚%s╝%s\n' "${_CLR_BOLD_BLUE}" "$border_mid" "${_CLR_RESET}"
	printf '\n'
}

