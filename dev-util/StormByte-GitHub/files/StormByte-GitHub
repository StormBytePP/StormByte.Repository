#!/usr/bin/env bash
# =============================================================================
# StormByte-GitHub — unified CLI for Actions caches, CI runs, git ops & dumps
# =============================================================================
set -euo pipefail

# -----------------------------------------------------------------------------
# Version requirements
# -----------------------------------------------------------------------------
readonly STORMBYTE_GITHUB_VERSION="1.0.0"
readonly REQUIRE_STORMBYTE_FUNCTIONS="1.0.0"
readonly REQUIRE_STORMBYTE_FUNCTIONS_GIT="1.0.0"

# -----------------------------------------------------------------------------
# Locate and load libraries
# -----------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "${SCRIPT_DIR}/functions.sh" ]]; then
	# shellcheck source=/dev/null
	source "${SCRIPT_DIR}/functions.sh"
elif [[ -f "/lib/StormByte/functions.sh" ]]; then
	# shellcheck source=/dev/null
	source "/lib/StormByte/functions.sh"
else
	printf 'ERROR: StormByte functions.sh not found\n' >&2
	exit 1
fi

require_version "${STORMBYTE_FUNCTIONS_VERSION}" "${REQUIRE_STORMBYTE_FUNCTIONS}" "StormByte functions"

if [[ -f "${SCRIPT_DIR}/git.sh" ]]; then
	# shellcheck source=/dev/null
	source "${SCRIPT_DIR}/git.sh"
elif [[ -f "/lib/StormByte/git.sh" ]]; then
	# shellcheck source=/dev/null
	source "/lib/StormByte/git.sh"
else
	displayError "StormByte git.sh not found"
fi

require_version "${STORMBYTE_FUNCTIONS_GIT_VERSION}" "${REQUIRE_STORMBYTE_FUNCTIONS_GIT}" "StormByte git helpers"

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
readonly SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
readonly CONFIG_FILE="${HOME}/.StormByte-GitHub.conf"

DRY_RUN="${DRY_RUN:-0}"
PAGE_LIMIT="${PAGE_LIMIT:-100}"
MAX_PAGES="${MAX_PAGES:-0}"
RUN_LIMIT="${RUN_LIMIT:-0}"
ONLY_FAILED="${ONLY_FAILED:-0}"

_ENV_ROOT="${ROOT-}"
_ENV_OUT="${OUT-}"
_ENV_OWNER="${OWNER-}"
_ENV_FORK_ROOT="${FORK_ROOT-}"

ROOT=""
OUT=""
OWNER=""
FORK_ROOT=""

LAST_COUNT=0
LAST_BYTES=0

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

prompt_config() {
	local input default_root

	default_root="/home/$(id -un 2>/dev/null || echo user)"

	_normalize_path_input() {
		local p="$1"
		p="${p#"${p%%[![:space:]]*}"}"
		p="${p%"${p##*[![:space:]]}"}"
		case "$p" in
			"~")   p="$HOME" ;;
			"~/"*) p="$HOME/${p:2}" ;;
		esac
		while [[ "$p" == */ ]]; do
			p="${p%/}"
		done
		printf '%s\n' "$p"
	}

	printf '  %s┌──────────────────────────────────────────────────────┐%s\n' "${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	printf '  %s│%s  First-run configuration                             %s│%s\n' \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}" "${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	printf '  %s└──────────────────────────────────────────────────────┘%s\n' "${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	echo
	printf '  %sConfig file:%s  %s\n' "${_CLR_DIM}" "${_CLR_RESET}" "$CONFIG_FILE"
	printf '  %sTip:%s  You can override ROOT, OUT, OWNER, FORK_ROOT via environment for a single run.\n' \
		"${_CLR_DIM}" "${_CLR_RESET}"
	echo

	# ----- OWNER -----
	printf '  %s┌─ OWNER ──────────────────────────────────────────────┐%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s GitHub username that owns the repositories.          %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s Used to verify origin remotes and for clone-all.     %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s└──────────────────────────────────────────────────────┘%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	while true; do
		read -r -p "  OWNER [SomeGitHubUser]: " input
		input="${input:-}"
		if [[ -z "$input" ]]; then
			echo "  → Please enter a GitHub username (e.g. SomeGitHubUser)."
			continue
		fi
		if [[ "$input" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]]; then
			OWNER="$input"
			break
		fi
		echo "  → Invalid GitHub username."
	done
	echo

	# ----- ROOT -----
	printf '  %s┌─ ROOT ───────────────────────────────────────────────┐%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s Directory that contains your local repository clones.%s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s Used by most commands when no explicit path is given %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s ("all repositories" mode).                           %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s└──────────────────────────────────────────────────────┘%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	while true; do
		read -e -r -p "  ROOT [${default_root}]: " input
		input="$(_normalize_path_input "${input:-$default_root}")"
		if [[ -d "$input" ]]; then
			ROOT="$(cd "$input" && pwd)"
			break
		fi
		echo "  → Directory does not exist: $input"
	done
	echo

	# ----- OUT -----
	printf '  %s┌─ OUT ────────────────────────────────────────────────┐%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s Output directory for repos dump.                     %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s Created automatically if it does not exist.          %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s└──────────────────────────────────────────────────────┘%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	while true; do
		read -e -r -p "  OUT [/tmp]: " input
		input="$(_normalize_path_input "${input:-/tmp}")"
		if [[ -d "$input" ]]; then
			OUT="$(cd "$input" && pwd)"
			break
		fi
		if mkdir -p "$input" 2>/dev/null; then
			OUT="$(cd "$input" && pwd)"
			break
		fi
		echo "  → Cannot create directory: $input"
	done
	echo

	# ----- FORK_ROOT (optional) -----
	printf '  %s┌─ FORK_ROOT (optional) ───────────────────────────────┐%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s Separate root used ONLY by the "fork" commands.      %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s Leave empty to use ROOT for forks as well.           %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s│%s Useful if your forks live in a different folder.     %s│%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}" "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	printf '  %s└──────────────────────────────────────────────────────┘%s\n' "${_CLR_BOLD_CYAN}" "${_CLR_RESET}"
	while true; do
		read -e -r -p "  FORK_ROOT []: " input
		input="${input:-}"
		if [[ -z "$input" ]]; then
			FORK_ROOT=""
			break
		fi
		input="$(_normalize_path_input "$input")"
		if [[ -d "$input" ]]; then
			FORK_ROOT="$(cd "$input" && pwd)"
			break
		fi
		echo "  → Directory does not exist: $input"
	done
	echo

	{
		echo "# StormByte-GitHub configuration"
		echo "# Generated on $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
		echo
		echo "OWNER=$OWNER"
		echo "ROOT=$ROOT"
		echo "OUT=$OUT"
		if [[ -n "$FORK_ROOT" ]]; then
			echo "FORK_ROOT=$FORK_ROOT"
		fi
	} > "$CONFIG_FILE"

	ok "Configuration written to $CONFIG_FILE"
	echo
}

load_or_create_config() {
	if [[ ! -f "$CONFIG_FILE" ]]; then
		prompt_config
	fi

	load_safe_config "$CONFIG_FILE" OWNER ROOT OUT FORK_ROOT

	[[ -n "$_ENV_ROOT"      ]] && ROOT="$_ENV_ROOT"
	[[ -n "$_ENV_OUT"       ]] && OUT="$_ENV_OUT"
	[[ -n "$_ENV_OWNER"     ]] && OWNER="$_ENV_OWNER"
	[[ -n "$_ENV_FORK_ROOT" ]] && FORK_ROOT="$_ENV_FORK_ROOT"

	[[ -n "$OWNER" ]] || displayError "OWNER is not set in $CONFIG_FILE (or OWNER env)"
	[[ -n "$ROOT"  ]] || displayError "ROOT is not set in $CONFIG_FILE (or ROOT env)"
	[[ -n "$OUT"   ]] || displayError "OUT is not set in $CONFIG_FILE (or OUT env)"

	if [[ -d "$ROOT" ]]; then
		ROOT="$(cd "$ROOT" && pwd)"
	fi
	if [[ ! -d "$ROOT" ]]; then
		displayError "ROOT directory does not exist: $ROOT"
	fi

	ensure_dir "$OUT"
	if [[ -d "$OUT" ]]; then
		OUT="$(cd "$OUT" && pwd)"
	fi

	if [[ -n "$FORK_ROOT" ]]; then
		if [[ -d "$FORK_ROOT" ]]; then
			FORK_ROOT="$(cd "$FORK_ROOT" && pwd)"
		else
			displayError "FORK_ROOT directory does not exist: $FORK_ROOT"
		fi
	fi
}

fork_effective_root() {
	if [[ -n "$FORK_ROOT" ]]; then
		printf '%s\n' "$FORK_ROOT"
	else
		printf '%s\n' "$ROOT"
	fi
}

