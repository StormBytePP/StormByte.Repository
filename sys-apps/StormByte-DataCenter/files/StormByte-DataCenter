# -----------------------------------------------------------------------------
# Table helpers
# -----------------------------------------------------------------------------
_dc_trunc() {
	local s="$1"
	local w="$2"
	local n=${#s}
	if (( n <= w )); then
		printf '%s' "$s"
		return
	fi
	if (( w <= 1 )); then
		printf '%s' "${s:0:w}"
		return
	fi
	printf '%s…' "${s:0:$((w - 1))}"
}

# Display name: prefer multipath leaf
_dc_display_name() {
	local id="$1"
	local sd_raw access kind
	sd_raw="${WWN_TO_SD[$id]:-}"
	access="${WWN_TO_ACCESS[$id]:-}"
	kind="${WWN_TO_PATH_KIND[$id]:-sd}"
	if [[ "$kind" == "mapper" && -n "$access" ]]; then
		basename "$access"
	elif [[ -n "$sd_raw" ]]; then
		printf '%s' "$sd_raw"
	else
		printf '%s' "?"
	fi
}

_dc_sort_aliases() {
	local aliases="${1:-none}"
	local a sorted="" mpath_a="" wwn_a="" scsi_a="" rest_a=""
	[[ "$aliases" == "none" || -z "$aliases" ]] && { echo "none"; return; }
	for a in $aliases; do
		case "$a" in
			mpath*) mpath_a+="$a " ;;
			wwn-*)  wwn_a+="$a " ;;
			scsi-*) scsi_a+="$a " ;;
			*)      rest_a+="$a " ;;
		esac
	done
	sorted="${mpath_a}${wwn_a}${scsi_a}${rest_a}"
	sorted="${sorted%"${sorted##*[![:space:]]}"}"
	echo "${sorted:-none}"
}

# -----------------------------------------------------------------------------
declare -A SMART_CACHE=()

ensure_maps() {
	if [[ -z "${ALL_WWNS+x}" ]] || [[ ${#ALL_WWNS[@]} -eq 0 ]]; then
		init_disk_maps
	fi
}

_smartctl_a() {
	local access="$1"
	local id="${2:-}"
	local sd="" out=""

	_run() {
		local dev="$1"
		shift
		if command -v timeout >/dev/null 2>&1; then
			as_root timeout "${SMARTCTL_TIMEOUT:-10}" smartctl "$@" -a "$dev" 2>/dev/null || true
		else
			as_root smartctl "$@" -a "$dev" 2>/dev/null || true
		fi
	}

	_ok() {
		local text="$1"
		[[ -n "$text" ]] || return 1
		grep -qi 'Unable to detect device type' <<<"$text" && return 1
		grep -qiE 'START OF|SMART Health|SMART overall|Device Model|Product:' <<<"$text"
	}

	# Prefer underlying sd when known
	if [[ -n "$id" && -v "WWN_TO_SD[$id]" && -n "${WWN_TO_SD[$id]:-}" ]]; then
		sd="/dev/${WWN_TO_SD[$id]}"
		if [[ -b "$sd" ]]; then
			out="$(_run "$sd")"
			_ok "$out" && { printf '%s' "$out"; return 0; }
			out="$(_run "$sd" -d scsi)"
			_ok "$out" && { printf '%s' "$out"; return 0; }
		fi
	fi

	if [[ "$access" == /dev/mapper/* || "$(basename "$access")" == mpath* ]]; then
		out="$(_run "$access" -d scsi)"
		_ok "$out" && { printf '%s' "$out"; return 0; }
	else
		out="$(_run "$access")"
		_ok "$out" && { printf '%s' "$out"; return 0; }
		out="$(_run "$access" -d scsi)"
		_ok "$out" && { printf '%s' "$out"; return 0; }
	fi

	printf '%s' "${out:-}"
}

get_smart_cached() {
	local key="$1"
	local access out

	if [[ -v "SMART_CACHE[$key]" ]]; then
		printf '%s' "${SMART_CACHE[$key]}"
		return 0
	fi
	access=$(resolve_to_access_dev "$key" 2>/dev/null) || {
		SMART_CACHE[$key]=""
		return 1
	}
	out="$(_smartctl_a "$access" "$key")"
	SMART_CACHE[$key]="$out"
	printf '%s' "$out"
}

ordered_ids() {
	ensure_maps
	local id sd key
	local -a keys=()
	for id in "${ALL_WWNS[@]}"; do
		sd="${WWN_TO_SD[$id]:-}"
		[[ -n "$sd" ]] || continue
		key="$(enclosure_sort_key "$sd")"
		keys+=("$key|$id")
	done
	local line
	[[ ${#keys[@]} -eq 0 ]] && return 0
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		echo "${line##*|}"
	done < <(printf '%s\n' "${keys[@]}" | LC_ALL=C sort)
}

_zpool_exists() {
	zpool list -H -o name "$1" &>/dev/null
}

_is_btrfs_path() {
	local path="$1"
	[[ -e "$path" ]] || return 1
	if command -v findmnt >/dev/null 2>&1; then
		local fstype
		fstype=$(findmnt -n -o FSTYPE -T "$path" 2>/dev/null || true)
		[[ "$fstype" == "btrfs" ]] && return 0
		return 1
	fi
	if [[ -b "$path" ]]; then
		local t
		t=$(blkid -o value -s TYPE "$path" 2>/dev/null || true)
		[[ "$t" == "btrfs" ]] && return 0
	fi
	return 1
}

_require_btrfs_path() {
	local path="$1"
	if ! _is_btrfs_path "$path"; then
		displayError "Not a btrfs filesystem (or path not on btrfs): $path"
	fi
}

_led_write() {
	local slot_dir="$1"
	local value="$2"
	if [[ $EUID -eq 0 ]]; then
		echo "$value" >"$slot_dir/locate"
	else
		echo "$value" | sudo tee "$slot_dir/locate" >/dev/null
	fi
}

_led_set_user() {
	local input="$1"
	local value="$2"
	local id prefix

	if [[ -d "$input" && -f "$input/locate" ]]; then
		_led_write "$input" "$value"
		return $?
	fi

	id=$(extract_wwn "$input") || return 1
	if ! [[ "$id" =~ ^[0-9a-fA-F]{16,}$ ]]; then
		err "Device has no SES enclosure slot (not a SAS/WWN disk): $input"
		return 1
	fi
	prefix="${id%?}"
	find_slot_by_wwn_prefix "$prefix" || return 1
	_led_write "$SLOT_DIR" "$value"
}

# -----------------------------------------------------------------------------
# disk list
# -----------------------------------------------------------------------------
_print_list_header() {
	local verbose="$1"
	if [[ "$verbose" -eq 1 ]]; then
		printf "%-12s %-72s %-12s %-20s %-8s %-4s %-18s %-8s %-6s %-12s %-8s %-4s %-14s\n" \
			"Device" "Identifiers" "Vendor" "Model" "FW" "Pool" \
			"Enclosure" "SMART" "Temp" "Link" "Health" "LED" "Path"
		printf "%-12s %-72s %-12s %-20s %-8s %-4s %-18s %-8s %-6s %-12s %-8s %-4s %-14s\n" \
			"------------" \
			"------------------------------------------------------------------------" \
			"------------" "--------------------" "--------" "----" \
			"------------------" "--------" "------" "------------" "--------" "----" "--------------"
	else
		printf "%-12s %-72s %-12s %-20s %-8s %-4s %-4s\n" \
			"Device" "Identifiers" "Vendor" "Model" "FW" "Pool" "LED"
		printf "%-12s %-72s %-12s %-20s %-8s %-4s %-4s\n" \
			"------------" \
			"------------------------------------------------------------------------" \
			"------------" "--------------------" "--------" "----" "----"
	fi
}

_print_one_disk() {
	local id="$1"
	local verbose="$2"
	local pool_status="$3"
	local lsscsi_out="${4:-}"
	local sd_raw display aliases vendor model firmware line in_pool led
	local enc_slot smart_st temp link health path kind access

	sd_raw="${WWN_TO_SD[$id]:-}"
	[[ -n "$sd_raw" ]] || return 1

	access="${WWN_TO_ACCESS[$id]:-/dev/$sd_raw}"
	kind="${WWN_TO_PATH_KIND[$id]:-sd}"
	display="$(_dc_display_name "$id")"
	aliases="$(_dc_sort_aliases "${WWN_ALIASES[$id]:-none}")"

	line=$(grep -wF "/dev/$sd_raw" <<<"$lsscsi_out" | head -1 || true)
	if [[ -z "$line" ]]; then
		vendor="?"; model="?"; firmware="?"
	else
		vendor=$(awk '{print $3}' <<<"$line")
		model=$(awk '{print $4}' <<<"$line")
		firmware=$(awk '{print $5}' <<<"$line")
	fi

	if [[ "$vendor" == "ATA" ]]; then
		local ata_alias ata_info ata_model
		ata_alias=$(grep -oE 'ata-[^ ]+' <<<"${WWN_ALIASES[$id]:-}" | head -1 || true)
		if [[ -n "$ata_alias" ]]; then
			ata_info="${ata_alias#ata-}"
			ata_model="${ata_info%_*}"
			vendor="${ata_model%%_*}"
			model="${ata_model#*_}"
			model="${model//_/ }"
		fi
		if [[ -f "/sys/block/$sd_raw/device/rev" ]]; then
			firmware=$(<"/sys/block/$sd_raw/device/rev")
			firmware="${firmware#"${firmware%%[![:space:]]*}"}"
			firmware="${firmware%"${firmware##*[![:space:]]}"}"
		fi
	fi

	in_pool="NO"
	is_in_pool_status "$id" "$pool_status" && in_pool="YES"

	led=$(led_status "$sd_raw" 2>/dev/null || echo "N/A")
	[[ -z "$led" ]] && led="N/A"

	path="$(basename "$access")"
	[[ "$kind" == "mapper" ]] && path="mp:${path}"

	if [[ "$verbose" -eq 1 ]]; then
		enc_slot=$(get_enclosure_slot "$sd_raw")
		local sm
		sm=$(get_smart_cached "$id" || true)
		if [[ -z "$sm" ]]; then
			smart_st="TIMEOUT"; temp="N/A"; health="N/A"
		else
			smart_st=$(smart_status_from_output "$sm")
			temp=$(smart_temperature_from_output "$sm")
			health=$(smart_health_from_output "$sm")
		fi
		link=$(get_link_speed "$sd_raw")
		printf "%-12s %-72s %-12s %-20s %-8s %-4s %-18s %-8s %-6s %-12s %-8s %-4s %-14s\n" \
			"$(_dc_trunc "$display" 12)" \
			"$(_dc_trunc "$aliases" 72)" \
			"$(_dc_trunc "$vendor" 12)" \
			"$(_dc_trunc "$model" 20)" \
			"$(_dc_trunc "$firmware" 8)" \
			"$in_pool" \
			"$(_dc_trunc "$enc_slot" 18)" \
			"$(_dc_trunc "$smart_st" 8)" \
			"$(_dc_trunc "$temp" 6)" \
			"$(_dc_trunc "$link" 12)" \
			"$(_dc_trunc "$health" 8)" \
			"$(_dc_trunc "$led" 4)" \
			"$(_dc_trunc "$path" 14)"
	else
		printf "%-12s %-72s %-12s %-20s %-8s %-4s %-4s\n" \
			"$(_dc_trunc "$display" 12)" \
			"$(_dc_trunc "$aliases" 72)" \
			"$(_dc_trunc "$vendor" 12)" \
			"$(_dc_trunc "$model" 20)" \
			"$(_dc_trunc "$firmware" 8)" \
			"$in_pool" \
			"$(_dc_trunc "$led" 4)"
	fi
}

cmd_disk_list() {
	local verbose=0 device="" arg
	for arg in "$@"; do
		case "$arg" in
			-v|--verbose) verbose=1 ;;
			*) device="$arg" ;;
		esac
	done

	ensure_maps
	local pool_status lsscsi_out id count=0
	pool_status=$(zpool status "$POOL" 2>/dev/null || true)
	lsscsi_out=$(lsscsi -g 2>/dev/null || true)

	section "Disk inventory"
	info "Pool check" "$POOL"
	_print_list_header "$verbose"

	if [[ -n "$device" ]]; then
		id=$(resolve_to_wwn "$device") || displayError "Cannot resolve device: $device"
		_print_one_disk "$id" "$verbose" "$pool_status" "$lsscsi_out" \
			|| displayError "Disk not found in inventory"
		count=1
	else
		while IFS= read -r id; do
			[[ -z "$id" ]] && continue
			_print_one_disk "$id" "$verbose" "$pool_status" "$lsscsi_out" || true
			count=$((count + 1))
		done < <(ordered_ids)
	fi
	log ""
	ok "Listed $count disk(s)"
}

# -----------------------------------------------------------------------------
# disk health
# -----------------------------------------------------------------------------
cmd_disk_health() {
	ensure_maps
	local device="" verbose=0 arg
	local id display access kind sm st hl

	for arg in "$@"; do
		case "$arg" in
			-v|--verbose) verbose=1 ;;
			-*)
				usage_error "Unknown option: $arg" "disk health [-v|--verbose] [device]"
				;;
			*)
				device="$arg"
				;;
		esac
	done

	printf "%-12s %-28s %-10s %-10s %-10s\n" \
		"Device" "Access" "SMART" "Health" "Path"
	printf "%-12s %-28s %-10s %-10s %-10s\n" \
		"------------" "----------------------------" "----------" "----------" "----------"

	_health_verbose_details() {
		local sm="$1"
		local line overall

		if [[ -z "$sm" ]]; then
			printf "             %s\n" \
				"${_CLR_DIM}(no smartctl output: timeout, permission, or unsupported)${_CLR_RESET}"
			return
		fi

		overall=$(grep -iE 'SMART overall-health|SMART Health Status|SMART available' <<<"$sm" | head -5 || true)
		if [[ -n "$overall" ]]; then
			while IFS= read -r line; do
				[[ -z "$line" ]] && continue
				printf "             %s\n" "${_CLR_DIM}${line}${_CLR_RESET}"
			done <<<"$overall"
		else
			printf "             %s\n" \
				"${_CLR_DIM}(no overall-health / Health Status line in smartctl output)${_CLR_RESET}"
		fi

		line=$(grep -iE \
			'Elements in grown defect|Reallocated_Sector|Current Drive Temperature|Media Wearout|Percentage Used|Temperature_Celsius|Non-medium error' \
			<<<"$sm" | head -8 || true)
		if [[ -n "$line" ]]; then
			while IFS= read -r line; do
				[[ -z "$line" ]] && continue
				printf "             %s\n" "${_CLR_DIM}${line}${_CLR_RESET}"
			done <<<"$line"
		fi
	}

	_one_health() {
		id="$1"
		display="$(_dc_display_name "$id")"
		access=$(resolve_to_access_dev "$id" 2>/dev/null || echo "?")
		kind="${WWN_TO_PATH_KIND[$id]:-?}"
		sm=$(get_smart_cached "$id" || true)
		if [[ -z "$sm" ]]; then
			st="TIMEOUT"
			hl="N/A"
		else
			st=$(smart_status_from_output "$sm")
			hl=$(smart_health_from_output "$sm")
		fi
		printf "%-12s %-28s %-10s %-10s %-10s\n" \
			"$(_dc_trunc "$display" 12)" \
			"$(_dc_trunc "$(basename "$access")" 28)" \
			"$(_dc_trunc "$st" 10)" \
			"$(_dc_trunc "$hl" 10)" \
			"$(_dc_trunc "$kind" 10)"
		if [[ "$verbose" -eq 1 ]]; then
			_health_verbose_details "$sm"
		fi
	}

	if [[ -n "$device" ]]; then
		id=$(resolve_to_wwn "$device") || displayError "Cannot resolve: $device"
		_one_health "$id"
	else
		while IFS= read -r id; do
			[[ -z "$id" ]] && continue
			_one_health "$id"
		done < <(ordered_ids)
	fi
}

# -----------------------------------------------------------------------------
# disk info
# -----------------------------------------------------------------------------
cmd_disk_info() {
	local device="${1:-}"
	[[ -z "$device" ]] && usage_error "disk info requires a device" "disk info <device>"

	ensure_maps

	local id sd_raw display access kind sm aliases pool_status in_pool="NO"
	id=$(resolve_to_wwn "$device") || displayError "Cannot resolve: $device"
	sd_raw="${WWN_TO_SD[$id]:-?}"
	display="$(_dc_display_name "$id")"
	access=$(resolve_to_access_dev "$id") || displayError "No usable access path for $device"
	kind="${WWN_TO_PATH_KIND[$id]:-unknown}"
	aliases="$(_dc_sort_aliases "${WWN_ALIASES[$id]:-none}")"
	sm=$(get_smart_cached "$id" || true)

	section "Disk info"
	info "Input"      "$device"
	info "Device"     "$display"
	info "Underlying" "$sd_raw"
	info "Identity"   "$id"
	info "Access"     "$access ($kind)"
	info "Aliases"    "$aliases"
	info "Enclosure"  "$(get_enclosure_slot "$sd_raw")"
	info "Transport"  "$(get_transport_type "$sd_raw")"
	info "LED"        "$(led_status "$sd_raw")"

	pool_status=$(zpool status "$POOL" 2>/dev/null || true)
	is_in_pool_status "$id" "$pool_status" && in_pool="YES"
	info "In pool ($POOL)" "$in_pool"

	if [[ -z "$sm" ]]; then
		warn "smartctl returned no data (timeout or unsupported)"
		return 0
	fi

	log ""
	printf "  ${_CLR_BOLD}SMART summary${_CLR_RESET}\n"
	info "Overall"      "$(smart_status_from_output "$sm")"
	info "Health"       "$(smart_health_from_output "$sm")"
	info "Temperature"  "$(smart_temperature_from_output "$sm")"
	info "Link"         "$(get_link_speed "$sd_raw")"

	local model serial capacity hours cycles
	model=$(grep -iE '^(Device Model|Product):' <<<"$sm" | head -1 | sed 's/^[^:]*:[[:space:]]*//')
	serial=$(grep -iE '^(Serial Number|Serial number):' <<<"$sm" | head -1 | sed 's/^[^:]*:[[:space:]]*//')
	capacity=$(grep -iE '^User Capacity:' <<<"$sm" | head -1 | sed 's/^[^:]*:[[:space:]]*//')
	hours=$(awk '/^9 / {print $10}' <<<"$sm" | head -1)
	[[ -z "$hours" ]] && hours=$(grep -i 'Power_On_Hours' <<<"$sm" | awk '{print $10}' | head -1)
	cycles=$(awk '/^12 / {print $10}' <<<"$sm" | head -1)

	[[ -n "$model" ]] && info "Model" "$model"
	[[ -n "$serial" ]] && info "Serial" "$serial"
	[[ -n "$capacity" ]] && info "Capacity" "$capacity"
	[[ -n "$hours" ]] && info "Power-on hours" "$hours"
	[[ -n "$cycles" ]] && info "Power cycles" "$cycles"

	local realloc pending offline defects
	realloc=$(awk '/^  5 / {print $10}' <<<"$sm" | head -1)
	pending=$(awk '/^197 / {print $10}' <<<"$sm" | head -1)
	offline=$(awk '/^198 / {print $10}' <<<"$sm" | head -1)
	defects=$(grep -i 'Elements in grown defect list' <<<"$sm" | awk '{print $NF}')
	[[ -n "$realloc" ]] && info "Reallocated sectors" "$realloc"
	[[ -n "$pending" ]] && info "Pending sectors" "$pending"
	[[ -n "$offline" ]] && info "Offline uncorrectable" "$offline"
	[[ -n "$defects" ]] && info "Grown defects" "$defects"
}

# -----------------------------------------------------------------------------
# disk format
# -----------------------------------------------------------------------------
cmd_disk_format() {
	local device="" progress=0 arg access id sd_raw display reply

	for arg in "$@"; do
		case "$arg" in
			--progress) progress=1 ;;
			-*)
				usage_error "Unknown option: $arg" "disk format <device> [--progress]"
				;;
			*)
				if [[ -z "$device" ]]; then
					device="$arg"
				else
					usage_error "Unexpected argument: $arg" "disk format <device> [--progress]"
				fi
				;;
		esac
	done

	[[ -n "$device" ]] || usage_error "disk format requires a device" "disk format <device> [--progress]"
	command -v sg_format >/dev/null 2>&1 \
		|| displayError "sg_format not found (install sys-apps/sg3_utils)"

	ensure_maps
	id=$(resolve_to_wwn "$device") || displayError "Cannot resolve device: $device"
	sd_raw="${WWN_TO_SD[$id]:-?}"
	display="$(_dc_display_name "$id")"
	access=$(resolve_to_access_dev "$id") || displayError "No usable access path for $device"

	section "SCSI FORMAT UNIT"
	info "Input" "$device"
	info "Device" "$display"
	info "Access" "$access"
	info "Identity" "$id"
	warn "This will DESTROY all data on the device."

	read -r -p "  Type YES to confirm format: " reply
	[[ "$reply" == "YES" ]] || displayError "Aborted (confirmation not YES)"

	local -a cmd=(sg_format --format --ffmt=0)
	[[ "$progress" -eq 1 ]] && cmd+=(--progress)
	cmd+=("$access")

	info "Running" "${cmd[*]}"
	if as_root "${cmd[@]}"; then
		ok "Format completed on $access"
	else
		displayError "sg_format failed on $access (device may not support SCSI FORMAT UNIT)"
	fi
}

# -----------------------------------------------------------------------------
# disk zfs / btrfs
# -----------------------------------------------------------------------------
cmd_disk_zfs() {
	local sub="${1:-}"
	shift || true
	local pool="$POOL"

	case "$sub" in
		status)
			local verbose=0 arg
			for arg in "$@"; do
				case "$arg" in
					-v|--verbose) verbose=1 ;;
					*) pool="$arg" ;;
				esac
			done
			_zpool_exists "$pool" || displayError "ZFS pool does not exist: $pool"
			section "ZFS status ($pool)"
			if [[ "$verbose" -eq 1 ]]; then
				zpool status -v "$pool"
			else
				zpool status "$pool"
			fi
			;;
		list)
			section "ZFS pools"
			zpool list 2>/dev/null || warn "No ZFS pools found"
			log ""
			section "ZFS datasets"
			zfs list 2>/dev/null || warn "No ZFS datasets found"
			;;
		iostat)
			local interval="${1:-1}"
			_zpool_exists "$POOL" || displayError "ZFS pool does not exist: $POOL"
			[[ "$interval" =~ ^[0-9]+$ ]] || displayError "interval must be a positive integer"
			section "ZFS iostat ($POOL)"
			zpool iostat -v "$POOL" "$interval"
			;;
		events)
			if ! _zpool_exists "$POOL"; then
				displayError "ZFS pool does not exist: $POOL"
			fi
			section "ZFS events ($POOL)"
			# Requires elevated privileges on most systems
			as_root zpool events "$POOL" 2>/dev/null || as_root zpool events
			;;
		scrub)
			local action="${1:-start}"
			_zpool_exists "$POOL" || displayError "ZFS pool does not exist: $POOL"
			case "$action" in
				""|start)
					section "ZFS scrub start ($POOL)"
					as_root zpool scrub "$POOL"
					ok "Scrub started on $POOL"
					;;
				stop)
					section "ZFS scrub stop ($POOL)"
					as_root zpool scrub -s "$POOL"
					ok "Scrub stop requested on $POOL"
					;;
				*)
					usage_error "Unknown scrub action: $action" "disk zfs scrub [stop]"
					;;
			esac
			;;
		*)
			usage_error "Missing or unknown disk zfs subcommand" \
				"disk zfs status|list|iostat|events|scrub [stop]"
			;;
	esac
}

cmd_disk_btrfs() {
	local sub="${1:-}"
	shift || true
	local path="${1:-/}"

	case "$sub" in
		status)
			path="${1:-/}"
			_require_btrfs_path "$path"
			section "Btrfs status ($path)"
			as_root btrfs filesystem show "$path" 2>/dev/null || btrfs filesystem show
			log ""
			as_root btrfs filesystem usage "$path"
			;;
		list)
			section "Btrfs filesystems"
			if ! btrfs filesystem show 2>/dev/null | grep -q .; then
				warn "No btrfs filesystems detected"
			else
				btrfs filesystem show 2>/dev/null || true
			fi
			log ""
			section "Subvolumes"
			local mnt count=0
			while IFS= read -r mnt; do
				[[ -z "$mnt" ]] && continue
				_is_btrfs_path "$mnt" || continue
				info "Mount" "$mnt"
				btrfs subvolume list "$mnt" 2>/dev/null || warn "subvolume list failed for $mnt"
				count=$((count + 1))
			done < <(findmnt -n -t btrfs -o TARGET 2>/dev/null || true)
			if [[ "$count" -eq 0 ]]; then
				if _is_btrfs_path "/"; then
					btrfs subvolume list / 2>/dev/null || warn "subvolume list failed"
				else
					warn "No btrfs mounts to list subvolumes from"
				fi
			fi
			;;
		df)
			path="${1:-/}"
			_require_btrfs_path "$path"
			section "Btrfs df ($path)"
			as_root btrfs filesystem df "$path"
			;;
		device)
			path="${1:-/}"
			_require_btrfs_path "$path"
			section "Btrfs device ($path)"
			as_root btrfs filesystem usage "$path"
			log ""
			as_root btrfs device usage "$path"
			;;
		scrub)
			local action="${1:-status}"
			path="${2:-/}"
			_require_btrfs_path "$path"
			case "$action" in
				start)
					section "Btrfs scrub start ($path)"
					as_root btrfs scrub start "$path"
					ok "Scrub started"
					;;
				status)
					section "Btrfs scrub status ($path)"
					btrfs scrub status "$path"
					;;
				cancel)
					section "Btrfs scrub cancel ($path)"
					as_root btrfs scrub cancel "$path"
					ok "Scrub cancel requested"
					;;
				*)
					usage_error "Unknown btrfs scrub action: $action" \
						"disk btrfs scrub start|status|cancel [path]"
					;;
			esac
			;;
		*)
			usage_error "Missing or unknown disk btrfs subcommand" \
				"disk btrfs status|list|df|device|scrub …"
			;;
	esac
}

cmd_disk() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
		list)   cmd_disk_list "$@" ;;
		health) cmd_disk_health "$@" ;;
		info)   cmd_disk_info "$@" ;;
		format) cmd_disk_format "$@" ;;
		zfs)    cmd_disk_zfs "$@" ;;
		btrfs)  cmd_disk_btrfs "$@" ;;
		*)
			usage_error "Missing or unknown disk subcommand" \
				"disk list|health|info|format|zfs|btrfs …"
			;;
	esac
}

# -----------------------------------------------------------------------------
# led
# -----------------------------------------------------------------------------
cmd_led() {
	local action="${1:-}"
	shift || true
	local device="${1:-}"
	local seconds="${2:-30}"

	ensure_maps

	case "$action" in
		on|off)
			local val
			[[ "$action" == "on" ]] && val=1 || val=0
			if [[ -z "$device" ]]; then
				section "LED $action (all)"
				local -A seen=()
				local enc_dir slot_dir slot_sas slot_wwn n=0
				for enc_dir in /sys/class/enclosure/*/; do
					[[ -d "$enc_dir" ]] || continue
					for slot_dir in "$enc_dir"*/; do
						[[ -f "$slot_dir/locate" && -f "$slot_dir/device/sas_address" ]] || continue
						slot_sas=$(<"$slot_dir/device/sas_address")
						slot_wwn=$(resolve_sas_to_wwn "$slot_sas" 2>/dev/null) || continue
						[[ -z "${seen[$slot_wwn]+x}" ]] || continue
						seen[$slot_wwn]=1
						_led_write "$slot_dir" "$val" 2>/dev/null || true
						n=$((n + 1))
					done
				done
				ok "LED $action applied on $n disk(s)"
			else
				section "LED $action"
				_led_set_user "$device" "$val" || displayError "Failed to set LED for $device"
				info "Device" "$device"
				info "LED" "$([[ $val -eq 1 ]] && echo ON || echo OFF)"
				ok "Done"
			fi
			;;
		show)
			section "LED status"
			local -a rows=()
			local -A seen=()
			local enc_dir slot_dir slot_sas slot_wwn led_state
			local sd_name scsi_id wwn_id sortk display
			local RS=$'\x1e'

			printf "%-12s %-36s %-28s %-4s\n" "Device" "SCSI" "WWN" "LED"
			printf "%-12s %-36s %-28s %-4s\n" \
				"------------" "------------------------------------" \
				"----------------------------" "----"

			if [[ -n "$device" ]]; then
				local id
				id=$(extract_wwn "$device") || exit 1
				if ! [[ "$id" =~ ^[0-9a-fA-F]{16,}$ ]]; then
					displayError "Device has no SES enclosure slot: $device"
				fi
				find_slot_by_wwn_prefix "${id%?}" || displayError "No enclosure slot for $device"
				led_state=$(led_status "$SLOT_DIR")
				read -r sd_name scsi_id wwn_id <<<"$(resolve_sas_to_ids "$SLOT_SAS")"
				display="$(_dc_display_name "$id")"
				printf "%-12s %-36s %-28s %-4s\n" \
					"$(_dc_trunc "$display" 12)" \
					"$(_dc_trunc "$scsi_id" 36)" \
					"$(_dc_trunc "$wwn_id" 28)" \
					"$(_dc_trunc "$led_state" 4)"
			else
				for enc_dir in /sys/class/enclosure/*/; do
					[[ -d "$enc_dir" ]] || continue
					for slot_dir in "$enc_dir"*/; do
						[[ -f "$slot_dir/locate" && -f "$slot_dir/device/sas_address" ]] || continue
						slot_sas=$(<"$slot_dir/device/sas_address")
						slot_wwn=$(resolve_sas_to_wwn "$slot_sas" 2>/dev/null) || continue
						[[ -z "${seen[$slot_wwn]+x}" ]] || continue
						seen[$slot_wwn]=1
						led_state=$(led_status "$slot_dir")
						read -r sd_name scsi_id wwn_id <<<"$(resolve_sas_to_ids "$slot_sas")"
						display="$(_dc_display_name "$slot_wwn")"
						# Sort key must NOT use the same delimiter as fields
						sortk="$(enclosure_sort_key "$sd_name" | tr '|' ',')"
						rows+=("${sortk}${RS}${display}${RS}${scsi_id}${RS}${wwn_id}${RS}${led_state}")
					done
				done
				local row
				if [[ ${#rows[@]} -gt 0 ]]; then
					while IFS= read -r row; do
						[[ -z "$row" ]] && continue
						IFS="$RS" read -r _ display scsi_id wwn_id led_state <<<"$row"
						printf "%-12s %-36s %-28s %-4s\n" \
							"$(_dc_trunc "$display" 12)" \
							"$(_dc_trunc "$scsi_id" 36)" \
							"$(_dc_trunc "$wwn_id" 28)" \
							"$(_dc_trunc "$led_state" 4)"
					done < <(printf '%s\n' "${rows[@]}" | LC_ALL=C sort)
				fi
			fi
			;;
		blink)
			[[ -z "$device" ]] && usage_error "led blink requires a device" "led blink <device> [seconds]"
			[[ "$seconds" =~ ^[0-9]+$ ]] || displayError "seconds must be a positive integer"
			section "LED blink"
			info "Device" "$device"
			info "Duration" "${seconds}s"

			# Ensure LED is turned OFF if the user hits Ctrl+C / TERM during sleep
			_blink_cleanup() {
				_led_set_user "$device" 0 2>/dev/null || true
				echo
				warn "Interrupted — LED forced OFF for $device"
			}
			trap '_blink_cleanup; trap - INT TERM EXIT; exit 130' INT TERM
			trap '_led_set_user "$device" 0 2>/dev/null || true; trap - INT TERM EXIT' EXIT

			_led_set_user "$device" 1 || displayError "Failed to turn LED on for $device"
			ok "LED ON"
			sleep "$seconds"
			_led_set_user "$device" 0 || displayError "Failed to turn LED off for $device"
			ok "LED OFF"

			trap - INT TERM EXIT
			;;
		*)
			usage_error "Missing or unknown led action" "led on|off|show|blink …"
			;;
	esac
}

# -----------------------------------------------------------------------------
main() {
	if [[ $# -lt 1 ]]; then
		display_help
		exit 0
	fi

	local cmd="$1"
	shift

	case "$cmd" in
		help|-h|--help) display_help ;;
		disk)
			display_header
			cmd_disk "$@"
			;;
		led)
			display_header
			cmd_led "$@"
			;;
		*)
			usage_error "Unknown command: $cmd" "help | disk | led"
			;;
	esac
}

main "$@"