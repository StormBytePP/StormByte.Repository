#!/usr/bin/env bash
# =============================================================================
# StormByte-DataCenter — disk inventory, SES LEDs, ZFS & Btrfs helpers
# =============================================================================
set -euo pipefail

readonly STORMBYTE_DATACENTER_VERSION="1.0.0"
readonly REQUIRE_STORMBYTE_FUNCTIONS="1.0.0"
readonly REQUIRE_STORMBYTE_FUNCTIONS_DATACENTER="1.0.0"

: "${POOL:=StormDataCenter}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_NAME
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

# -----------------------------------------------------------------------------
# Libraries: script dir first, then /lib/StormByte
# -----------------------------------------------------------------------------
if [[ -f "${SCRIPT_DIR}/functions.sh" ]]; then
	# shellcheck source=/dev/null
	source "${SCRIPT_DIR}/functions.sh"
elif [[ -f "/lib/StormByte/functions.sh" ]]; then
	# shellcheck source=/dev/null
	source "/lib/StormByte/functions.sh"
else
	printf 'ERROR: StormByte functions.sh not found\n' >&2
	exit 1
fi

require_version "${STORMBYTE_FUNCTIONS_VERSION}" "${REQUIRE_STORMBYTE_FUNCTIONS}" "StormByte functions"

if [[ -f "${SCRIPT_DIR}/datacenter.sh" ]]; then
	# shellcheck source=/dev/null
	source "${SCRIPT_DIR}/datacenter.sh"
elif [[ -f "/lib/StormByte/datacenter.sh" ]]; then
	# shellcheck source=/dev/null
	source "/lib/StormByte/datacenter.sh"
else
	displayError "StormByte datacenter.sh not found"
fi

require_version "${STORMBYTE_FUNCTIONS_DATACENTER_VERSION}" "${REQUIRE_STORMBYTE_FUNCTIONS_DATACENTER}" "StormByte datacenter helpers"

# -----------------------------------------------------------------------------
# Privileges: use sudo when not root (do not force the user to re-run the script)
# -----------------------------------------------------------------------------
as_root() {
	if [[ $EUID -eq 0 ]]; then
		"$@"
	else
		sudo "$@"
	fi
}

# -----------------------------------------------------------------------------
# UI
# -----------------------------------------------------------------------------

display_header() {
	local line1="StormByte-DataCenter  v${STORMBYTE_DATACENTER_VERSION}"
	local line2="Disks · SES LEDs · ZFS · Btrfs"
	local inner_w border_mid

	inner_w=${#line1}
	(( ${#line2} > inner_w )) && inner_w=${#line2}
	inner_w=$((inner_w + 4))
	(( inner_w < 50 )) && inner_w=50
	border_mid="$(printf '═%.0s' $(seq 1 "$inner_w"))"

	_sb_center() {
		local text="$1" tw=${#text} total=$inner_w
		local left=$(( (total - tw) / 2 ))
		local right=$(( total - tw - left ))
		printf '%*s%s%*s' "$left" '' "$text" "$right" ''
	}

	printf '\n'
	printf '  %s╔%s╗%s\n' "${_CLR_BOLD_BLUE}" "$border_mid" "${_CLR_RESET}"
	printf '  %s║%s%s%s║%s\n' \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}${_CLR_BOLD}" \
		"$(_sb_center "$line1")" \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	printf '  %s║%s%s%s║%s\n' \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}" \
		"$(_sb_center "$line2")" \
		"${_CLR_BOLD_BLUE}" "${_CLR_RESET}"
	printf '  %s╚%s╝%s\n' "${_CLR_BOLD_BLUE}" "$border_mid" "${_CLR_RESET}"
	printf '\n'
}

usage_error() {
	err "$1"
	echo
	echo "Accepted: $2"
	echo "Use '${SCRIPT_NAME} help' for full help."
	exit 1
}

