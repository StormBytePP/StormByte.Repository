diff --git a/cmake/FindStormByte.cmake b/cmake/FindStormByte.cmake
index f767584..4168eda 100644
--- a/cmake/FindStormByte.cmake
+++ b/cmake/FindStormByte.cmake
@@ -4,7 +4,7 @@
 #
 # Usage:
 #   find_package(StormByte REQUIRED)
-#   find_package(StormByte REQUIRED COMPONENTS Logger)
+#   find_package(StormByte REQUIRED Base Logger System)
 #   find_package(StormByte COMPONENTS Crypto)   # pulls Buffer, then Logger and System
 #
 # Provides:
@@ -123,7 +123,14 @@ endif()
 # ----------------------------------------------------------------------
 
 set(_requested_components)
+set(_wants_base FALSE)
 foreach(_component IN LISTS StormByte_FIND_COMPONENTS)
+	# Base is the core library (libStormByte), not a module. Buffer, Crypto,
+	# Database, Multimedia and Network request it by that name.
+	if(_component STREQUAL "Base")
+		set(_wants_base TRUE)
+		continue()
+	endif()
 	if(_component IN_LIST _STORMBYTE_AVAILABLE_COMPONENTS)
 		list(APPEND _requested_components ${_component})
 	else()
@@ -154,6 +161,20 @@ if(STORMBYTE_LIBRARY)
 	endif()
 endif()
 
+if(_wants_base)
+	if(TARGET StormByte)
+		set(StormByte_Base_FOUND TRUE)
+		if(NOT TARGET StormByte-Base)
+			add_library(StormByte-Base ALIAS StormByte)
+		endif()
+		if(NOT TARGET StormByte::Base)
+			add_library(StormByte::Base ALIAS StormByte)
+		endif()
+	else()
+		set(StormByte_Base_FOUND FALSE)
+	endif()
+endif()
+
